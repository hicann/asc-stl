__global__ void example_barrier(void* storage, unsigned int* output)
{
    // 以单线程启动；Host为barrier提供对齐的GM存储。
    using Barrier = asc::barrier<asc::memory_scope::device>;
    auto* barrier = new (storage) Barrier(1);
    asc::barrier_arrival_token token = barrier->arrive();
    barrier->wait(static_cast<asc::barrier_arrival_token&&>(token));
    output[0] = 1;
}

void launch_example(unsigned int* output, unsigned int* storage, aclrtStream stream)
{
    example_atomic<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 0);
    example_atomic_atomic<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 1);
    example_atomic_compare_exchange_strong<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 2);
    example_atomic_exchange<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 3);
    example_atomic_fetch_add<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 4);
    example_atomic_fetch_and<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 5);
    example_atomic_fetch_max<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 6);
    example_atomic_fetch_min<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 7);
    example_atomic_fetch_or<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 8);
    example_atomic_fetch_sub<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 9);
    example_atomic_fetch_xor<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 10);
    example_atomic_load<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 11);
    example_atomic_ref<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 12);
    example_atomic_ref_atomic_ref<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 13);
    example_atomic_ref_compare_exchange_strong<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 14);
    example_atomic_ref_exchange<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 15);
    example_atomic_ref_fetch_add<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 16);
    example_atomic_ref_fetch_and<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 17);
    example_atomic_ref_fetch_max<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 18);
    example_atomic_ref_fetch_min<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 19);
    example_atomic_ref_fetch_or<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 20);
    example_atomic_ref_fetch_sub<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 21);
    example_atomic_ref_fetch_xor<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 22);
    example_atomic_ref_load<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 23);
    example_atomic_ref_store<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 24);
    example_atomic_store<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 25);
    example_atomic_thread_fence<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 26);
    example_memory_scope<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 27);
    example_memory_scope_block<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 28);
    example_memory_scope_device<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 29);
    example_relaxed_atomic_ref<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 30);
    example_relaxed_atomic_ref_compare_exchange_strong<<<1, 1, 0, stream>>>(
        reinterpret_cast<int*>(storage), output + 31);
    example_relaxed_atomic_ref_exchange<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 32);
    example_relaxed_atomic_ref_fetch_add<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 33);
    example_relaxed_atomic_ref_fetch_sub<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 34);
    example_relaxed_atomic_ref_load<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 35);
    example_relaxed_atomic_ref_relaxed_atomic_ref<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 36);
    example_relaxed_atomic_ref_store<<<1, 1, 0, stream>>>(reinterpret_cast<int*>(storage), output + 37);
    example_barrier<<<1, 1, 0, stream>>>(storage, output + 38);
}
