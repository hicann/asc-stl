    asc::atomic_ref<int, asc::memory_scope::block> cell(*storage);
    cell.store(7, asc::std::memory_order_relaxed);

    output[0] = (cell.load(asc::std::memory_order_relaxed) == 7) ? 1U : 0U;
}

