    output[0] = (cell.load() == 7) ? 1U : 0U;
}

__global__ void example_relaxed_atomic_ref_compare_exchange_strong(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    *storage = 7;
    asc::relaxed_atomic_ref<int> cell(*storage);
    cell.store(7);
    int expected = 7;
    const bool exchanged = cell.compare_exchange_strong(expected, 11);
    output[0] = (exchanged && expected == 7 && cell.load() == 11) ? 1U : 0U;
}

__global__ void example_relaxed_atomic_ref_exchange(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    *storage = 7;
    asc::relaxed_atomic_ref<int> cell(*storage);
    cell.store(7);
    const int previous = cell.exchange(11);
    output[0] = (previous == 7 && cell.load() == 11) ? 1U : 0U;
}

