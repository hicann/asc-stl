#include "example.h"
#include <asc/atomic>
#include <asc/barrier>
#include <asc/std/new>

__global__ void example_atomic(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    auto* object = new (storage) asc::atomic<int>(7);
    auto& cell = *object;
    cell.store(7, asc::std::memory_order_relaxed);

    output[0] = (cell.load(asc::std::memory_order_relaxed) == 7) ? 1U : 0U;
}

__global__ void example_atomic_atomic(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    auto* object = new (storage) asc::atomic<int>(7);
    auto& cell = *object;
    cell.store(7, asc::std::memory_order_relaxed);

    output[0] = (cell.load(asc::std::memory_order_relaxed) == 7) ? 1U : 0U;
}

__global__ void example_atomic_compare_exchange_strong(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    auto* object = new (storage) asc::atomic<int>(7);
    auto& cell = *object;
    cell.store(7, asc::std::memory_order_relaxed);
    int expected = 7;
    const bool exchanged =
        cell.compare_exchange_strong(expected, 11, asc::std::memory_order_relaxed, asc::std::memory_order_relaxed);
    output[0] = (exchanged && expected == 7 && cell.load(asc::std::memory_order_relaxed) == 11) ? 1U : 0U;
}

__global__ void example_atomic_exchange(int* storage, unsigned int* output)
{
    // 仅启动1个block、1个线程；storage和output均为Host分配的GM。
    auto* object = new (storage) asc::atomic<int>(7);
    auto& cell = *object;
    cell.store(7, asc::std::memory_order_relaxed);
    const int previous = cell.exchange(11, asc::std::memory_order_relaxed);
    output[0] = (previous == 7 && cell.load(asc::std::memory_order_relaxed) == 11) ? 1U : 0U;
}

