#include <asc/algorithm>
#include "parallel_example.h"

namespace parallel_case_swap_ranges {

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {5, 6, 7, 8};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* other = context.other;
    const auto status = asc::parallel::swap_ranges(policy, input, input + 4, other);
    if (!context.complete(status))
        return false;
    int actual[4]{};
    int second_actual[4]{};
    if (!context.read(context.input, actual) || !context.read(context.other, second_actual))
        return false;
    for (int index = 0; index < 4; ++index) {
        if (actual[index] != index + 5 || second_actual[index] != index + 1)
            return false;
    }
    return true;
}
}  // namespace parallel_case_swap_ranges

bool run_parallel_swap_ranges(parallel_example_context& context)
{
    return parallel_case_swap_ranges::example(context);
}

namespace parallel_case_transform {
struct unary_operation {
    __aicore__ int operator()(int value) const
    {
        return value * 2;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status = asc::parallel::transform(policy, input, input + 4, output, unary_operation{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {2, 4, 6, 8};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_transform

bool run_parallel_transform(parallel_example_context& context)
{
    return parallel_case_transform::example(context);
}

namespace parallel_case_transform_exclusive_scan {
struct binary_operation {
    __aicore__ int operator()(int left, int right) const
    {
        return left + right;
    }
};
struct unary_operation {
    __aicore__ int operator()(int value) const
    {
        return value * 2;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status = asc::parallel::transform_exclusive_scan(
        policy, input, input + 4, output, 0, binary_operation{}, unary_operation{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {0, 2, 6, 12};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_transform_exclusive_scan

bool run_parallel_transform_exclusive_scan(parallel_example_context& context)
{
    return parallel_case_transform_exclusive_scan::example(context);
}

