namespace parallel_case_transform_reduce {
struct binary_operation {
    __aicore__ int operator()(int left, int right) const
    {
        return left + right;
    }
};
struct unary_operation {
    __aicore__ int operator()(int value) const
    {
        return value * 2;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status =
        asc::parallel::transform_reduce(policy, input, input + 4, 0, output, binary_operation{}, unary_operation{});
    if (!context.complete(status))
        return false;
    int actual[1]{};
    const int expected[] = {20};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 1; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_transform_reduce

bool run_parallel_transform_reduce(parallel_example_context& context)
{
    return parallel_case_transform_reduce::example(context);
}

namespace parallel_case_unique {
struct binary_predicate {
    __aicore__ bool operator()(int left, int right) const
    {
        return left == right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 2, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::unique(policy, input, input + 4, size_sink, binary_predicate{});
    if (!context.complete(status))
        return false;
    int actual[3]{};
    const int expected[] = {1, 2, 4};
    if (!context.read(context.input, actual))
        return false;
    for (unsigned index = 0; index < 3; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 3u)
        return false;
    return true;
}
}  // namespace parallel_case_unique

bool run_parallel_unique(parallel_example_context& context)
{
    return parallel_case_unique::example(context);
}

