#include "parallel_example.h"

const parallel_example_case* parallel_example_cases(asc::std::size_t& count)
{
    static const parallel_example_case entries[] = {
        {"adjacent_difference", run_parallel_adjacent_difference},
        {"adjacent_find", run_parallel_adjacent_find},
        {"all_of", run_parallel_all_of},
        {"any_of", run_parallel_any_of},
        {"copy", run_parallel_copy},
        {"copy_if", run_parallel_copy_if},
        {"copy_n", run_parallel_copy_n},
        {"count", run_parallel_count},
        {"count_if", run_parallel_count_if},
        {"equal", run_parallel_equal},
        {"exclusive_scan", run_parallel_exclusive_scan},
        {"fill", run_parallel_fill},
        {"fill_n", run_parallel_fill_n},
        {"find", run_parallel_find},
        {"find_if", run_parallel_find_if},
        {"find_if_not", run_parallel_find_if_not},
        {"for_each", run_parallel_for_each},
        {"for_each_n", run_parallel_for_each_n},
        {"generate", run_parallel_generate},
        {"generate_n", run_parallel_generate_n},
        {"inclusive_scan", run_parallel_inclusive_scan},
        {"is_heap", run_parallel_is_heap},
        {"is_heap_until", run_parallel_is_heap_until},
        {"is_partitioned", run_parallel_is_partitioned},
        {"is_sorted", run_parallel_is_sorted},
        {"is_sorted_until", run_parallel_is_sorted_until},
        {"max_element", run_parallel_max_element},
        {"merge", run_parallel_merge},
        {"min_element", run_parallel_min_element},
        {"mismatch", run_parallel_mismatch},
        {"none_of", run_parallel_none_of},
        {"partition", run_parallel_partition},
        {"partition_copy", run_parallel_partition_copy},
        {"reduce", run_parallel_reduce},
        {"remove", run_parallel_remove},
        {"remove_copy", run_parallel_remove_copy},
        {"remove_copy_if", run_parallel_remove_copy_if},
        {"remove_if", run_parallel_remove_if},
        {"replace", run_parallel_replace},
        {"replace_copy", run_parallel_replace_copy},
        {"replace_copy_if", run_parallel_replace_copy_if},
        {"replace_if", run_parallel_replace_if},
        {"reverse", run_parallel_reverse},
        {"reverse_copy", run_parallel_reverse_copy},
        {"rotate", run_parallel_rotate},
        {"rotate_copy", run_parallel_rotate_copy},
        {"shift_left", run_parallel_shift_left},
        {"shift_right", run_parallel_shift_right},
        {"sort", run_parallel_sort},
        {"stable_partition", run_parallel_stable_partition},
        {"swap_ranges", run_parallel_swap_ranges},
        {"transform", run_parallel_transform},
        {"transform_exclusive_scan", run_parallel_transform_exclusive_scan},
        {"transform_inclusive_scan", run_parallel_transform_inclusive_scan},
        {"transform_reduce", run_parallel_transform_reduce},
        {"unique", run_parallel_unique},
        {"unique_copy", run_parallel_unique_copy},
    };
    count = sizeof(entries) / sizeof(entries[0]);
    return entries;
}
