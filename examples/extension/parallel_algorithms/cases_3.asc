#include <asc/algorithm>
#include "parallel_example.h"

namespace parallel_case_none_of {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* flag_sink = context.flag_sink;
    const auto status = asc::parallel::none_of(policy, input, input + 4, flag_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::uint32_t observed[1]{};
    if (!context.read(context.flag_sink, observed))
        return false;
    if (observed[0] != 0u)
        return false;
    return true;
}
}  // namespace parallel_case_none_of

bool run_parallel_none_of(parallel_example_context& context)
{
    return parallel_case_none_of::example(context);
}

namespace parallel_case_partition {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::partition(policy, input, input + 4, size_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 2u)
        return false;
    int actual[4]{};
    if (!context.read(context.input, actual))
        return false;
    bool seen[5]{};
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] < 1 || actual[index] > 4 || seen[actual[index]])
            return false;
        seen[actual[index]] = true;
        if ((actual[index] % 2 == 0) != (index < 2))
            return false;
    }
    return true;
}
}  // namespace parallel_case_partition

bool run_parallel_partition(parallel_example_context& context)
{
    return parallel_case_partition::example(context);
}

namespace parallel_case_partition_copy {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    auto* size_sink = context.size_sink;
    const auto status =
        asc::parallel::partition_copy(policy, input, input + 4, output, output + 4, size_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 2u)
        return false;
    int actual[8]{};
    if (!context.read(context.output, actual))
        return false;
    if (actual[0] != 2 || actual[1] != 4 || actual[4] != 1 || actual[5] != 3)
        return false;
    return true;
}
}  // namespace parallel_case_partition_copy

bool run_parallel_partition_copy(parallel_example_context& context)
{
    return parallel_case_partition_copy::example(context);
}

namespace parallel_case_reduce {
struct binary_operation {
    __aicore__ int operator()(int left, int right) const
    {
        return left + right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status = asc::parallel::reduce(policy, input, input + 4, 0, output, binary_operation{});
    if (!context.complete(status))
        return false;
    int actual[1]{};
    const int expected[] = {10};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 1; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_reduce

bool run_parallel_reduce(parallel_example_context& context)
{
    return parallel_case_reduce::example(context);
}

namespace parallel_case_remove {

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::remove(policy, input, input + 4, 3, size_sink);
    if (!context.complete(status))
        return false;
    int actual[3]{};
    const int expected[] = {1, 2, 4};
    if (!context.read(context.input, actual))
        return false;
    for (unsigned index = 0; index < 3; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 3u)
        return false;
    return true;
}
}  // namespace parallel_case_remove

bool run_parallel_remove(parallel_example_context& context)
{
    return parallel_case_remove::example(context);
}

