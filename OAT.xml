<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <licensefile>LICENSE</licensefile>
        <policylist>
            <policy name="projectPolicy" desc="Project allowed licenses">
                <policyitem type="license" name="Apache-2.0" path=".*" rule="may" group="defaultGroup" filefilter="defaultPolicyFilter" desc="Approved Apache 2.0 license"/>
                <policyitem type="copyright" name="湖北多样性算力应用创新研究院 (Hubei Institute for Heterogeneous Computing Applications)" path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc="Approved copyright owner"/>
                <policyitem type="filetype" name="!binary" path=".*" rule="must" group="defaultGroup" filefilter="binaryFileTypePolicyFilter" desc="Reject binary files unless explicitly filtered"/>
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultFilter" desc="Files not to check">
            </filefilter>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility, license header policies">
                <filteritem type="filename" name="*.gitignore" desc="git ignore file"/>
                <filteritem type="filename" name=".gitkeep" desc="git directory placeholder, no license header required"/>
                <filteritem type="filename" name=".author" desc="author metadata file"/>
                <filteritem type="filename" name="*.json" desc="test metadata or configuration file"/>
                <filteritem type="filename" name="*.md" desc="documentation file"/>
                <filteritem type="filename" name="*.png" desc="image file"/>
                <filteritem type="filename" name="*.xml" desc="configuration or metadata file"/>
                <filteritem type="filename" name="*.yaml" desc="configuration file"/>
                <filteritem type="filename" name="*.yml" desc="configuration file"/>
                <filteritem type="filename" name="*.cfg" desc="tool configuration file"/>
                <filteritem type="filename" name=".clang-format" desc="tool configuration file"/>
                <filteritem type="filename" name=".pre-commit-config.yaml" desc="tool configuration file"/>
                <filteritem type="filename" name="LICENSE" desc="license text"/>
                <filteritem type="filename" name="OAT.xml" desc="audit tool configuration file"/>
            </filefilter>
            <filefilter name="copyrightPolicyFilter" desc="Filters for copyright header policies">
                <filteritem type="filename" name="*.gitignore" desc="git ignore file"/>
                <filteritem type="filename" name=".gitkeep" desc="git directory placeholder, no copyright header required"/>
                <filteritem type="filename" name=".author" desc="author metadata file"/>
                <filteritem type="filename" name="*.json" desc="test metadata or configuration file"/>
                <filteritem type="filename" name="*.md" desc="documentation file"/>
                <filteritem type="filename" name="*.png" desc="image file"/>
                <filteritem type="filename" name="*.xml" desc="configuration or metadata file"/>
                <filteritem type="filename" name="*.yaml" desc="configuration file"/>
                <filteritem type="filename" name="*.yml" desc="configuration file"/>
                <filteritem type="filename" name="*.cfg" desc="tool configuration file"/>
                <filteritem type="filename" name=".clang-format" desc="tool configuration file"/>
                <filteritem type="filename" name=".pre-commit-config.yaml" desc="tool configuration file"/>
                <filteritem type="filename" name="LICENSE" desc="license text"/>
                <filteritem type="filename" name="OAT.xml" desc="audit tool configuration file"/>
            </filefilter>
            <filefilter name="licenseFileNamePolicyFilter" desc="Filters for LICENSE file policies">
            </filefilter>
            <filefilter name="readmeFileNamePolicyFilter" desc="Filters for README file policies">
            </filefilter>
            <filefilter name="readmeOpenSourcefileNamePolicyFilter" desc="Filters for README.OpenSource file policies">
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies">
                <filteritem type="filename" name="*.png" desc="architecture diagram image for documentation"/>
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="asc-stl Apache-2.0 header" desc="If the scanning result is InvalidLicense, you can define matching rules here. Note that quotation marks must be escaped.">
                <licensetext name="
                    Copyright 2026 湖北多样性算力应用创新研究院 (Hubei Institute for Heterogeneous Computing Applications)

                    Licensed under the Apache License, Version 2.0 (the &quot;License&quot;);
                    you may not use this file except in compliance with the License.
                    You may obtain a copy of the License at

                        http://www.apache.org/licenses/LICENSE-2.0

                    Unless required by applicable law or agreed to in writing, software
                    distributed under the License is distributed on an &quot;AS IS&quot; BASIS,
                    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
                    See the License for the specific language governing permissions and
                    limitations under the License.
                " desc=""/>
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>
