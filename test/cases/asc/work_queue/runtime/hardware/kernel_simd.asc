// D-SIMD hardware kernel: eight ordinary-AICore blocks claim disjoint chunks
// through the core acquisition path.
#include <c_api/scalar_compute/scalar_compute.h>
#include <cstdint>

#include "../semantics.h"

extern "C" __global__ __vector__ void asc_stl_b026_work_queue_simd_kernel(
    __gm__ std::uint32_t* visits, __gm__ asc::detail::work_cursor* cursor)
{
    asc_stl_work_queue_runtime::evaluate(visits, cursor, 257u, 7u);
}

void launch_asc_stl_b026_work_queue_simd(std::uint32_t* visits, asc::detail::work_cursor* cursor, void* stream)
{
    asc_stl_b026_work_queue_simd_kernel<<<8, nullptr, stream>>>(visits, cursor);
}

extern "C" __global__ __vector__ void asc_stl_b026_work_queue_boundary_simd_kernel(
    __gm__ std::uint32_t* result, __gm__ asc::detail::work_cursor* cursor)
{
    asc_stl_work_queue_runtime::evaluate_uint64_boundary(result, cursor);
}

void launch_asc_stl_b026_work_queue_boundary_simd(std::uint32_t* result, asc::detail::work_cursor* cursor, void* stream)
{
    asc_stl_b026_work_queue_boundary_simd_kernel<<<1, nullptr, stream>>>(result, cursor);
}
