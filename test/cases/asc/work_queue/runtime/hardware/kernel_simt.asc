// Pure-SIMT hardware kernel: eight 32-lane warps claim through their lane-0
// leader and broadcast the chunk bounds through the warp vocabulary.
#include <cstdint>

#include "../semantics.h"

extern "C" __global__ void asc_stl_b026_work_queue_simt_kernel(std::uint32_t* visits, asc::detail::work_cursor* cursor)
{
    asc_stl_work_queue_runtime::evaluate(visits, cursor, 257u, 11u);
}

void launch_asc_stl_b026_work_queue_simt(std::uint32_t* visits, asc::detail::work_cursor* cursor, void* stream)
{
    asc_stl_b026_work_queue_simt_kernel<<<8, 32, 0, stream>>>(visits, cursor);
}

extern "C" __global__ void asc_stl_b026_work_queue_boundary_simt_kernel(
    std::uint32_t* result, asc::detail::work_cursor* cursor)
{
    if (threadIdx.x == 0) {
        asc_stl_work_queue_runtime::evaluate_uint64_boundary(result, cursor);
    }
}

void launch_asc_stl_b026_work_queue_boundary_simt(std::uint32_t* result, asc::detail::work_cursor* cursor, void* stream)
{
    asc_stl_b026_work_queue_boundary_simt_kernel<<<1, 32, 0, stream>>>(result, cursor);
}
