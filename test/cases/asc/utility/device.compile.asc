#include "support/utility_semantics.h"

CANN_ASC_STL_API unsigned utility_device_compile(float value, unsigned long long integer)
{
    static_assert(asc_stl_utility_test::evaluate() == 0);
    static_assert(!asc_stl_utility_test::supports_range<double>::value);
    static_assert(!asc_stl_utility_test::supports_range<long double>::value);
    return asc_stl_utility_test::evaluate() + asc::in_range(value, -1.0f, 1.0f) +
        asc::in_range(integer, 0ULL, 0xffffffffffffffffULL);
}
