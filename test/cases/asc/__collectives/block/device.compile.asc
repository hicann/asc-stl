#include <asc/collectives>
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ unsigned int asc_stl_b018_collectives_compile(unsigned int* workspace, unsigned int value)
{
    auto shared = asc::make_block_collective_workspace(workspace, 32u);
    unsigned int result = asc::block_reduce_add(shared, value);
    result += asc::block_reduce_min(shared, value);
    result += asc::block_reduce_max(shared, value);
    result += asc::block_broadcast(shared, value, 0u);
    result += asc::block_inclusive_scan(shared, value);
    result += asc::block_exclusive_scan(shared, value);
    result += asc::block_all(shared, true);
    result += asc::block_any(shared, true);
    result += shared.size();
    result += static_cast<unsigned int>(asc::block_collective_workspace_bytes<unsigned int>(32u));
    return result;
}

__aicore__ void asc_stl_b018_collectives_signed_compile(__INT32_TYPE__* workspace, __INT32_TYPE__ value)
{
    auto shared = asc::make_block_collective_workspace(workspace, 32u);
    (void)asc::block_reduce_add(shared, value);
    (void)asc::block_reduce_min(shared, value);
    (void)asc::block_reduce_max(shared, value);
    (void)asc::block_broadcast(shared, value, 0u);
    (void)asc::block_inclusive_scan(shared, value);
    (void)asc::block_exclusive_scan(shared, value);
}

__aicore__ void asc_stl_b018_collectives_float_compile(float* workspace, float value)
{
    auto shared = asc::make_block_collective_workspace(workspace, 32u);
    (void)asc::block_reduce_add(shared, value);
    (void)asc::block_reduce_min(shared, value);
    (void)asc::block_reduce_max(shared, value);
    (void)asc::block_broadcast(shared, value, 0u);
    (void)asc::block_inclusive_scan(shared, value);
    (void)asc::block_exclusive_scan(shared, value);
}
#else
__aicore__ unsigned int asc_stl_b018_collectives_compile(__ubuf__ unsigned int* input, __ubuf__ unsigned int* output)
{
    asc::ub_span<const unsigned int> source(input, 4);
    asc::ub_span<unsigned int> destination(output, 4);
    unsigned int result = asc::ub_reduce_add(source);
    result += asc::ub_reduce_min(source);
    result += asc::ub_reduce_max(source);
    asc::ub_inclusive_scan(destination, source);
    asc::ub_exclusive_scan(destination, source);
    return result;
}

__aicore__ void asc_stl_b018_collectives_signed_compile(__ubuf__ __INT32_TYPE__* input, __ubuf__ __INT32_TYPE__* output)
{
    asc::ub_span<const __INT32_TYPE__> source(input, 4);
    asc::ub_span<__INT32_TYPE__> destination(output, 4);
    (void)asc::ub_reduce_add(source);
    (void)asc::ub_reduce_min(source);
    (void)asc::ub_reduce_max(source);
    asc::ub_inclusive_scan(destination, source);
    asc::ub_exclusive_scan(destination, source);
}

__aicore__ void asc_stl_b018_collectives_float_compile(__ubuf__ float* input, __ubuf__ float* output)
{
    asc::ub_span<const float> source(input, 4);
    asc::ub_span<float> destination(output, 4);
    (void)asc::ub_reduce_add(source);
    (void)asc::ub_reduce_min(source);
    (void)asc::ub_reduce_max(source);
    asc::ub_inclusive_scan(destination, source);
    asc::ub_exclusive_scan(destination, source);
}
#endif
