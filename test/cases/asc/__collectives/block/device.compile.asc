#include <asc/collectives>
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ unsigned int asc_stl_b018_collectives_compile(unsigned int* workspace, unsigned int value)
{
    unsigned int result = asc::detail::block_reduce_add_impl(workspace, value);
    result += asc::detail::block_reduce_min_impl(workspace, value);
    result += asc::detail::block_reduce_max_impl(workspace, value);
    result += asc::detail::block_broadcast_impl(workspace, value, 0);
    result += asc::detail::block_inclusive_scan_add_impl(workspace, value);
    result += asc::detail::block_exclusive_scan_add_impl(workspace, value);
    result += asc::detail::block_all_impl(workspace, true);
    result += asc::detail::block_any_impl(workspace, true);
    return result;
}
#else
__aicore__ unsigned int asc_stl_b018_collectives_compile(__ubuf__ unsigned int* input, __ubuf__ unsigned int* output)
{
    asc::ub_span<const unsigned int> source(input, 4);
    asc::ub_span<unsigned int> destination(output, 4);
    unsigned int result = asc::detail::ub_reduce_add_impl(source);
    result += asc::detail::ub_reduce_min_impl(source);
    result += asc::detail::ub_reduce_max_impl(source);
    asc::detail::ub_inclusive_scan_add_impl(destination, source);
    asc::detail::ub_exclusive_scan_add_impl(destination, source);
    return result;
}
#endif
