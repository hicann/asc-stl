#include <asc/collectives>
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ unsigned int asc_stl_b018_collectives_compile(unsigned int* workspace, unsigned int value)
{
    unsigned int result = asc::block_reduce_add(asc::make_block_collective_workspace(workspace, 32U), value);
    result += asc::block_reduce_min(asc::make_block_collective_workspace(workspace, 32U), value);
    result += asc::block_reduce_max(asc::make_block_collective_workspace(workspace, 32U), value);
    result += asc::block_broadcast(asc::make_block_collective_workspace(workspace, 32U), value, 0);
    result += asc::block_inclusive_scan(asc::make_block_collective_workspace(workspace, 32U), value);
    result += asc::block_exclusive_scan(asc::make_block_collective_workspace(workspace, 32U), value);
    result += asc::block_all(asc::make_block_collective_workspace(workspace, 32U), true);
    result += asc::block_any(asc::make_block_collective_workspace(workspace, 32U), true);
    return result;
}
#else
__aicore__ unsigned int asc_stl_b018_collectives_compile(__ubuf__ unsigned int* input, __ubuf__ unsigned int* output)
{
    asc::ub_span<const unsigned int> source(input, 4);
    asc::ub_span<unsigned int> destination(output, 4);
    unsigned int result = asc::ub_reduce_add(source);
    result += asc::ub_reduce_min(source);
    result += asc::ub_reduce_max(source);
    asc::ub_inclusive_scan(destination, source);
    asc::ub_exclusive_scan(destination, source);
    return result;
}
#endif
