#include <asc/collectives>
#include "../semantics.h"
extern "C" __global__ __vector__ void asc_stl_b018_simd_kernel(__gm__ unsigned int* output)
{
    __ubuf__ unsigned int values[4];
    asc::ub_span<unsigned int> view(values, 4);
    view[0] = 1;
    view[1] = 2;
    view[2] = 3;
    view[3] = 4;
    asc::gm_span<unsigned int> result(output, 2);
    result[1] = asc::ub_reduce_add(asc::ub_span<const unsigned int>(values, 4));
}
void launch_asc_stl_b018_simd(unsigned int* output, aclrtStream stream)
{
    asc_stl_b018_simd_kernel<<<1, nullptr, stream>>>(output);
}
