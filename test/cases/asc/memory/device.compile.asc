#include <asc/memory>
#include "support/b011_semantics.h"

__aicore__ int asc_stl_b011_device_semantics()
{
    return asc_stl_b011_test::evaluate_runtime();
}

#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
__aicore__ unsigned int check_view_references(__gm__ unsigned int* global, __ubuf__ unsigned int* local)
{
    asc::gm_span<unsigned int> output(global, 2);
    asc::ub_span<unsigned int> scratch(local, 2);
    scratch[1] = 7;
    const asc::ub_span<const unsigned int> readonly(local, 2);
    output[1] = readonly[1];
    const asc::gm_span<const unsigned int> input(global, 2);
    return input[1];
}
#endif
