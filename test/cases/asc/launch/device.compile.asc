#include <asc/launch>

#if CANN_ASC_STL_USE_SIMT_LAUNCH
__global__ void asc_stl_b019_launch_kernel(int*)
{}
#else
extern "C" __global__ __vector__ void asc_stl_b019_launch_kernel(__gm__ int*)
{}
#endif

void instantiate_launch(void* stream, int* output) noexcept
{
    const auto policy = asc::execution::device.on(asc::stream_ref{stream});
    (void)policy;
#if CANN_ASC_STL_USE_SIMT_LAUNCH
    (void)asc::launch<asc_stl_b019_launch_kernel>(
        asc::stream_ref{stream}, asc::simt_launch_config{{1, 1, 1}, {1, 1, 1}, 0}, output);
#else
    (void)asc::launch<asc_stl_b019_launch_kernel>(asc::stream_ref{stream}, asc::aicore_launch_config{1}, output);
#endif
}
