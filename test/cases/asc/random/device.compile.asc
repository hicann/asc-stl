#include "../../../support/random_semantics.h"

CANN_ASC_STL_API unsigned long long random_device(asc::std::uint64_t seed, unsigned long long count)
{
    asc::pcg64 engine(seed);
    engine.discard(count);
    asc::pcg64 copy(engine);
    copy = engine;
    const auto next = engine();
    const auto copied = copy();
    return next ^ copied ^ asc_stl_random_test::composition(seed) ^
        asc_stl_random_test::short_discard(seed, static_cast<unsigned>(count & 63U));
}
