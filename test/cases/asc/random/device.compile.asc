#include <asc/random>
#include <asc/std/expected>
CANN_ASC_STL_API unsigned long long w11_random_device()
{
    asc::pcg64 engine(7);
    asc::std::expected<int, int> value(3);
    return engine() + static_cast<unsigned long long>(*value);
}
