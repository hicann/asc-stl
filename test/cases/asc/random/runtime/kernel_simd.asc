#include "semantics.h"

extern "C" __global__ __vector__ void random_kernel(
    __gm__ std::uint64_t* output, const __gm__ std::uint64_t* input, unsigned count)
{
    for (unsigned index = get_block_idx(); index < count; index += 4) {
        asc_stl_random_runtime::evaluate(output + index * random_output_stride, input[index * 2], input[index * 2 + 1]);
    }
}

void launch_random(std::uint64_t* output, const std::uint64_t* input, unsigned count, void* stream)
{
    random_kernel<<<4, nullptr, stream>>>(output, input, count);
}
