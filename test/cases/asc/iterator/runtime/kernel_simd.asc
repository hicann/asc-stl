#include "launch.h"
#include "../../../../support/iterator_adaptors.h"

extern "C" __global__ __vector__ void iterator_kernel(__gm__ unsigned* output, __gm__ const unsigned* input)
{
    __ubuf__ unsigned scratch[7];
    scratch[0] = 0x12345678u;
    scratch[6] = 0x76543210u;
    asc_stl_iterator_test::evaluate_spaces(output + 8, input, scratch + 1);
    if (scratch[0] != 0x12345678u || scratch[6] != 0x76543210u) {
        output[8] += 100;
    }
}

void launch_iterator(unsigned* output, const unsigned* input, void* stream)
{
    iterator_kernel<<<1, nullptr, stream>>>(output, input);
}
