#include "../../../support/iterator_adaptors.h"

__aicore__ int asc_stl_iterator_contracts()
{
    return asc_stl_iterator_test::evaluate();
}

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ void asc_stl_iterator_spaces(int* global, int* local)
#else
__aicore__ void asc_stl_iterator_spaces(__gm__ int* global, __ubuf__ int* local)
#endif
{
    auto gm = asc::make_strided_iterator(global, 5, 2);
    auto ub = asc::make_strided_iterator(local, 5, -2);
    static_assert(asc::std::is_same_v<decltype(*gm), decltype(*global)>);
    static_assert(asc::std::is_same_v<decltype(*ub), decltype(*local)>);
    auto transform = asc::make_transform_output_iterator(gm, asc_stl_iterator_test::twice{});
    auto saved = *transform++;
    saved = 7;
    ub[1] = gm[0];
    auto zip = asc::make_zip_iterator(global, local);
    *zip = asc::std::tuple<int, int>(11, 13);
}
