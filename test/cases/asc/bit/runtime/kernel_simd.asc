#include "semantics.h"

extern "C" __global__ __vector__ void bit_simd_kernel(
    __gm__ asc::std::uint64_t* output, const __gm__ bit_record* records, unsigned count)
{
    // Sixteen records occupy 1024 output bytes. Each core writes separate
    // 512-byte cache lines while all input patterns remain in this run.
    const unsigned begin = get_block_idx() * 16;
    const unsigned end = begin + 16 < count ? begin + 16 : count;
    for (unsigned index = begin; index < end; ++index) {
        bit_evaluate_record(records, output, index);
    }
}

void launch_bit(asc::std::uint64_t* output, const bit_record* records, unsigned count, void* stream)
{
    bit_simd_kernel<<<(count + 15) / 16, nullptr, stream>>>(output, records, count);
}
