#include "support/bit_contracts.h"

__aicore__ bit_test::u64 bit_public_device_contract(bit_test::u64 value, bit_test::u64 source, int start, int width)
{
    const auto low_value = static_cast<bit_test::u32>(value);
    const auto low_source = static_cast<bit_test::u32>(source);
    const unsigned failures = bit_test::check_window(value, source, start, width) +
        bit_test::check_window(low_value, low_source, start, width);
    return asc::bit_reverse(value) ^ asc::bit_reverse(low_value) ^ failures;
}
