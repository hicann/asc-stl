#include "support/numeric_contracts.h"

CANN_ASC_STL_HOST_DEVICE unsigned long long numeric_device_compile(unsigned long long left, unsigned long long right)
{
    unsigned long long combined = 0;
    combined ^= numeric_test::dynamic(static_cast<signed char>(left), static_cast<signed char>(right));
    combined ^= numeric_test::dynamic(static_cast<unsigned char>(left), static_cast<unsigned char>(right));
    combined ^= numeric_test::dynamic(static_cast<short>(left), static_cast<short>(right));
    combined ^= numeric_test::dynamic(static_cast<unsigned short>(left), static_cast<unsigned short>(right));
    combined ^= numeric_test::dynamic(static_cast<int>(left), static_cast<int>(right));
    combined ^= numeric_test::dynamic(static_cast<unsigned int>(left), static_cast<unsigned int>(right));
    combined ^= numeric_test::dynamic(static_cast<long>(left), static_cast<long>(right));
    combined ^= numeric_test::dynamic(static_cast<unsigned long>(left), static_cast<unsigned long>(right));
    combined ^= numeric_test::dynamic(static_cast<long long>(left), static_cast<long long>(right));
    combined ^= numeric_test::dynamic(static_cast<unsigned long long>(left), static_cast<unsigned long long>(right));
    return combined;
}
