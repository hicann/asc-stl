#include "semantics.h"

extern "C" __global__ __vector__ void numeric_kernel(
    __gm__ numeric_word* output, const __gm__ numeric_word* input, unsigned count)
{
    // Each record owns a 512-byte output slot; different cores never share
    // a scalar cache line. Round-robin dispatch balances the checked types.
    for (unsigned index = get_block_idx(); index < count; index += 32) {
        const unsigned base = index * numeric_input_words;
        const auto actual =
            numeric_runtime_test::dispatch(static_cast<unsigned>(input[base]), static_cast<unsigned>(input[base + 1]),
                input[base + 2], input[base + 3], static_cast<unsigned>(input[base + 4]));
        output[index * numeric_output_stride] = actual.value;
        output[index * numeric_output_stride + 1] = actual.failed;
        output[index * numeric_output_stride + 2] = actual.consistent ? 0 : 1;
    }
}

void launch_numeric(numeric_word* output, const numeric_word* input, unsigned count, void* stream)
{
    numeric_kernel<<<32, nullptr, stream>>>(output, input, count);
}
