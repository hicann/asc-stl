#include <asc/pipeline>
#include <cstdint>

#if !CANN_ASC_STL_DETAIL_SIMT_COMPILATION()

extern "C" __global__ __vector__ void asc_stl_b024_pipeline_compile_kernel(
    __gm__ std::uint32_t* output, __gm__ const std::uint32_t* input)
{
    __ubuf__ std::uint32_t stage[256];
    auto pipeline = asc::make_pipeline(2u, 3u, 4u, 5u);
    if (pipeline.stages() != 2u || pipeline.load_event(1u) != 4u || pipeline.store_event(1u) != 5u) {
        output[0] = 0xBAD1u;
        return;
    }
    pipeline.producer_acquire(0u);
    asc::copy_async(
        pipeline, 0u, asc::ub_span<std::uint32_t>(stage, 256u), asc::gm_span<const std::uint32_t>(input, 256u));
    pipeline.producer_commit(0u);
    pipeline.consumer_wait(0u);
    stage[0] += 7u;
    pipeline.consumer_release(0u);
    asc::copy_async(
        pipeline, 1u, asc::gm_span<std::uint32_t>(output, 256u), asc::ub_span<const std::uint32_t>(stage, 256u));
    pipeline.wait();
}

__aicore__ int asc_stl_b024_pipeline_device_compile()
{
    return 0;
}

#else

// asc/pipeline delivers its coordinator in ordinary AICore only; the pure
// SIMT translation unit parses the Header without instantiating the surface.
__aicore__ int asc_stl_b024_pipeline_device_compile()
{
    return 0;
}

#endif
