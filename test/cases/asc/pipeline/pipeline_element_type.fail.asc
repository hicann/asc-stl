#include <asc/pipeline>
#include <cstdint>

__aicore__ void use_copy_async(__gm__ double* destination, __ubuf__ const double* source)
{
    auto pipeline = asc::make_pipeline(2u, 3u);
    asc::copy_async(pipeline, 0u, asc::gm_span<double>(destination, 4u), asc::ub_span<const double>(source, 4u));
}
