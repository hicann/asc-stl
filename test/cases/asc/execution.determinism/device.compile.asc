#include <asc/execution.determinism.h>

static_assert(asc::determinism::device_to_device != asc::determinism::run_to_run);
static_assert(asc::determinism::run_to_run != asc::determinism::not_guaranteed);

CANN_ASC_STL_API int execution_determinism_device_compile()
{
    constexpr auto requirement = asc::determinism::device_to_device;
    return requirement == asc::determinism::device_to_device ? 0 : 1;
}
