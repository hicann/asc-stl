#include <asc/__utility/static_for.h>

CANN_ASC_STL_API int static_for_device_compile()
{
    int total = 0;
    asc::detail::static_for_count<int, 5>([&total](auto index) { total += index.value; });
    return total == 10 ? 0 : 1;
}
