#include <asc/__tensor_copy/backend.h>
#include <asc/__tensor_copy/descriptor.h>
#include <cstdint>

#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
CANN_ASC_STL_DEVICE_API bool tensor_copy_stage_compile(const asc::tensor_copy_descriptor<2>& descriptor)
{
    __ubuf__ float stage[15];
    __gm__ const float* source = nullptr;
    ::asc::detail::tensor_copy_load_ndim(stage, source, descriptor, 0.0f);
    return true;
}
#endif

CANN_ASC_STL_API int tensor_copy_device_compile()
{
    // Descriptor construction and validation are visible in both device
    // modes; the transfer emission itself is ordinary-AICore only.
    const std::uint32_t extents[2] = {3, 5};
    const std::uint32_t source_strides[2] = {8, 1};
    const std::uint32_t destination_strides[2] = {8, 1};
    const std::uint32_t pads[2] = {0, 0};
    const auto descriptor =
        asc::make_tensor_copy_descriptor<2>(extents, source_strides, destination_strides, pads, pads);
    bool ok = descriptor.validate() == asc::tensor_copy_status::success;
    ok = ok && descriptor.required_elements() == 15 && descriptor.required_alignment() == 5;
    static_assert(asc::detail::is_ndim_copy_element<float>::value);
    static_assert(!asc::detail::is_ndim_copy_element<double>::value);
#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
    // The ND-DMA emission compiles in ordinary AICore with __ubuf__ storage.
    ok = ok && tensor_copy_stage_compile(descriptor);
#else
    // Pure SIMT never sees the transfer emission at all.
#endif
    return ok ? 0 : 1;
}
