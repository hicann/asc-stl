// Pure-SIMT kernel: the descriptor value semantics and element gating stay
// visible while the transfer emission itself must not exist.
#include <cstdint>

#include <asc/__tensor_copy/backend.h>
#include <asc/__tensor_copy/descriptor.h>

#include "../../../../../../support/tensor_descriptor_boundaries.h"

extern "C" __global__ void asc_stl_b026_tensor_copy_simt_kernel(std::uint32_t* result)
{
    const std::uint32_t extents[2] = {3, 5};
    const std::uint32_t strides[2] = {8, 8};
    const std::uint32_t pads[2] = {0, 0};
    const auto descriptor = asc::make_tensor_copy_descriptor<2>(extents, strides, strides, pads, pads);
    std::uint32_t failures = 0;
    failures += descriptor.validate() != asc::tensor_copy_status::success;
    failures += descriptor.required_elements() != 15;
    failures += !asc::detail::is_ndim_copy_element<float>::value;
    failures += asc::detail::is_ndim_copy_element<double>::value;
    volatile unsigned int maximum = ~0u;
    failures += asc_stl_tensor_descriptor_test::evaluate(maximum);
    result[0] = failures;
}

void launch_asc_stl_b026_tensor_copy_simt(std::uint32_t* result, void* stream)
{
    asc_stl_b026_tensor_copy_simt_kernel<<<1, 1, 0, stream>>>(result);
}
