// D-SIMD hardware kernel: a rank-2 ND-DMA load of a 3x5 region out of 3x8
// GM source rows into a padded 3x8 UB stage with fill value zero, followed by
// the MTE2-to-S synchronization the pipeline event contract builds on.
#include "launch.h"
#include <c_api/sync/sync.h>
#include <c_api/vector_datamove/vector_datamove.h>
#include <cstdint>

#include <asc/__tensor_copy/backend.h>
#include <asc/__tensor_copy/descriptor.h>

#include "../../../../../../support/tensor_descriptor_boundaries.h"

extern "C" __global__ __vector__ void asc_stl_b026_tensor_copy_simd_kernel(
    __gm__ std::uint32_t* output, __gm__ const std::uint32_t* input)
{
    constexpr std::uint32_t kRows = 3;
    constexpr std::uint32_t kSourceColumns = 8;
    constexpr std::uint32_t kCopiedColumns = 5;
    constexpr std::uint32_t kLeftPad = 1;
    constexpr std::uint32_t kRightPad = 2;
    constexpr std::uint32_t kPaddedColumns = kLeftPad + kCopiedColumns + kRightPad;
    constexpr std::uint32_t kOutputElements = kRows * kPaddedColumns;
    __ubuf__ std::uint32_t stage[kOutputElements];
    for (std::uint32_t index = 0; index < kOutputElements; ++index) {
        stage[index] = 0xA5A5A5A5u;
    }

    const asc::tensor_copy_descriptor<2> descriptor = []() {
        const std::uint32_t extents[2] = {kRows, kCopiedColumns};
        const std::uint32_t destination_strides[2] = {kPaddedColumns, 1};
        const std::uint32_t source_strides[2] = {kSourceColumns, 1};
        const std::uint32_t pads_left[2] = {0, kLeftPad};
        const std::uint32_t pads_right[2] = {0, kRightPad};
        return asc::make_tensor_copy_descriptor<2>(extents, source_strides, destination_strides, pads_left, pads_right);
    }();
    asc::detail::tensor_copy_load_ndim(stage, input, descriptor, std::uint32_t{0});

    asc_sync_notify(pipe_t::PIPE_MTE2, pipe_t::PIPE_S, EVENT_ID0);
    asc_sync_wait(pipe_t::PIPE_MTE2, pipe_t::PIPE_S, EVENT_ID0);
    for (std::uint32_t index = 0; index < kOutputElements; ++index) {
        output[index] = stage[index];
    }
    volatile unsigned int maximum = ~0u;
    output[0] += asc_stl_tensor_descriptor_test::evaluate(maximum);
}

void launch_asc_stl_b026_tensor_copy_simd(__gm__ std::uint32_t* output, __gm__ const std::uint32_t* input, void* stream)
{
    asc_stl_b026_tensor_copy_simd_kernel<<<1, nullptr, stream>>>(output, input);
}
