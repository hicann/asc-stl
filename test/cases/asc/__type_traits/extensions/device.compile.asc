#include <asc/type_traits>
#include "support/extension_type_traits_semantics.h"

#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION() && defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510 && \
    defined(__BISHENG_CCEC__) && __clang_major__ == 15
__simt_vf__ void type_traits_mixed_vf()
{
    static_assert(asc::is_address_space_qualified_v<__gm__ int*>);
    static_assert(asc::is_address_space_qualified_v<__ubuf__ int*>);
    static_assert(!asc::is_address_space_qualified_v<int*>);
}
#elif CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
using GmSpelling = __gm__ int*;
using UbSpelling = __ubuf__ int*;
static_assert(asc::std::is_same_v<GmSpelling, int*>);
static_assert(asc::std::is_same_v<UbSpelling, int*>);
static_assert(!asc::is_address_space_qualified_v<GmSpelling>);
static_assert(!asc::is_address_space_qualified_v<UbSpelling>);
#endif

CANN_ASC_STL_API int extensions_device_compile()
{
    return asc::is_low_precision_v<asc::float16> ? 0 : 1;
}
