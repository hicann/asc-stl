#include <asc/__type_traits/extensions.h>
#include <cstdint>

namespace {
enum Enum { A };
struct Trivial {
    int value;
};
}  // namespace

CANN_ASC_STL_API int extensions_device_compile()
{
    static_assert(asc::is_bitwise_comparable_v<std::uint32_t>);
    static_assert(!asc::is_bitwise_comparable_v<Enum>);
    static_assert(!asc::is_extended_floating_point_v<float>);
    static_assert(asc::is_trivially_relocatable_v<Trivial>);
    return asc::is_trivially_relocatable_v<Trivial> ? 0 : 1;
}
