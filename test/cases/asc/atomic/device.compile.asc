#include <asc/atomic>
#include "../../../support/b013_semantics.h"

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ int asc_stl_b013_device(__INT32_TYPE__* address)
{
    asc::atomic_ref<__INT32_TYPE__> value(*address);
    __INT32_TYPE__ expected = value.load(asc::std::memory_order_relaxed);
    value.store(expected, asc::std::memory_order_relaxed);
    (void)value.exchange(3, asc::std::memory_order_relaxed);
    (void)value.compare_exchange_strong(expected, 4, asc::std::memory_order_relaxed, asc::std::memory_order_relaxed);
    (void)value.fetch_add(2, asc::std::memory_order_relaxed);
    (void)value.fetch_sub(1, asc::std::memory_order_relaxed);
    (void)value.fetch_and(7, asc::std::memory_order_relaxed);
    (void)value.fetch_or(8, asc::std::memory_order_relaxed);
    (void)value.fetch_xor(3, asc::std::memory_order_relaxed);
    (void)value.fetch_min(2, asc::std::memory_order_relaxed);
    (void)value.fetch_max(9, asc::std::memory_order_relaxed);
    asc::relaxed_atomic_ref<__INT32_TYPE__> relaxed(*address);
    relaxed.store(relaxed.load());
    (void)relaxed.exchange(2);
    (void)relaxed.compare_exchange_strong(expected, 3);
    (void)relaxed.fetch_add(1);
    (void)relaxed.fetch_sub(1);
    asc::atomic_thread_fence(asc::std::memory_order_release, asc::memory_scope::device);
    return asc_stl_b013_test::evaluate_common();
}
#else
__aicore__ int asc_stl_b013_device()
{
    return asc_stl_b013_test::evaluate_common();
}
#endif
