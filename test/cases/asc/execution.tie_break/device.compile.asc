#include <asc/execution.tie_break.h>

static_assert(asc::tie_break::unspecified != asc::tie_break::prefer_smaller_index);
static_assert(asc::tie_break::prefer_smaller_index != asc::tie_break::prefer_larger_index);

CANN_ASC_STL_API int execution_tie_break_device_compile()
{
    constexpr auto requirement = asc::tie_break::prefer_larger_index;
    return requirement == asc::tie_break::prefer_larger_index ? 0 : 1;
}
