#include <acl/acl.h>
#include "../semantics.h"
__global__ void asc_stl_b017_simt_kernel(__INT32_TYPE__* output)
{
    asc_stl_b017_runtime::evaluate(output);
}
__global__ void asc_stl_b017_message_kernel(__INT32_TYPE__* output)
{
    asc_stl_b017_runtime::evaluate_message_passing(output);
}
void launch_asc_stl_b017(__INT32_TYPE__* output, aclrtStream stream)
{
    asc_stl_b017_simt_kernel<<<2, 64, 0, stream>>>(output);
    asc_stl_b017_message_kernel<<<2, 32, 0, stream>>>(output);
}
