#include <asc/__functional/metadata.h>

CANN_ASC_STL_API int functional_metadata_device_compile()
{
    constexpr bool associative = asc::detail::is_associative_op<asc::detail::add_op>::value;
    constexpr int identity = asc::detail::identity_element_op<asc::detail::multiply_op, int>::value;
    return associative && identity == 1 && asc::detail::always_true_op{}() ? 0 : 1;
}
