#include <asc/__functional/metadata.h>

CANN_ASC_STL_API int functional_metadata_device_compile()
{
    using Registration = asc::detail::functional_properties<asc::std::plus<int>, int>;
    static_assert(!Registration::associative && !Registration::commutative);
    return Registration::has_identity && Registration::identity == 0 ? 0 : 1;
}
