#include "../../../../support/b019_frontend_types.h"

using namespace asc_stl_b019_compile;

void instantiate_numeric_frontends(arguments value) noexcept
{
    if constexpr (false) {
        (void)asc::parallel::all_of(value.policy, value.input, value.input + 4, value.flag(), positive_int{});
        (void)asc::parallel::any_of(value.policy, value.input, value.input + 4, value.flag(), positive_int{});
        (void)asc::parallel::count(value.policy, value.input, value.input + 4, 1, value.count());
        (void)asc::parallel::count_if(value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::equal(
            value.policy, value.input, value.input + 4, value.output, value.output + 4, value.flag(), equal_int{});
        (void)asc::parallel::exclusive_scan(value.policy, value.input, value.input + 4, value.output, 0, plus_int{});
        (void)asc::parallel::inclusive_scan(value.policy, value.input, value.input + 4, value.output, 0, plus_int{});
        (void)asc::parallel::merge(
            value.policy, value.input, value.input + 2, value.input + 2, value.input + 4, value.output, less_int{});
        (void)asc::detail::submit(
            value.policy, asc::detail::merge_sort_operation<int*, less_int>{value.input, value.input + 4, less_int{}});
        (void)asc::parallel::none_of(value.policy, value.input, value.input + 4, value.flag(), positive_int{});
        (void)asc::parallel::reduce(value.policy, value.input, value.input + 4, 0, value.scalar, plus_int{});
        (void)asc::parallel::sort(value.policy, value.input, value.input + 4, less_int{});
        (void)asc::parallel::transform_exclusive_scan(
            value.policy, value.input, value.input + 4, value.output, 0, plus_int{}, plus_one{});
        (void)asc::parallel::transform_inclusive_scan(
            value.policy, value.input, value.input + 4, value.output, plus_int{}, plus_one{}, 0);
        (void)asc::parallel::transform_reduce(
            value.policy, value.input, value.input + 4, 0, value.scalar, plus_int{}, plus_one{});
    }
}
