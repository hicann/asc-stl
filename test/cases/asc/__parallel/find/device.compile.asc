#include "../../../../support/b019_frontend_types.h"

using namespace asc_stl_b019_compile;

void instantiate_find_frontends(arguments value) noexcept
{
    if constexpr (false) {
        (void)asc::parallel::adjacent_find(value.policy, value.input, value.input + 4, value.count(), equal_int{});
        (void)asc::parallel::find(value.policy, value.input, value.input + 4, 1, value.count());
        (void)asc::parallel::find_if(value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::find_if_not(value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::is_heap(value.policy, value.input, value.input + 4, value.flag(), less_int{});
        (void)asc::parallel::is_heap_until(value.policy, value.input, value.input + 4, value.count(), less_int{});
        (void)asc::parallel::is_partitioned(value.policy, value.input, value.input + 4, value.flag(), positive_int{});
        (void)asc::parallel::is_sorted(value.policy, value.input, value.input + 4, value.flag(), less_int{});
        (void)asc::parallel::is_sorted_until(value.policy, value.input, value.input + 4, value.count(), less_int{});
        (void)asc::parallel::max_element(value.policy, value.input, value.input + 4, value.count(), less_int{});
        (void)asc::parallel::min_element(value.policy, value.input, value.input + 4, value.count(), less_int{});
        (void)asc::parallel::mismatch(
            value.policy, value.input, value.input + 4, value.output, value.output + 4, value.count(), equal_int{});
    }
}
