#include "../../../../support/b019_frontend_types.h"

using namespace asc_stl_b019_compile;

void instantiate_shift_frontends(arguments value) noexcept
{
    if constexpr (false) {
        (void)asc::parallel::shift_left(value.policy, value.input, value.input + 4, 1);
        (void)asc::parallel::shift_right(value.policy, value.input, value.input + 4, 1);
    }
}
