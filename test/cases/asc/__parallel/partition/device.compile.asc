#include "../../../../support/b019_frontend_types.h"

using namespace asc_stl_b019_compile;

void instantiate_mutating_frontends(arguments value) noexcept
{
    if constexpr (false) {
        (void)asc::parallel::copy_if(
            value.policy, value.input, value.input + 4, value.output, value.count(), positive_int{});
        (void)asc::parallel::partition(value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::partition_copy(
            value.policy, value.input, value.input + 4, value.output, value.output + 4, value.count(), positive_int{});
        (void)asc::parallel::remove(value.policy, value.input, value.input + 4, 1, value.count());
        (void)asc::parallel::remove_copy(value.policy, value.input, value.input + 4, value.output, 1, value.count());
        (void)asc::parallel::remove_copy_if(
            value.policy, value.input, value.input + 4, value.output, value.count(), positive_int{});
        (void)asc::parallel::remove_if(value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::stable_partition(
            value.policy, value.input, value.input + 4, value.count(), positive_int{});
        (void)asc::parallel::unique(value.policy, value.input, value.input + 4, value.count(), equal_int{});
        (void)asc::parallel::unique_copy(
            value.policy, value.input, value.input + 4, value.output, value.count(), equal_int{});
    }
}
