#include <asc/execution.output_ordering.h>

static_assert(asc::output_ordering::sorted != asc::output_ordering::stable_sorted);
static_assert(asc::output_ordering::stable_sorted != asc::output_ordering::unsorted);

CANN_ASC_STL_API int execution_output_ordering_device_compile()
{
    constexpr auto requirement = asc::output_ordering::sorted;
    return requirement == asc::output_ordering::sorted ? 0 : 1;
}
