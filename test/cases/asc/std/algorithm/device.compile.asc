#include <asc/std/algorithm>

#include "../../../../support/v1_algorithm_semantics.h"

CANN_ASC_STL_API int w11_algorithm_device()
{
    int values[] = {4, 1, 3, 2};
    asc::std::sort(values, values + 4);
    asc::std::nth_element(values, values + 2, values + 4);
#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
    asc::std::stable_sort(values, values + 4);
#endif
    return values[0] + values[3] + asc_stl_v1_algorithm_test::evaluate();
}

#if defined(__clang__) && defined(CANN_ASC_STL_USE_SIMT_LAUNCH)
void w11_policy_replace_compile(asc::device_policy policy, int* input, int* output)
{
    asc::std::replace(policy, input, input + 4, 2, 8);
    (void)asc::std::replace_copy(policy, input, input + 4, output, 3, 9);
}
#endif
