#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include <asc/std/algorithm>
#include <asc/std/functional>
#include "config.h"
#include "launch.h"

namespace {
struct Even {
    CANN_ASC_STL_API constexpr bool operator()(int x) const
    {
        return x % 2 == 0;
    }
};
struct Double {
    CANN_ASC_STL_API constexpr int operator()(int x) const
    {
        return x * 2;
    }
};
struct Combine {
    CANN_ASC_STL_API constexpr int operator()(int x, int y) const
    {
        return x * 3 + y;
    }
};
struct Append {
    CANN_ASC_STL_API constexpr int operator()(int x, int y) const
    {
        return x * 10 + y;
    }
};
struct Record {
    int key;
};

template <class Pointer>
__simt_vf__ __aicore__ inline void check_path(Pointer first, __gm__ int* result, int length)
{
    auto last = first + length;
    result[0] = asc::std::ranges::find(first, last, -3) - first;
    result[1] = asc::std::ranges::contains(first, last, 4);
    auto copied = asc::std::ranges::copy(first, last, first + 64);
    result[2] = copied.in - first;
    result[3] = copied.out - (first + 64);
    auto selected = asc::std::ranges::copy_if(first, last, first + 128, Even{});
    result[4] = selected.out - (first + 128);
    result[5] = asc::std::ranges::fill(first + 192, first + 192 + length, 17) - (first + 192);
    auto transformed = asc::std::ranges::transform(first, last, first + 256, Double{});
    result[6] = transformed.out - (first + 256);
    result[7] = transformed.in == last;
    auto binary = asc::std::ranges::transform(first, last, first + 16, first + 24, first + 320, Combine{});
    result[8] = binary.in1 - first;
    result[9] = binary.in2 - (first + 16);
    result[10] = binary.out - (first + 320);
    auto partitioned = asc::std::ranges::partition_copy(first, last, first + 384, first + 448, Even{});
    result[11] = partitioned.out1 - (first + 384);
    result[12] = partitioned.out2 - (first + 448);
    auto filtered = asc::std::ranges::remove_copy_if(first, last, first + 512, Even{});
    result[13] = filtered.out - (first + 512);
    asc::std::ranges::copy(first, last, first + 576);
    auto removed = asc::std::ranges::remove_if(first + 576, first + 576 + length, Even{});
    result[14] = removed.begin() - (first + 576);
    result[15] = removed.end() - (first + 576);
    const int short_length = length < 4 ? length : 4;
    result[16] = asc::std::ranges::fold_left(first, first + short_length, 0, Append{});
    asc::std::ranges::copy(first, last, first + 640);
    result[17] = asc::std::ranges::sort(first + 640, first + 640 + length) - (first + 640);
    result[18] = partitioned.in - first;
    result[19] = selected.in - first;
    result[20] = filtered.in - first;
    // These projection checks always use the fixed fixture, including when length is zero.
    constexpr int record_count = asc_stl_ranges_runtime::projection_count;
    Record records[record_count]{}, yes[record_count]{}, no[record_count]{};
    for (int i = 0; i < record_count; ++i)
        records[i].key = asc_stl_ranges_runtime::projection_keys[i];
    result[21] = asc::std::ranges::find(records, asc_stl_ranges_runtime::projection_find_key, &Record::key) - records;
    result[22] = asc::std::ranges::contains(records, asc_stl_ranges_runtime::projection_contains_key, &Record::key);
    result[23] = asc::std::ranges::sort(records, {}, &Record::key) - records;
    auto projected = asc::std::ranges::copy_if(records, yes, Even{}, &Record::key);
    result[24] = projected.out - yes;
    result[25] = yes[0].key + yes[1].key;
    asc::std::ranges::remove_copy_if(records, no, Even{}, &Record::key);
    result[26] = no[0].key * 10 + no[1].key;
    first[704] = asc_stl_ranges_runtime::swap_left;
    first[705] = asc_stl_ranges_runtime::swap_right;
    asc::std::swap(first[704], first[705]);
    result[27] = first[704];
    result[28] = first[705];
    constexpr int offsets[] = {64, 128, 192, 256, 320, 384, 448, 512, 576, 640};
    for (int section = 0; section < 10; ++section) {
        for (int i = 0; i < 32; ++i) {
            result[32 + section * 32 + i] =
                (section == 8 && i >= result[14]) ? asc_stl_ranges_runtime::poison : first[offsets[section] + i];
        }
    }
}
}  // namespace

extern "C" __global__ __aicore__ void ranges_kernel(__gm__ int* values, __gm__ int* output)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // Each block owns one length and disjoint GM input/output slices.
    const int index = AscendC::GetBlockIdx();
    const int length = asc_stl_ranges_runtime::lengths[index];
    values += index * asc_stl_ranges_runtime::storage_length;
    output += index * asc_stl_ranges_runtime::result_count;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, asc_stl_ranges_runtime::storage_length * sizeof(int));
    auto local = buffer.Get<int>();
    AscendC::GlobalTensor<int> global;
    global.SetGlobalBuffer(values, asc_stl_ranges_runtime::storage_length);
    AscendC::DataCopy(local, global, asc_stl_ranges_runtime::storage_length);
    AscendC::PipeBarrier<PIPE_ALL>();
    asc_vf_call<check_path<__gm__ int*>>(dim3(1), values, output, length);
    asc_vf_call<check_path<__ubuf__ int*>>(dim3(1), reinterpret_cast<__ubuf__ int*>(local.GetPhyAddr()),
        output + asc_stl_ranges_runtime::path_length, length);
    AscendC::PipeBarrier<PIPE_ALL>();
}
void launch_ranges(aclrtStream stream, int* values, int* output)
{
    // The AIV wrapper launches one-thread SIMT VFs via asc_vf_call; its second argument is L2 control.
    ranges_kernel<<<asc_stl_ranges_runtime::case_count, 0, stream>>>(values, output);
}
