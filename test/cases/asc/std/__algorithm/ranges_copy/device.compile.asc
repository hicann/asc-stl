#include <asc/std/algorithm>
#include <asc/std/functional>
__aicore__ int ranges_algorithms_compile()
{
    int values[] = {4, 1, 3, 2};
    int output[4]{};
    asc::std::ranges::copy(values, output);
    asc::std::ranges::copy_if(values, output, [](int x) { return x > 2; });
    asc::std::ranges::remove_copy_if(values, output, [](int x) { return x > 2; });
    asc::std::ranges::fill(output, 0);
    asc::std::ranges::transform(values, output, [](int x) { return x * 2; });
    asc::std::ranges::transform(values, values, output, asc::std::plus<int>{});
    asc::std::ranges::partition_copy(values, output, output + 2, [](int x) { return x > 2; });
    asc::std::ranges::sort(values);
    const auto tail = asc::std::ranges::remove_if(values, [](int x) { return x > 2; });
    return asc::std::ranges::find(values, 2) != values + 4 && asc::std::ranges::contains(values, 1) &&
        asc::std::ranges::fold_left(values, 0, asc::std::plus<int>{}) != 0 && tail.end() == values + 4;
}
