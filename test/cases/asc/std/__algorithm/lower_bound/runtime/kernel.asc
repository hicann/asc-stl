#include <cstdio>
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "../../../algorithm/support/binary_search_regressions.h"
#include "config.h"
#include "launch.h"

template <class Compare>
__simt_vf__ __aicore__ inline void search_bounds(
    __gm__ const int* global, __ubuf__ const int* local, __gm__ const int* lengths, __gm__ int* output)
{
    const int tid = threadIdx.x;
    const int query = (tid - 32) * 3;
    for (int k = 0; k < asc_stl_bounds_runtime::length_count; ++k) {
        const int length = lengths[k];
        const int offset = (k * asc_stl_bounds_runtime::query_count + tid) * 4;
        output[offset] = asc::std::lower_bound(global, global + length, query, Compare{}) - global;
        output[offset + 1] = asc::std::upper_bound(global, global + length, query, Compare{}) - global;
        output[offset + 2] = asc::std::lower_bound(local, local + length, query, Compare{}) - local;
        output[offset + 3] = asc::std::upper_bound(local, local + length, query, Compare{}) - local;
    }
}

extern "C" __global__ __aicore__ void bounds_kernel(
    __gm__ int* values, __gm__ int* lengths, __gm__ int* output, int descending)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int count = asc_stl_bounds_runtime::storage_length;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, count * sizeof(int));
    auto local = buffer.Get<int>();
    AscendC::GlobalTensor<int> global;
    global.SetGlobalBuffer(values, count);
    AscendC::DataCopy(local, global, count);
    AscendC::PipeBarrier<PIPE_ALL>();
    if (descending) {
        asc_vf_call<search_bounds<asc_stl_binary_search_test::Greater>>(dim3(asc_stl_bounds_runtime::query_count),
            values, reinterpret_cast<__ubuf__ const int*>(local.GetPhyAddr()), lengths, output);
    } else {
        asc_vf_call<search_bounds<asc_stl_binary_search_test::Less>>(dim3(asc_stl_bounds_runtime::query_count), values,
            reinterpret_cast<__ubuf__ const int*>(local.GetPhyAddr()), lengths, output);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

void launch_bounds(aclrtStream stream, int* values, int* lengths, int* output, int descending)
{
    bounds_kernel<<<1, asc_stl_bounds_runtime::storage_length * sizeof(int), stream>>>(
        values, lengths, output, descending);
}
