#include "../../../../../support/b020_semantics.h"
#include "support/binary_search_regressions.h"

__aicore__ int asc_stl_b020_mutating_device()
{
    return asc_stl_b020_test::evaluate_mutating_algorithms();
}

#if CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
__aicore__ int binary_search_address_spaces(__gm__ const int* global, __ubuf__ const int* local, int length)
#else
__aicore__ int binary_search_address_spaces(const int* global, const int* local, int length)
#endif
{
    // Inspect declared pointers so each frontend supplies its native memory type.
    using GlobalPointer = decltype(global);
    using LocalPointer = decltype(local);
    static_assert(asc::std::is_same_v<asc::std::iterator_traits<GlobalPointer>::pointer, GlobalPointer>);
    static_assert(asc::std::is_same_v<asc::std::iterator_traits<LocalPointer>::pointer, LocalPointer>);
    static_assert(asc::std::is_same_v<asc::std::iterator_traits<GlobalPointer>::reference, decltype(*global)>);
    static_assert(asc::std::is_same_v<asc::std::iterator_traits<LocalPointer>::reference, decltype(*local)>);
    static_assert(asc::std::is_scalar_v<GlobalPointer> && asc::std::is_scalar_v<LocalPointer>);
    return asc_stl_binary_search_test::check_range(global, length, asc_stl_binary_search_test::Less{}) |
        asc_stl_binary_search_test::check_range(local, length, asc_stl_binary_search_test::Less{}) |
        asc_stl_binary_search_test::check_range(global, length, asc_stl_binary_search_test::Greater{}) |
        asc_stl_binary_search_test::check_range(local, length, asc_stl_binary_search_test::Greater{});
}
#endif
