#include <asc/std/__algorithm/ranges_find_if_not.h>

namespace {

struct EvenPred {
    CANN_ASC_STL_API constexpr bool operator()(int value) const noexcept
    {
        return value % 2 == 0;
    }
};

}  // namespace

__aicore__ int asc_stl_asc_std___algorithm_ranges_find_if_not()
{
    int data[4] = {2, 4, 5, 6};
    // Iterator + sentinel overload.
    const int* hit = asc::std::ranges::find_if_not(data, data + 4, EvenPred{});
    // Range overload.
    const int* ranged = asc::std::ranges::find_if_not(data, EvenPred{});
    return (hit == data + 2 && ranged == data + 2) ? 0 : 1;
}
