#include <asc/std/compare>

CANN_ASC_STL_API int compare_public_device_compile()
{
    bool result = asc::std::compare_strong_order_fallback(1, 2) == asc::std::strong_ordering::less;
    result = result && asc::std::compare_weak_order_fallback(1, 1) == asc::std::weak_ordering::equivalent;
    result = result && asc::std::compare_partial_order_fallback(2, 1) == asc::std::partial_ordering::greater;
    return result ? 0 : 1;
}
