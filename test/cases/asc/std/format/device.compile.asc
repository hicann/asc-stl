#include <asc/std/type_traits>
#include <asc/numeric>
#include <asc/std/charconv>
#include <asc/std/cuchar>
#include <asc/std/format>
#include <asc/std/version>

#if defined(__CCE__) && !defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__) && CANN_ASC_STL_DETAIL_HAS_CONSTEVAL()
using native_format = asc::std::basic_format_string<char, int>;
using expected_format_pointer = const __gm__ char*;
static_assert(asc::std::is_same_v<decltype(asc::std::declval<const native_format&>().data()), expected_format_pointer>);
#endif

CANN_ASC_STL_API int w11_format_device()
{
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
    static_assert(CANN_ASC_STL_DETAIL_HAS_CONSTEVAL());
    static_assert(CANN_ASC_STL_HAS_FORMAT);
    char output[24] = {};
    auto end = asc::std::format_to(output, "{:x}", 255);
#else
    static_assert(!CANN_ASC_STL_DETAIL_HAS_CONSTEVAL());
    static_assert(!CANN_ASC_STL_HAS_FORMAT);
#endif
    int result = 0;
    if (asc::add_overflow(1, 2, result) || result != 3)
        return -1;
    asc::std::mbstate_t state{};
    char encoded[2]{};
    char32_t decoded = U'\0';
    result += asc::std::c32rtomb(encoded, U'A', &state) == 1;
    result += asc::std::mbrtoc32(&decoded, encoded, 1, &state) == 1;
#if CANN_ASC_STL_DETAIL_HAS_CHAR8_T()
    char8_t decoded8 = u8'\0';
    result += asc::std::c8rtomb(encoded, u8'A', &state) == 1;
    result += asc::std::mbrtoc8(&decoded8, encoded, 1, &state) == 1;
#endif
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
    return static_cast<int>(end - output) + result;
#else
    return result;
#endif
}
