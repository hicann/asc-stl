#include <asc/numeric>
#include <asc/std/charconv>
#include <asc/std/cuchar>
#include <asc/std/format>
CANN_ASC_STL_API int w11_format_device()
{
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
    char output[24] = {};
    auto end = asc::std::format_to(output, "{:x}", 255);
#endif
    int result = 0;
    asc::add_overflow(1, 2, result);
    asc::std::mbstate_t state{};
    char encoded[2]{};
    char32_t decoded = U'\0';
    result += asc::std::c32rtomb(encoded, U'A', &state) == 1;
    result += asc::std::mbrtoc32(&decoded, encoded, 1, &state) == 1;
#if CANN_ASC_STL_DETAIL_HAS_CHAR8_T()
    char8_t decoded8 = u8'\0';
    result += asc::std::c8rtomb(encoded, u8'A', &state) == 1;
    result += asc::std::mbrtoc8(&decoded8, encoded, 1, &state) == 1;
#endif
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
    return static_cast<int>(end - output) + result;
#else
    return result;
#endif
}
