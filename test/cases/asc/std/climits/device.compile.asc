#include <asc/std/climits>

#include <asc/std/limits>

#define ASC_STL_TEST_SIGNED_LIMITS(prefix, T)                             \
    static_assert(prefix##_MIN == asc::std::numeric_limits<T>::lowest()); \
    static_assert(prefix##_MAX == asc::std::numeric_limits<T>::max())
ASC_STL_TEST_SIGNED_LIMITS(CHAR, char);
ASC_STL_TEST_SIGNED_LIMITS(SCHAR, signed char);
ASC_STL_TEST_SIGNED_LIMITS(SHRT, short);
ASC_STL_TEST_SIGNED_LIMITS(INT, int);
ASC_STL_TEST_SIGNED_LIMITS(LONG, long);
ASC_STL_TEST_SIGNED_LIMITS(LLONG, long long);
static_assert(CHAR_BIT == 8 && UCHAR_MAX == asc::std::numeric_limits<unsigned char>::max());
static_assert(USHRT_MAX == asc::std::numeric_limits<unsigned short>::max());
static_assert(UINT_MAX == asc::std::numeric_limits<unsigned int>::max());
static_assert(ULONG_MAX == asc::std::numeric_limits<unsigned long>::max());
static_assert(ULLONG_MAX == asc::std::numeric_limits<unsigned long long>::max());
#undef ASC_STL_TEST_SIGNED_LIMITS
