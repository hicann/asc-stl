#include <asc/std/__charconv/from_chars.h>
#include <cstdint>

CANN_ASC_STL_API int from_chars_device_compile()
{
    // D-SIMD and D-SIMT parse through local/generic plain char buffers.
    const char buffer[8] = {'4', '2', 'x', '0', '0', '0', '0', '0'};
    std::int32_t value = 0;
    const auto result = asc::std::from_chars(buffer, buffer + 2, value);
    bool ok = result.ptr == buffer + 2 && value == 42;
    std::int64_t wide = 0;
    ok = ok &&
        asc::std::from_chars(buffer, buffer + 2, wide, 16) ==
            asc::std::from_chars_result{buffer + 2, asc::std::errc{}} &&
        wide == 0x42;
    return ok ? 0 : 1;
}
