#include <asc/std/__iterator/reverse_iterator.h>

// Device-side syntax coverage for the reverse_iterator surface: construction,
// base roundtrip, make_reverse_iterator, reversed dereference/subscript,
// ++/--, the random-access family, cross-type difference, the comparison
// operators with reversed ordering, and iter_move/iter_swap through the
// customization points (acting on base-1).

__aicore__ int asc_stl_reverse_iterator_device()
{
    int buffer[8] = {0, 1, 2, 3, 4, 5, 6, 7};
    int* data = buffer;

    asc::std::reverse_iterator<int*> rbegin = asc::std::make_reverse_iterator(data + 8);
    asc::std::reverse_iterator<int*> rend = asc::std::make_reverse_iterator(data);

    int result = 0;
    result += *rbegin;              // 7: last element
    result += rbegin[2];            // 5: reversed subscript
    result += *(rbegin + 1);        // 6: operator+(n)
    result += *(1 + rbegin);        // 6: friend operator+(n, iter)
    result += *((rbegin + 4) - 1);  // 4: operator-(n)

    asc::std::reverse_iterator<int*> walker = rbegin;
    ++walker;           // moves toward the front
    result += *walker;  // 6
    --walker;
    result += *walker;                                             // 7
    result += static_cast<int>(walker == rbegin);                  // 1
    result += static_cast<int>(walker != rend);                    // 1
    result += static_cast<int>(rbegin < rend);                     // 1: reversed ordering
    result += static_cast<int>(rbegin <= rend && rend >= rbegin);  // 1

    walker += 5;
    result += *walker;  // 2
    walker -= 2;
    result += *walker;  // 4

    const int span = static_cast<int>(rend - rbegin);  // 8: reversed difference
    result += span == 8 ? 1 : 0;

    result += asc::std::iter_move(rbegin);  // 7: base-1 element
    asc::std::iter_swap(rbegin, walker);    // swaps base-1 elements
    result += buffer[7] + buffer[2];        // 4 + 2 after the swap

    // 7+5+6+6+4 +6+7 +1+1+1+1 +2+4 +1 +7 +6 == 65
    return result == 65 ? 0 : 1;
}
