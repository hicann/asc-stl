#include <asc/std/cfloat>

#include <asc/std/limits>

#define ASC_STL_TEST_FLOAT_LIMITS(prefix, T)                                           \
    static_assert(prefix##_MANT_DIG == asc::std::numeric_limits<T>::digits);           \
    static_assert(prefix##_DIG == asc::std::numeric_limits<T>::digits10);              \
    static_assert(prefix##_MIN_EXP == asc::std::numeric_limits<T>::min_exponent);      \
    static_assert(prefix##_MAX_EXP == asc::std::numeric_limits<T>::max_exponent);      \
    static_assert(prefix##_MIN_10_EXP == asc::std::numeric_limits<T>::min_exponent10); \
    static_assert(prefix##_MAX_10_EXP == asc::std::numeric_limits<T>::max_exponent10)
ASC_STL_TEST_FLOAT_LIMITS(FLT, float);
ASC_STL_TEST_FLOAT_LIMITS(DBL, double);
ASC_STL_TEST_FLOAT_LIMITS(LDBL, long double);
static_assert(FLT_RADIX == 2 && DECIMAL_DIG >= DBL_DIG);
#undef ASC_STL_TEST_FLOAT_LIMITS
