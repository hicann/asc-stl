#include <asc/std/type_traits>
#include <asc/std/latch>

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
static_assert(!asc::std::is_copy_constructible_v<asc::std::latch> && !asc::std::is_copy_assignable_v<asc::std::latch>);
#elif CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
static_assert(!asc::std::is_constructible_v<asc::std::latch, asc::std::ptrdiff_t>);
#endif

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ int asc_stl_b031_latch_compile(asc::std::latch* value)
{
    value->count_down();
    value->wait();
    return value->try_wait() ? 0 : 1;
}
#endif
