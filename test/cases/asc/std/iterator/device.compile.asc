#include <asc/std/iterator>
#include <asc/std/type_traits>
#include "../../../../support/b024_semantics.h"

static_assert(asc::std::is_base_of_v<asc::std::input_iterator_tag, asc::std::forward_iterator_tag>);
static_assert(asc::std::is_base_of_v<asc::std::forward_iterator_tag, asc::std::bidirectional_iterator_tag>);
static_assert(asc::std::is_base_of_v<asc::std::bidirectional_iterator_tag, asc::std::random_access_iterator_tag>);
static_assert(!asc::std::is_base_of_v<asc::std::output_iterator_tag, asc::std::input_iterator_tag>);

__aicore__ int asc_stl_b024_device_compile()
{
    return asc_stl_b024_test::evaluate();
}
