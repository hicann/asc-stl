// D-SIMD hardware kernel: the borrowed one/two-stage pipeline transfers 256
// elements GM->UB, transforms them and stores them back; every element must
// arrive incremented by seven through the caller-owned event protocol.
#include "launch.h"
#include <asc/pipeline>
#include <cstdint>

namespace {
constexpr std::uint32_t kElements = 256;
constexpr std::uint32_t kBytes = kElements * sizeof(std::uint32_t);
}  // namespace

extern "C" __global__ __vector__ void asc_stl_b024_simd_kernel(
    __gm__ std::uint32_t* output, __gm__ const std::uint32_t* input)
{
    __ubuf__ std::uint32_t stage0[kElements];
    auto pipeline = asc::make_pipeline(0u, 1u, 2u, 3u);
    for (std::uint32_t index = 248u; index < kElements; ++index)
        stage0[index] = 0x1357u;
    pipeline.producer_acquire(0u);
    asc::copy_async(
        pipeline, 0u, asc::ub_span<std::uint32_t>(stage0, kElements), asc::gm_span<const std::uint32_t>(input, 248u));
    pipeline.producer_commit(0u);
    pipeline.consumer_wait(0u);
    bool untouched_tail = true;
    for (std::uint32_t index = 248u; index < kElements; ++index) {
        untouched_tail = untouched_tail && stage0[index] == 0x1357u;
        stage0[index] = input[index];
    }
    for (std::uint32_t index = 0; index < kElements; ++index) {
        stage0[index] += 7u;
    }
    if (!untouched_tail)
        stage0[0] = 0xBAD1u;
    pipeline.consumer_release(0u);
    asc::copy_async(pipeline, 0u, asc::gm_span<std::uint32_t>(output, kElements),
        asc::ub_span<const std::uint32_t>(stage0, kElements));
    pipeline.wait();
    (void)kBytes;
}

void launch_asc_stl_b024_simd(std::uint32_t* output, const std::uint32_t* input, void* stream)
{
    asc_stl_b024_simd_kernel<<<1, nullptr, stream>>>(output, input);
}
