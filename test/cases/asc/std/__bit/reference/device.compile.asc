#include <asc/std/__bit/reference.h>
#include <cstddef>

namespace {

struct DeviceBits {
    using __storage_type = unsigned long;
    using __storage_pointer = __storage_type*;
    using __const_storage_pointer = const __storage_type*;
    using size_type = std::size_t;
    using difference_type = std::ptrdiff_t;
    using iterator = asc::std::__bit_iterator<DeviceBits, false>;
    using __self = DeviceBits;
    static const unsigned __bits_per_word = sizeof(__storage_type) * 8;
    __storage_type words[4];

    CANN_ASC_STL_API iterator begin()
    {
        return iterator(words, 0);
    }
    CANN_ASC_STL_API iterator end()
    {
        return iterator(words + 4, 0);
    }
};

}  // namespace

CANN_ASC_STL_API int bit_reference_device_compile()
{
    DeviceBits bits{{0, 0, 0, 0}};
    auto first = bits.begin();
    *first = true;
    bool ok = (bits.words[0] & 1u) != 0;
    asc::std::fill_n(first, 3, false);
    ok = ok && (bits.words[0] & 7u) == 0;
    auto second = first + 65;
    *second = true;
    ok = ok && (bits.words[1] & 2u) != 0;
    return ok ? 0 : 1;
}
