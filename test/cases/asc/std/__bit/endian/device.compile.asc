#include <asc/std/__bit/endian.h>
#include <cstdint>

CANN_ASC_STL_API int endian_device_compile()
{
    const bool little = asc::std::endian::native == asc::std::endian::little;
    const bool distinct = asc::std::endian::little != asc::std::endian::big;
    const std::uint32_t probe = 0x01020304u;
    const unsigned char* bytes = reinterpret_cast<const unsigned char*>(&probe);
    return little == (bytes[0] == 0x04u) && distinct ? 0 : 1;
}
