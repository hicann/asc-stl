#include <asc/std/__bit/rotate.h>
#include <climits>
#include <cstdint>

CANN_ASC_STL_API int rotate_device_compile()
{
    bool ok = asc::std::rotl(std::uint32_t{0x0000FFFFu}, 16) == 0xFFFF0000u;
    ok = ok && asc::std::rotr(std::uint64_t{0x00000000FFFFFFFFull}, 32) == 0xFFFFFFFF00000000ull;
    ok = ok && asc::std::rotl(std::uint8_t{0x1Eu}, 9) == 0x3Cu;
    ok = ok && asc::std::rotl(std::uint8_t{0x1Eu}, -1) == asc::std::rotr(std::uint8_t{0x1Eu}, 1);
    ok = ok && asc::std::rotr(std::uint32_t{0x0000FFFFu}, INT_MIN) == 0x0000FFFFu;
    return ok ? 0 : 1;
}
