#include <asc/std/__cwchar/algorithms.h>
#include <asc/std/__cwchar/fixed_c_locale.h>
#include <asc/std/__cwchar/types.h>

// Device compilation exercises the fixed-C-locale Device bodies directly.
// Wide inputs are built from character literals through brace
// initialization: address-space-qualified string literals cannot be passed
// to the standard plain-pointer signatures, which is the documented
// exclusion boundary rather than a defect.
CANN_ASC_STL_API int cwchar_device_compile()
{
    const wchar_t text[6] = {L'h', L'e', L'l', L'l', L'o', L'\0'};
    const wchar_t ordered[4] = {L'a', L'b', L'c', L'\0'};
    const wchar_t later[4] = {L'a', L'b', L'd', L'\0'};
    wchar_t buffer[8] = {};
    bool result = asc::std::wcslen(text) == 5;
    result = result && asc::std::wcscmp(ordered, later) < 0;
    result = result && asc::std::wcsncmp(ordered, later, 2) == 0;
    result = result && asc::std::wcscpy(buffer, ordered) == buffer && buffer[2] == L'c';
    result = result && asc::std::wmemcmp(ordered, later, 2) == 0;
    result = result && asc::std::wmemmove(buffer + 1, buffer, 3) == buffer + 1;
    result = result && asc::std::wcschr(ordered, L'b') != nullptr;
    result = result && asc::std::wcsrchr(ordered, L'c') != nullptr;
    result = result && asc::std::wcscoll(ordered, later) < 0;
    result = result && asc::std::btowc('x') == static_cast<asc::std::wint_t>(L'x');
    result = result && asc::std::btowc(-1) == WEOF;
    asc::std::mbstate_t conversion{};
    wchar_t wide = 0;
    const char narrow[2] = {'z', '\0'};
    result = result && asc::std::mbrtowc(&wide, narrow, 1, &conversion) == 1 && wide == L'z';
    result = result && asc::std::mbsinit(&conversion) != 0;
    return result ? 0 : 1;
}
