#include <asc/std/__cctype/classification.h>

CANN_ASC_STL_API int cctype_device_compile()
{
    // The fixed C locale classifies by range, so EOF stays false everywhere.
    bool ok = asc::std::isupper('Q') && !asc::std::isupper('q');
    ok = ok && asc::std::isdigit('7') && !asc::std::isdigit('x');
    ok = ok && !asc::std::iscntrl(-1) && !asc::std::isprint(-1);
    ok = ok && asc::std::tolower('Q') == 'q' && asc::std::toupper('q') == 'Q';
    ok = ok && asc::std::ispunct('!') && !asc::std::ispunct('9');
    return ok ? 0 : 1;
}
