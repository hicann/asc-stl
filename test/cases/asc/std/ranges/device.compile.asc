#include <asc/std/ranges>

#include "support/repeat_piecewise_semantics.h"
struct w12_times_two {
    CANN_ASC_STL_API int operator()(int value) const
    {
        return value * 2;
    }
};
CANN_ASC_STL_API int w12_ranges_device()
{
    if (asc_stl_repeat_piecewise_test::evaluate() != 0)
        return 101;
    int values[] = {1, 2, 3, 4};
    auto view = values | asc::std::ranges::views::drop(1) | asc::std::ranges::views::take(2);
    auto transformed = view | asc::std::ranges::views::transform(w12_times_two{});
    return *transformed.begin();
}
