#include <simt_api/device_sync_functions.h>

#include "support/w13_w14_semantics.h"
#include "launch.h"

extern "C" __global__ void asc_stl_w13_w14_utility_kernel(unsigned int* result)
{
    result[5] = asc_stl_w13_w14_test::evaluate_utility_cctype();
}

extern "C" __global__ void asc_stl_w13_w14_bit_kernel(unsigned int* result)
{
    result[6] = asc_stl_w13_w14_test::evaluate_bit();
}

extern "C" __global__ void asc_stl_w13_w14_types_kernel(unsigned int* result)
{
    result[8] = asc_stl_w13_w14_test::evaluate_types();
}

extern "C" __global__ void asc_stl_w13_w14_cwide_length_kernel(unsigned int* result)
{
    result[9] = asc_stl_w13_w14_test::evaluate_cwide_length();
}

extern "C" __global__ void asc_stl_w13_w14_cwide_search_kernel(unsigned int* result)
{
    wchar_t* word = reinterpret_cast<wchar_t*>(&result[20]);
    word[0] = L'a';
    word[1] = L's';
    word[2] = L'c';
    word[3] = L'\0';
    result[10] = asc_stl_w13_w14_test::evaluate_cwide_search(word);
    result[9] |= result[10];
    result[7] = result[8] + result[9];
    result[0] = result[5] + result[6] + result[7];
}

extern "C" __global__ void asc_stl_w13_w14_linalg_kernel(unsigned int* result)
{
    result[1] = asc_stl_w13_w14_test::evaluate_linalg();
}

extern "C" __global__ void asc_stl_w13_w14_random_kernel(unsigned int* result)
{
    result[2] = asc_stl_w13_w14_test::evaluate_random();
}

extern "C" __global__ void asc_stl_w13_w14_numeric_kernel(unsigned int* result)
{
    result[3] = asc_stl_w13_w14_test::evaluate_numeric();
}

extern "C" __global__ void asc_stl_w13_w14_sync_kernel(unsigned int* result)
{
    const unsigned int failures = asc_stl_w13_w14_test::evaluate_sync(result, 4);
    if (threadIdx.x == 0) {
        result[4] = failures;
    }
}

void launch_asc_stl_w13_w14(unsigned int* result, void* stream)
{
#if defined(ASC_STL_W13_W14_COMMON_ONLY)
    asc_stl_w13_w14_utility_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_bit_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_types_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_cwide_length_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_cwide_search_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_linalg_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_random_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_numeric_kernel<<<1, 1, 0, stream>>>(result);
#elif defined(ASC_STL_W13_W14_SYNC_ONLY)
    asc_stl_w13_w14_sync_kernel<<<1, 4, 0, stream>>>(result);
#else
    asc_stl_w13_w14_utility_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_bit_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_types_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_cwide_length_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_cwide_search_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_linalg_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_random_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_numeric_kernel<<<1, 1, 0, stream>>>(result);
    asc_stl_w13_w14_sync_kernel<<<1, 4, 0, stream>>>(result);
#endif
}

void launch_asc_stl_w13_w14_utility(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_utility_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_bit(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_bit_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_types(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_types_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_cwide_length(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_cwide_length_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_cwide_search(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_cwide_search_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_linalg(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_linalg_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_random(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_random_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_numeric(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_numeric_kernel<<<1, 1, 0, stream>>>(result);
}

void launch_asc_stl_w13_w14_sync(unsigned int* result, void* stream)
{
    asc_stl_w13_w14_sync_kernel<<<1, 4, 0, stream>>>(result);
}
