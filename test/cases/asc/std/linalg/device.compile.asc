#include "../../../../support/w13_w14_semantics.h"

CANN_ASC_STL_API unsigned int asc_stl_w13_w14_compile_semantics()
{
    return asc_stl_w13_w14_test::evaluate();
}

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
CANN_ASC_STL_SIMT_API void asc_stl_w13_w14_compile_sync(unsigned int* storage)
{
    auto& semaphore = *reinterpret_cast<asc::binary_semaphore<asc::memory_scope::block>*>(storage);
    auto& latch = *reinterpret_cast<asc::latch<asc::memory_scope::block>*>(storage + 8);
    auto& barrier = *reinterpret_cast<asc::barrier<asc::memory_scope::block>*>(storage + 16);
    semaphore.release();
    (void)semaphore.try_acquire();
    latch.count_down();
    (void)latch.try_wait();
    auto token = barrier.arrive();
    barrier.wait(static_cast<asc::barrier_arrival_token&&>(token));
}
#endif
