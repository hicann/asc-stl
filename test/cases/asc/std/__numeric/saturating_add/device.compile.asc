#include <asc/std/__numeric/saturating_add.h>
#include <asc/std/__numeric/saturating_sub.h>
#include <cstdint>

CANN_ASC_STL_API int saturating_device_compile()
{
    const std::int64_t maximum = static_cast<std::int64_t>(0x7FFFFFFFFFFFFFFFll);
    const std::int64_t minimum = static_cast<std::int64_t>(0x8000000000000000ll);
    bool ok = asc::std::saturating_add(maximum, std::int64_t{1}) == maximum;
    ok = ok && asc::std::saturating_sub(minimum, std::int64_t{1}) == minimum;
    ok = ok && asc::std::saturating_add(std::uint32_t{0xFFFFFFFFu}, std::uint32_t{1}) == std::uint32_t{0xFFFFFFFFu};
    ok = ok && asc::std::saturating_sub(std::uint32_t{0}, std::uint32_t{1}) == std::uint32_t{0};
    return ok ? 0 : 1;
}
