#include <asc/std/__numeric/accumulate.h>
#include <asc/std/__numeric/exclusive_scan.h>
#include <asc/std/__numeric/inner_product.h>

CANN_ASC_STL_API int numeric_device_compile()
{
    const int data[5]{1, 2, 3, 4, 5};
    int scanned[5]{};
    const int* end = asc::std::exclusive_scan(data, data + 5, scanned, 10);
    return asc::std::accumulate(data, data + 5, 0) == 15 && asc::std::inner_product(data, data + 5, data, 0) == 55 &&
            end == scanned + 5 && scanned[4] == 20 ?
        0 :
        1;
}
