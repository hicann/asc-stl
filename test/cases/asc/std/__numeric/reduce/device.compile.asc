#include <asc/std/__numeric/adjacent_difference.h>
#include <asc/std/__numeric/device_policy.h>
#include <asc/std/__numeric/inclusive_scan.h>
#include <asc/std/__numeric/partial_sum.h>
#include <asc/std/__numeric/reduce.h>
#include <asc/std/__numeric/transform_inclusive_scan.h>
#include <asc/std/__numeric/transform_reduce.h>

CANN_ASC_STL_API int numeric_reduce_device_compile()
{
    const int data[5]{1, 2, 3, 4, 5};
    int output[5]{};
    bool ok = asc::std::reduce(data, data + 5, 0) == 15;
    ok = ok && asc::std::transform_reduce(data, data + 5, data, 0) == 55;
    ok = ok && asc::std::inclusive_scan(data, data + 5, output) == output + 5 && output[4] == 15;
    ok = ok &&
        asc::std::transform_inclusive_scan(
            data, data + 3, output, [](int total, int value) { return total + value; },
            [](int value) { return value * 2; }) == output + 3;
    ok = ok && output[2] == 12;
    ok = ok && asc::std::partial_sum(data, data + 4, output) == output + 4 && output[3] == 10;
    ok = ok && asc::std::adjacent_difference(data, data + 4, output) == output + 4 && output[3] == 1;
    return ok ? 0 : 1;
}
