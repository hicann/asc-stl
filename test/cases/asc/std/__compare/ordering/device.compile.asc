#include "../../compare/support/comparison_helpers_semantics.h"

#if CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
CANN_ASC_STL_API unsigned int comparison_helpers_device_compile(__gm__ const unsigned int* input)
#else
CANN_ASC_STL_API unsigned int comparison_helpers_device_compile(const unsigned int* input)
#endif
{
    const auto result = asc_stl_comparison_helpers_test::evaluate(input);
    return result.failures + (result.signature != 358) + (result.checks != 66);
}
