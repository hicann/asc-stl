#include <asc/std/__compare/compare_fallback.h>
#include <asc/std/__compare/compare_three_way.h>

#if CANN_ASC_STL_DETAIL_HAS_CXX20()
namespace {
struct VocabularyOrdered {
    int value;
    CANN_ASC_STL_API asc::std::strong_ordering operator<=>(const VocabularyOrdered& other) const
    {
        return value < other.value ? asc::std::strong_ordering::less :
            value > other.value    ? asc::std::strong_ordering::greater :
                                     asc::std::strong_ordering::equal;
    }
};
}  // namespace
#endif

CANN_ASC_STL_API int compare_device_compile()
{
    bool result = asc::std::compare_strong_order_fallback(1, 2) == asc::std::strong_ordering::less;
    result = result && asc::std::compare_partial_order_fallback(1, 1) == asc::std::partial_ordering::equivalent;
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
    const VocabularyOrdered low{1};
    const VocabularyOrdered high{2};
    result = result && asc::std::compare_three_way{}(low, high) == asc::std::strong_ordering::less;
#endif
    return result ? 0 : 1;
}
