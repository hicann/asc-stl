#include <acl/acl.h>
#include "../semantics.h"
#include "launch.h"
extern "C" __global__ __vector__ void asc_stl_foundation_simd(__gm__ asc::std::uint32_t* output)
{
    asc::std::uint32_t local[44] = {};
    asc_stl_foundation_runtime::evaluate(local);
    for (int index = 0; index < 44; ++index)
        output[index] = local[index];
}
void launch_asc_stl_foundation_simd(asc::std::uint32_t* output, aclrtStream stream)
{
    asc_stl_foundation_simd<<<1, 0, stream>>>(output);
}
