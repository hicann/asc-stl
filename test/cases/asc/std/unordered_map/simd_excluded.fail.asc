#include <asc/std/unordered_map>
#include "../../../../support/b028_allocator.h"
struct H {
    CANN_ASC_STL_API unsigned long operator()(int x) const
    {
        return x;
    }
};
struct E {
    CANN_ASC_STL_API bool operator()(int a, int b) const
    {
        return a == b;
    }
};
using P = asc::std::__arena_pair<const int, int>;
using A = asc_stl_b028_test::arena_allocator<P>;
__aicore__ void rejected()
{
    unsigned char storage[512]{};
    asc_stl_b028_test::arena_state state{storage, sizeof(storage), 0, 0, 0};
    asc::std::unordered_map<int, int, H, E, A> value{A(&state)};
    (void)value;
}
