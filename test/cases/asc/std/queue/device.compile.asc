#include <asc/std/queue>

#include "../../../../support/b027_semantics.h"

__aicore__ int queue_deduction_guide_compile()
{
    using sequence = asc_stl_b027_test::fixed_sequence<int, 8>;
    sequence storage{};
    asc::std::queue queue(storage);
    asc::std::priority_queue priority(asc_stl_b027_test::less_int{}, storage);
    struct allocator_marker {
    } allocator;
    asc::std::queue queue_with_allocator(storage, allocator);
    asc::std::priority_queue priority_with_allocator(asc_stl_b027_test::less_int{}, storage, allocator);
    return queue.empty() && priority.empty() && queue_with_allocator.empty() && priority_with_allocator.empty() ? 0 : 1;
}
