#include <asc/std/exception>

#if defined(ASC_STL_TEST_TERMINATION_REFERENCE)
#include "../../exception/termination_reference.h"
#endif

static_assert(noexcept(asc::std::terminate()));

// Force the backend to compile the terminating instruction in both device modes.
#if CANN_ASC_STL_USE_SIMT_LAUNCH
__global__ void terminate_device_compile()
#else
extern "C" __global__ __vector__ void terminate_device_compile()
#endif
{
#if defined(ASC_STL_TEST_TERMINATION_REFERENCE)
    asc_stl_test_exception::reference_terminate();
#else
    asc::std::terminate();
#endif
}
