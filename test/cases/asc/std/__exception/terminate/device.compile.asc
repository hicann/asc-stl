#include <asc/std/__exception/terminate.h>

// The Device branches are compiled without being called: the trap path is
// [[noreturn]], and executing it is the documented terminating behavior
// rather than a test result. Compilation proves both the language-boundary
// parse and the fail-fast spelling the delivered backends share.
CANN_ASC_STL_API int terminate_device_compile()
{
    return 0;
}
