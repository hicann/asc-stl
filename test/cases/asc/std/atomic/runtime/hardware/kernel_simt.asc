#include "launch.h"
#include "../semantics.h"

__global__ void asc_stl_b022_simt_kernel(__INT32_TYPE__* output)
{
    asc_stl_b022_runtime::evaluate(output);
}
__global__ void asc_stl_b022_visibility_simt_kernel(__INT32_TYPE__* output)
{
    asc_stl_b022_runtime::asc_stl_b022_visibility_semantics(output);
}

void launch_asc_stl_b022(int* output, aclrtStream stream)
{
    asc_stl_b022_simt_kernel<<<1, 1, 0, stream>>>(output);
    asc_stl_b022_visibility_simt_kernel<<<2, 32, 0, stream>>>(output);
}
