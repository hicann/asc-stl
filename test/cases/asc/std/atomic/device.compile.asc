#include <asc/std/atomic>
#include <asc/std/type_traits>
#include "../../../../support/b022_semantics.h"

#if CANN_ASC_STL_DETAIL_DEVICE_COMPILATION() && !CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
static_assert(!asc::std::is_default_constructible_v<asc::std::atomic<int>>);
static_assert(!asc::std::is_constructible_v<asc::std::atomic<int>, int>);
static_assert(!asc::std::is_default_constructible_v<asc::std::atomic_flag>);
static_assert(!asc::std::is_constructible_v<asc::std::atomic_ref<int>, int&>);
#endif

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
__aicore__ int asc_stl_b022_device_compile(__INT32_TYPE__* address)
{
    // Ascend SIMT atomics operate on GlobalMemory storage only, so the Device
    // contract is instantiated through the caller-owned pointer.
    asc_stl_b022_test::evaluate_device_atomic(address);
    return asc_stl_b022_test::evaluate_all();
}
#else
__aicore__ int asc_stl_b022_device_compile()
{
    return asc_stl_b022_test::evaluate_all();
}
#endif
