#include <asc/std/__type_traits/alignment_of.h>

CANN_ASC_STL_API int alignment_of_device_compile()
{
    return asc::std::alignment_of_v<int> == alignof(int) && asc::std::alignment_of<char>::value == 1 ? 0 : 1;
}
