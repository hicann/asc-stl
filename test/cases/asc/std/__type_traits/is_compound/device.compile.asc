#include <asc/std/__type_traits/is_compound.h>
#include "../../type_traits/compiler_traits.h"

namespace {
struct DeviceBits {
    int value;
};
}  // namespace

CANN_ASC_STL_API int is_compound_device_compile()
{
    static_assert(!asc::std::is_compound_v<int>);
    static_assert(asc::std::is_compound_v<DeviceBits>);
    return asc::std::is_compound_v<long long> ? 1 : 0;
}
