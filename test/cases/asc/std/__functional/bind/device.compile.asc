#include <asc/std/__functional/bind.h>

CANN_ASC_STL_API int bind_device_compile()
{
    using asc::std::placeholders::_1;
    using asc::std::placeholders::_2;
    auto combine = asc::std::bind([](int left, int right) { return left * 10 + right; }, _1, _2);
    auto shifted = asc::std::bind<int>([](short value) { return value + 5; }, _1);
    return combine(4, 2) == 42 && shifted(37) == 42 ? 0 : 1;
}
