#include <asc/std/__cwctype/classification.h>
#include <asc/std/__cwctype/descriptors.h>

CANN_ASC_STL_API int cwctype_device_compile()
{
    // The fixed C locale wide classification and the twelve descriptors.
    const asc::std::wint_t weof = static_cast<asc::std::wint_t>(-1);
    bool ok = asc::std::iswalpha(L'Q') && !asc::std::iswalpha(L'1');
    ok = ok && !asc::std::iswprint(weof) && !asc::std::iswcntrl(weof);
    ok = ok && asc::std::towlower(L'Q') == L'q' && asc::std::towupper(L'q') == L'Q';
    const char alpha_name[6] = {'a', 'l', 'p', 'h', 'a', '\0'};
    const char unknown_name[5] = {'n', 'o', 'p', 'e', '\0'};
    const asc::std::wctype_t alpha = asc::std::wctype(alpha_name);
    ok = ok && alpha != asc::std::wctype_t(0) && asc::std::iswctype(L'Q', alpha) != 0;
    ok = ok && asc::std::iswctype(L'1', alpha) == 0;
    ok = ok && asc::std::wctype(nullptr) == asc::std::wctype_t(0);
    ok = ok && asc::std::wctype(unknown_name) == asc::std::wctype_t(0);
    ok = ok && asc::std::iswctype(L'a', 99) == 0;
    const char tolower_name[8] = {'t', 'o', 'l', 'o', 'w', 'e', 'r', '\0'};
    const asc::std::wctrans_t lower = asc::std::wctrans(tolower_name);
    ok = ok && lower != asc::std::wctrans_t(0) && asc::std::towctrans(L'Q', lower) == L'q';
    ok = ok && asc::std::wctrans(nullptr) == asc::std::wctrans_t(0);
    ok = ok && asc::std::towctrans(L'x', 7) == L'x';
    return ok ? 0 : 1;
}
