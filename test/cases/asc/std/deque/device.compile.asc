#include <asc/memory>
#include <asc/std/deque>

__aicore__ int asc_stl_b032_deque_compile(unsigned char* storage)
{
    asc::monotonic_arena arena(storage, 2048);
    asc::std::deque<int, asc::arena_allocator<int>> values{asc::arena_allocator<int>(arena)};
    values.push_back(3);
    values.push_front(2);
    return values.front() + values.back();
}
