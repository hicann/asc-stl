#include "launch.h"
#include "../semantics.h"

extern "C" __global__ __vector__ void asc_stl_w08_simd_kernel(
    __gm__ unsigned int* result, __gm__ const unsigned int* input)
{
    asc_stl_w08_runtime::evaluate_simd(result, input);
}

void launch_asc_stl_w08_simd(unsigned int* result, const unsigned int* input, void* stream)
{
    asc_stl_w08_simd_kernel<<<1, nullptr, stream>>>(result, input);
}
