// Pure-SIMT hardware kernel: the integer tools plus the real linked float
// sincos through the designated standard float-math backend.
#include <cstdint>

#include <asc/cmath>

extern "C" __global__ void asc_stl_b026_cmath_simt_kernel(std::uint32_t* result)
{
    std::uint32_t failures = 0;
    failures +=
        asc::ceil_div(std::uint64_t{0xFFFFFFFFFFFFFFF5ull}, std::uint64_t{10}) != std::uint64_t{0x1999999999999999ull};
    failures += asc::floor_div(std::int64_t{-7}, std::int64_t{3}) != std::int64_t{-3};
    failures += asc::round_up(std::uint32_t{7}, std::uint32_t{3}) != std::uint32_t{9};
    failures += asc::integer_log2(std::uint64_t{1ull << 63}) != 63;
    failures += asc::integer_sqrt(std::uint64_t{24}) != 4;
    failures += asc::integer_pow(std::int64_t{2}, 10) != 1024;
    failures += asc::integer_pow<int>(50000, 1) != 50000;
    failures += asc::mul_hi(std::uint32_t{0xFFFFFFFFu}, std::uint32_t{0xFFFFFFFFu}) != std::uint32_t{0xFFFFFFFEu};
    float sine = -1.0f;
    float cosine = -1.0f;
    asc::sincos(0.0f, &sine, &cosine);
    failures += sine != 0.0f || cosine != 1.0f;
    asc::sincos(1.5707963f, &sine, &cosine);
    failures += !(sine > 0.999f && sine < 1.001f) || !(cosine > -0.001f && cosine < 0.001f);
    result[0] = failures;
}

void launch_asc_stl_b026_cmath_simt(std::uint32_t* result, void* stream)
{
    asc_stl_b026_cmath_simt_kernel<<<1, 1, 0, stream>>>(result);
}
