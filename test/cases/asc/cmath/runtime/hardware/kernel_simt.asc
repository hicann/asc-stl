#include "launch.h"
#include "../../../../../support/cmath_contracts.h"

extern "C" __global__ void asc_stl_b026_cmath_simt_kernel(float* result, const unsigned long long* inputs)
{
    result[0] = static_cast<float>(asc_stl_cmath_test::evaluate(inputs[0], -static_cast<long long>(inputs[1])));
    result[1] = 0.0F;
    result[2] = 0.0F;
}

void launch_asc_stl_b026_cmath_simt(
    float* result, const unsigned long long* inputs, const float* trig, unsigned count, void* stream)
{
    asc_stl_b026_cmath_simt_kernel<<<1, 1, 0, stream>>>(result, inputs);
    if (count != 0)
        launch_asc_stl_cmath_trig(result, trig, count, stream);
}

// Pure SIMT emits one executable registration per translation unit.
#include "kernel_simt_trig.asc"
