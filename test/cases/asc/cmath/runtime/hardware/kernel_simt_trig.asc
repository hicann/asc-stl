#include <asc/cmath>
#include "simt_api/device_functions.h"
#include "launch.h"

extern "C" __global__ void asc_stl_cmath_trig_kernel(float* result, const float* trig, unsigned count)
{
    const unsigned i = threadIdx.x;
    if (i >= count)
        return;
    int failures = 0;
    float* cell = result + 3 * (i + 1);
    cell[1] = 0.0F;
    cell[2] = 0.0F;
    if (i < count) {
        const float angle = trig[3 * i];
        float sine = 0.0F;
        float cosine = 0.0F;
        asc::sincos(angle, &sine, &cosine);
        asc::sincos(angle, cell + 1, cell + 2);
        if (__builtin_isnan(angle) || __builtin_isinf(angle)) {
            failures += !__builtin_isnan(sine) || !__builtin_isnan(cosine);
            failures += !__builtin_isnan(cell[1]) || !__builtin_isnan(cell[2]);
        } else {
            failures += !(__builtin_fabsf(sine - trig[3 * i + 1]) <= 2.0e-6F);
            failures += !(__builtin_fabsf(cosine - trig[3 * i + 2]) <= 2.0e-6F);
            failures += cell[1] != sine || cell[2] != cosine;
            if (angle == 0.0F) {
                failures += __builtin_signbit(sine) != __builtin_signbit(angle) || cosine != 1.0F;
                failures += __builtin_signbit(cell[1]) != __builtin_signbit(angle);
            }
        }
    }
    cell[0] = static_cast<float>(failures);
}

void launch_asc_stl_cmath_trig(float* result, const float* trig, unsigned count, void* stream)
{
    asc_stl_cmath_trig_kernel<<<1, 32, 0, stream>>>(result, trig, count);
}
