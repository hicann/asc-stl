#include <asc/cmath>
#include <cstdint>

CANN_ASC_STL_API int cmath_device_compile()
{
    const std::uint64_t a = 0xFFFFFFFFFFFFFFF5ull;
    const std::int64_t negative = -7;
    int ok = asc::ceil_div(a, std::uint64_t{10}) == std::uint64_t{0x1999999999999999ull};
    ok = ok && asc::floor_div(negative, std::int64_t{3}) == std::int64_t{-3};
    ok = ok && asc::round_up(std::uint32_t{7}, std::uint32_t{3}) == std::uint32_t{9};
    ok = ok && asc::integer_log2(std::uint64_t{1ull << 63}) == 63;
    ok = ok && asc::integer_sqrt(std::uint64_t{24}) == 4;
    ok = ok && asc::integer_pow(std::int64_t{2}, 10) == 1024;
    ok = ok && asc::integer_pow<int>(50000, 1) == 50000;
    ok = ok && asc::mul_hi(std::uint32_t{0xFFFFFFFFu}, std::uint32_t{0xFFFFFFFFu}) == std::uint32_t{0xFFFFFFFEu};
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
    // In pure SIMT the float sincos form dispatches through the CANN global
    // entrypoints; no double form exists in device compilation.
    float sine = 0.0f;
    float cosine = 0.0f;
    asc::sincos(0.0f, &sine, &cosine);
    ok = ok && sine == 0.0f && cosine == 1.0f;
#else
    // Ordinary AICore keeps the integer tools; the scalar trigonometric
    // forms are compiled out entirely.
#endif
    return ok ? 0 : 1;
}
