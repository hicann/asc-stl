#include "semantics.h"

extern "C" __global__ void numeric_types_simt_kernel(
    unsigned* output, const unsigned* records, unsigned count, numeric_parameters p)
{
    const unsigned lane = threadIdx.x;
    for (unsigned index = lane; index < count; index += numeric_lanes) {
        const unsigned offset = index * 5;
        output[index] = numeric_types_runtime::evaluate(
            records[offset], records[offset + 2], records[offset + 1], records[offset + 3]);
    }
    output[numeric_invariant_base(count) + lane * numeric_cache_words] = numeric_types_runtime::invariants(p, lane);
}

asc::float16 numeric_types_host_prepare(float input)
{
    return asc::numeric_convert<asc::float16>(input);
}

void launch_numeric_types(
    std::uint32_t* output, const std::uint32_t* records, unsigned count, numeric_parameters parameters, void* stream)
{
    numeric_types_simt_kernel<<<1, numeric_lanes, 0, stream>>>(output, records, count, parameters);
}
