#include <asc/numeric_types>

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
template <class T>
CANN_ASC_STL_DEVICE_API unsigned storage_copy(T* values)
{
    const auto value = values[0];
    values[1] = value;
    return asc::to_bits(values[1]);
}
#else
template <class T>
CANN_ASC_STL_DEVICE_API unsigned storage_copy(__gm__ T* values)
{
    T value;
    __builtin_memcpy(&value, values, sizeof(T));
    __builtin_memcpy(values + 1, &value, sizeof(T));
    __ubuf__ T* ub = reinterpret_cast<__ubuf__ T*>(0);
    __builtin_memcpy(ub, &value, sizeof(T));
    T loaded;
    __builtin_memcpy(&loaded, ub, sizeof(T));
    return asc::to_bits(loaded);
}
#endif

CANN_ASC_STL_DEVICE_API unsigned numeric_types_storage_compile(
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
    void* storage)
#else
    __gm__ void* storage)
#endif
{
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
#define NUMERIC_STORAGE(T) storage_copy(static_cast<T*>(storage))
#else
#define NUMERIC_STORAGE(T) storage_copy(static_cast<__gm__ T*>(storage))
#endif
    return NUMERIC_STORAGE(asc::float16) + NUMERIC_STORAGE(asc::bfloat16) + NUMERIC_STORAGE(asc::float8_e4m3fn) +
        NUMERIC_STORAGE(asc::float8_e5m2) + NUMERIC_STORAGE(asc::float8_e8m0) + NUMERIC_STORAGE(asc::hifloat8) +
        NUMERIC_STORAGE(asc::float4_e2m1x2) + NUMERIC_STORAGE(asc::float4_e1m2x2) + NUMERIC_STORAGE(asc::int4x2) +
        NUMERIC_STORAGE(asc::int4);
#undef NUMERIC_STORAGE
}
