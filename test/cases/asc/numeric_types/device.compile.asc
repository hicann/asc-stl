#include "../../../support/numeric_types_semantics.h"

CANN_ASC_STL_API unsigned numeric_types_compile(float input)
{
    auto x = asc::numeric_convert<asc::float16>(input);
    auto bf = asc::numeric_convert<asc::bfloat16>(input);
    auto fp8 = asc::numeric_convert<asc::float8_e4m3fn>(input);
    auto fp8b = asc::numeric_convert<asc::float8_e5m2>(input);
    unsigned result = numeric_types_test::representations() + numeric_types_test::native_representations();
    result += numeric_types_test::integers<asc::rounding_mode::nearest_even>();
    result += asc::numeric_convert<float>(x) != asc::numeric_convert<float>(bf);
    result += asc::numeric_convert<float>(fp8) != asc::numeric_convert<float>(fp8b);
    return result;
}

__host__ unsigned numeric_types_host_compile(float input)
{
    return asc::to_bits(asc::numeric_convert<asc::float16>(input)) + asc::to_bits(asc::from_bits<asc::int4>(3));
}
