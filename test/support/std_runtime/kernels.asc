#include <asc/std/type_traits>
#include "check_headers.inc"
#include "launch.h"

#if defined(ASC_STL_TEST_PARTITION_BITSET) || defined(ASC_STL_TEST_PARTITION_CMATH) || \
    defined(ASC_STL_TEST_PARTITION_RANDOM)
#include <simt_api/device_warp_functions.h>

inline constexpr unsigned check_lanes = 32;

CANN_ASC_STL_API void write_partition_status(int* output, int local_status)
{
    const int status = asc_reduce_max(local_status);
    if (threadIdx.x == 0)
        *output = status;
}
#else
inline constexpr unsigned check_lanes = 1;
#endif

template <auto Check>
CANN_ASC_STL_API CANN_ASC_STL_DETAIL_NO_INLINE int run_check(int seed, void* workspace)
{
    if constexpr (asc::std::is_same_v<decltype(Check), int (*)(int, void*)>)
        return Check(seed, workspace);
    else if constexpr (asc::std::is_same_v<decltype(Check), int (*)(int)>)
        return Check(seed);
    else
        return Check();
}

enum class header_id : unsigned {
#define ASC_STL_REGISTER_CHECK(header) item_##header,
#include "checks.inc"
#undef ASC_STL_REGISTER_CHECK
    count
};

__global__ void check_headers(int* output, unsigned char* workspace, unsigned first, int seed)
{
    const unsigned index = first + blockIdx.x;
#ifdef ASC_STL_TEST_PARTITION_BITSET
    if (index == static_cast<unsigned>(header_id::item_bitset)) {
        // Each lane tests every output bit for a disjoint set of shift counts.
        const int local_status = asc_stl_test_bitset::check_partition(seed, threadIdx.x, blockDim.x);
        write_partition_status(output + index, local_status);
        return;
    }
#endif
#ifdef ASC_STL_TEST_PARTITION_CMATH
    if (index == static_cast<unsigned>(header_id::item_cmath)) {
        const int status =
            asc_stl_test_cmath::check_partition(seed, workspace + index * workspace_stride, threadIdx.x, blockDim.x);
        write_partition_status(output + index, status);
        return;
    }
#endif
#ifdef ASC_STL_TEST_PARTITION_RANDOM
    if (index == static_cast<unsigned>(header_id::item_random)) {
        using slot = asc_stl_test_random::engine_workspace;
        static_assert(workspace_stride % alignof(slot) == 0);
        static_assert(check_lanes * sizeof(slot) <= workspace_stride);
        const int status =
            asc_stl_test_random::check_partition(seed, workspace + index * workspace_stride, threadIdx.x, blockDim.x);
        write_partition_status(output + index, status);
        return;
    }
#endif
    if (check_lanes > 1 && threadIdx.x != 0)
        return;
    switch (static_cast<header_id>(index)) {
#define ASC_STL_REGISTER_CHECK(header)                                                                       \
    case header_id::item_##header:                                                                           \
        output[index] = run_check<asc_stl_test_##header::check>(seed, workspace + index * workspace_stride); \
        break;
#include "checks.inc"
#undef ASC_STL_REGISTER_CHECK
        default:
            break;
    }
}

void launch_checks(int* output, unsigned char* workspace, unsigned first, unsigned count, int seed, void* stream)
{
    check_headers<<<count, check_lanes, 0, stream>>>(output, workspace, first, seed);
}
