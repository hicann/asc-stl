#ifndef CANN_ASC_STL_ASC_NUMERIC
#define CANN_ASC_STL_ASC_NUMERIC

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__numeric/checked.h>

namespace asc {

namespace detail {
template <class T>
struct public_numeric_integer {
    static constexpr bool value = false;
};
#define CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(Type) \
    template <>                                          \
    struct public_numeric_integer<Type> {                \
        static constexpr bool value = true;              \
    };
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(signed char)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(unsigned char)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(short)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(unsigned short)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(int)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(unsigned int)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(long)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(unsigned long)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(long long)
CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER(unsigned long long)
#undef CANN_ASC_STL_DETAIL_PUBLIC_NUMERIC_INTEGER
}  // namespace detail

template <class T>
struct overflow_result {
    static_assert(detail::public_numeric_integer<T>::value, "ASC-STL checked numeric requires a standard integer type");
    T value;
    bool overflow;
};

template <class T>
CANN_ASC_STL_API constexpr overflow_result<T> add_overflow(T left, T right) noexcept
{
    static_assert(detail::public_numeric_integer<T>::value, "ASC-STL checked numeric requires a standard integer type");
    const auto result = detail::add_overflow_impl(left, right);
    return {result.value, result.overflow};
}
template <class T>
CANN_ASC_STL_API constexpr bool add_overflow(T left, T right, T& output) noexcept
{
    const auto result = ::asc::add_overflow(left, right);
    output = result.value;
    return result.overflow;
}

