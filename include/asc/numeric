template <class To, class From>
CANN_ASC_STL_API constexpr overflow_result<To> overflow_cast(From value) noexcept
{
    static_assert(detail::public_numeric_integer<To>::value && detail::public_numeric_integer<From>::value,
        "ASC-STL checked numeric requires standard integer source and destination types");
    const To converted = static_cast<To>(value);
    const bool sign_changed = (value < From{0}) != (converted < To{0});
    const bool changed = static_cast<From>(converted) != value;
    return {converted, sign_changed || changed};
}

template <class To, class From>
CANN_ASC_STL_API constexpr To saturating_overflow_cast(From value) noexcept
{
    static_assert(detail::public_numeric_integer<To>::value && detail::public_numeric_integer<From>::value,
        "ASC-STL checked numeric requires standard integer source and destination types");
    const auto result = ::asc::overflow_cast<To>(value);
    if (!result.overflow) {
        return result.value;
    }
    return value < From{0} ? detail::checked_minimum<To>() : detail::checked_maximum<To>();
}

template <class To, class From>
CANN_ASC_STL_API constexpr To narrow_cast(From value)
{
    static_assert(detail::public_numeric_integer<To>::value && detail::public_numeric_integer<From>::value,
        "ASC-STL checked numeric requires standard integer source and destination types");
    return static_cast<To>(value);
}

template <class To, class From>
CANN_ASC_STL_API constexpr To narrow(From value)
{
    static_assert(detail::public_numeric_integer<To>::value && detail::public_numeric_integer<From>::value,
        "ASC-STL checked numeric requires standard integer source and destination types");
    const auto result = ::asc::overflow_cast<To>(value);
    if (result.overflow) {
        __builtin_trap();
    }
    return result.value;
}

