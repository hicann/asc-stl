// Directed quotients. The divisor is nonzero and the final T is representable.
template <class T, detail::cmath_integer_t<T> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T ceil_div(T a, T b) noexcept
{
    detail::cmath_division_domain(a, b);
    auto quotient = a / b;
    const auto remainder = a % b;
    if constexpr (::asc::std::is_signed_v<T>) {
        if (remainder != 0 && ((a < 0) == (b < 0)))
            ++quotient;
    } else if (remainder != 0) {
        ++quotient;
    }
    return static_cast<T>(quotient);
}

template <class T, detail::cmath_integer_t<T> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T floor_div(T a, T b) noexcept
{
    detail::cmath_division_domain(a, b);
    auto quotient = a / b;
    const auto remainder = a % b;
    if constexpr (::asc::std::is_signed_v<T>) {
        if (remainder != 0 && ((a < 0) != (b < 0)))
            --quotient;
    }
    return static_cast<T>(quotient);
}

// Any positive multiple is accepted; only the final result must fit T.
template <class T, detail::cmath_integer_t<T> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T round_up(T a, T b) noexcept
{
    detail::cmath_require(a >= T{0} && b > T{0});
    const T remainder = static_cast<T>(a % b);
    if (remainder == 0)
        return a;
    const T delta = static_cast<T>(b - remainder);
    detail::cmath_require(a <= ::asc::std::numeric_limits<T>::max() - delta);
    return static_cast<T>(a + delta);
}

template <class T, class E, detail::cmath_integer_t<T> = 0, detail::cmath_integer_t<E> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T integer_pow(T base, E exponent) noexcept
{
    if constexpr (::asc::std::is_signed_v<E>)
        detail::cmath_require(exponent >= E{0});
    using U = ::asc::std::make_unsigned_t<E>;
    U remaining = static_cast<U>(exponent);
    T result{1};
    while (remaining != 0) {
        if ((remaining & U{1}) != 0)
            result = detail::cmath_product(result, base);
        remaining = static_cast<U>(remaining >> 1);
        // No unused square after the final exponent bit (including min(T)^1).
        if (remaining != 0)
            base = detail::cmath_product(base, base);
    }
    return result;
}

template <class T, detail::cmath_integer_t<T> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T integer_sqrt(T value) noexcept
{
    detail::cmath_require(value >= T{0});
    using U = ::asc::std::make_unsigned_t<T>;
    U rest = static_cast<U>(value);
    U root{0};
    constexpr int highest_even = (::asc::std::numeric_limits<U>::digits - 1) & ~1;
    U bit = static_cast<U>(U{1} << highest_even);
    while (bit > rest)
        bit = static_cast<U>(bit >> 2);
    // Restoring square root: all arithmetic stays in the original unsigned width.
    while (bit != 0) {
        if (rest >= root + bit) {
            rest = static_cast<U>(rest - root - bit);
            root = static_cast<U>((root >> 1) + bit);
        } else {
            root = static_cast<U>(root >> 1);
        }
        bit = static_cast<U>(bit >> 2);
    }
    return static_cast<T>(root);
}

template <class T, ::asc::std::enable_if_t<detail::cmath_integer_v<T>&& ::asc::std::is_unsigned_v<T>, int> = 0>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr T mul_hi(T left, T right) noexcept
{
    using U = unsigned long long;
    constexpr int width = ::asc::std::numeric_limits<T>::digits;
    const U a = left;
    const U b = right;
    if constexpr (width <= 32) {
        return static_cast<T>((a * b) >> width);
    } else {
        constexpr int half = width / 2;
        constexpr U mask = (U{1} << half) - 1;
        const U low = (a & mask) * (b & mask);
        const U cross1 = (a & mask) * (b >> half);
        const U cross2 = (a >> half) * (b & mask);
        const U high = (a >> half) * (b >> half);
        const U carry = (low >> half) + (cross1 & mask) + (cross2 & mask);
        return static_cast<T>(high + (cross1 >> half) + (cross2 >> half) + (carry >> half));
    }
}

#if !CANN_ASC_STL_DETAIL_SIMD_COMPILATION()
namespace detail {

template <class T>
CANN_ASC_STL_HOST_SIMT_API bool cmath_sincos_special(T value, T* sin_out, T* cos_out) noexcept
{
    if (value == T{0}) {
        *sin_out = value;
        *cos_out = T{1};
        return true;
    }
    if (__builtin_isnan(value) || __builtin_isinf(value)) {
        const T nan = ::asc::std::numeric_limits<T>::quiet_NaN();
        *sin_out = nan;
        *cos_out = nan;
        return true;
    }
    return false;
}

}  // namespace detail

// Radians. Outputs are valid, writable, accessible, nonoverlapping objects.
CANN_ASC_STL_HOST_SIMT_API void sincos(float value, float* sin_out, float* cos_out) noexcept
{
    if (detail::cmath_sincos_special(value, sin_out, cos_out))
        return;
    // Use the standard layer's validated per-type backend. A paired public
    // call does not require the SDK's separate pointer-output sincosf lowering.
    const float sine = ::asc::std::sin(value);
    const float cosine = ::asc::std::cos(value);
    *sin_out = sine;
    *cos_out = cosine;
}
#endif

#if !CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
CANN_ASC_STL_HOST_API void sincos(double value, double* sin_out, double* cos_out) noexcept
{
    if (detail::cmath_sincos_special(value, sin_out, cos_out))
        return;
    *sin_out = ::asc::std::sin(value);
    *cos_out = ::asc::std::cos(value);
}

#if CANN_ASC_STL_DETAIL_HAS_LONG_DOUBLE()
