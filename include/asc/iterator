template <class T, class Index = __PTRDIFF_TYPE__>
class constant_iterator {
public:
    using value_type = T;
    using difference_type = Index;
    using reference = const T&;

    CANN_ASC_STL_API constexpr constant_iterator() : value_(), index_(0)
    {}
    CANN_ASC_STL_API constexpr constant_iterator(T value, Index index = 0) : value_(value), index_(index)
    {}
    CANN_ASC_STL_API constexpr reference operator*() const
    {
        return value_;
    }
    CANN_ASC_STL_API constexpr reference operator[](difference_type) const
    {
        return value_;
    }
    CANN_ASC_STL_API constexpr constant_iterator& operator++()
    {
        ++index_;
        return *this;
    }
    CANN_ASC_STL_API constexpr constant_iterator& operator--()
    {
        --index_;
        return *this;
    }
    CANN_ASC_STL_API constexpr constant_iterator& operator+=(difference_type n)
    {
        index_ += n;
        return *this;
    }
    CANN_ASC_STL_API constexpr constant_iterator& operator-=(difference_type n)
    {
        index_ -= n;
        return *this;
    }
    CANN_ASC_STL_API constexpr Index index() const
    {
        return index_;
    }

private:
    T value_;
    Index index_;
};

template <class T, class Index>
CANN_ASC_STL_API constexpr constant_iterator<T, Index> operator+(constant_iterator<T, Index> iterator, Index n)
{
    iterator += n;
    return iterator;
}

template <class T, class Index>
CANN_ASC_STL_API constexpr Index operator-(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return lhs.index() - rhs.index();
}

template <class T, class Index>
CANN_ASC_STL_API constexpr bool operator==(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return lhs.index() == rhs.index();
}

template <class T, class Index>
CANN_ASC_STL_API constexpr bool operator!=(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return !(lhs == rhs);
}

template <class T, class Index>
CANN_ASC_STL_API constexpr bool operator<(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return lhs.index() < rhs.index();
}

template <class T, class Index>
CANN_ASC_STL_API constexpr bool operator>(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return rhs.index() < lhs.index();
}

template <class T, class Index>
CANN_ASC_STL_API constexpr bool operator<=(
    const constant_iterator<T, Index>& lhs, const constant_iterator<T, Index>& rhs)
{
    return !(rhs.index() < lhs.index());
}

