template <class Iterator, class Stride = __PTRDIFF_TYPE__>
class strided_iterator {
public:
    using difference_type = __PTRDIFF_TYPE__;
    using value_type = typename detail::strided_value<Iterator>::type;
    using reference = decltype(**static_cast<Iterator*>(nullptr));
    using pointer = void;
#if CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
    using iterator_category = ::asc::std::random_access_iterator_tag;
#else
    using iterator_category = ::std::random_access_iterator_tag;
#endif
    using iterator_concept = iterator_category;

    CANN_ASC_STL_API constexpr strided_iterator() : iterator_(), stride_(1)
    {}

    CANN_ASC_STL_API constexpr strided_iterator(Iterator iterator, Stride stride = 1)
        : iterator_(iterator), stride_(stride)
    {}
    CANN_ASC_STL_API constexpr decltype(auto) operator*() const
    {
        return *iterator_;
    }
    CANN_ASC_STL_API constexpr decltype(auto) operator[](difference_type n) const
    {
        return iterator_[n * stride_];
    }
    CANN_ASC_STL_API constexpr strided_iterator& operator++()
    {
        iterator_ += stride_;
        return *this;
    }
    CANN_ASC_STL_API constexpr strided_iterator operator++(int)
    {
        strided_iterator old = *this;
        ++*this;
        return old;
    }
    CANN_ASC_STL_API constexpr strided_iterator& operator--()
    {
        iterator_ -= stride_;
        return *this;
    }
    CANN_ASC_STL_API constexpr strided_iterator operator--(int)
    {
        strided_iterator old = *this;
        --*this;
        return old;
    }
    CANN_ASC_STL_API constexpr strided_iterator& operator+=(difference_type n)
    {
        iterator_ += n * stride_;
        return *this;
    }
    CANN_ASC_STL_API constexpr strided_iterator& operator-=(difference_type n)
    {
        iterator_ -= n * stride_;
        return *this;
    }
    CANN_ASC_STL_API friend constexpr strided_iterator operator+(strided_iterator iterator, difference_type n)
    {
        iterator += n;
        return iterator;
    }
    CANN_ASC_STL_API friend constexpr strided_iterator operator+(difference_type n, strided_iterator iterator)
    {
        iterator += n;
        return iterator;
    }
    CANN_ASC_STL_API friend constexpr strided_iterator operator-(strided_iterator iterator, difference_type n)
    {
        iterator -= n;
        return iterator;
    }
    CANN_ASC_STL_API friend constexpr difference_type operator-(
        const strided_iterator& left, const strided_iterator& right)
    {
        return (left.iterator_ - right.iterator_) / left.stride_;
    }
    // Equality contract: comparison looks at the base position only. Two
    // strided iterators over the same base with different strides compare
    // equal when their base positions coincide - the stride participates in
    // arithmetic (advance, distance), never in equality. Postfix ++/-- are
    // provided on strided_iterator only; the other adaptors stay
    // prefix-only until a consumer needs the postfix form.
    CANN_ASC_STL_API friend constexpr bool operator==(const strided_iterator& left, const strided_iterator& right)
    {
        return left.iterator_ == right.iterator_;
    }
    CANN_ASC_STL_API friend constexpr bool operator!=(const strided_iterator& left, const strided_iterator& right)
    {
        return !(left == right);
    }
    CANN_ASC_STL_API friend constexpr bool operator<(const strided_iterator& left, const strided_iterator& right)
    {
        return left.stride_ > 0 ? left.iterator_ < right.iterator_ : right.iterator_ < left.iterator_;
    }
    CANN_ASC_STL_API friend constexpr bool operator>(const strided_iterator& left, const strided_iterator& right)
    {
        return right < left;
    }
    CANN_ASC_STL_API friend constexpr bool operator<=(const strided_iterator& left, const strided_iterator& right)
    {
        return !(right < left);
    }
    CANN_ASC_STL_API friend constexpr bool operator>=(const strided_iterator& left, const strided_iterator& right)
    {
        return !(left < right);
    }
    CANN_ASC_STL_API constexpr Iterator base() const
    {
        return iterator_;
    }
    CANN_ASC_STL_API constexpr Stride stride() const
    {
        return stride_;
    }

private:
    Iterator iterator_;
    Stride stride_;
};

template <class Iterator>
CANN_ASC_STL_API constexpr strided_iterator<Iterator> make_strided_iterator(Iterator iterator)
{
    return strided_iterator<Iterator>(iterator);
}

template <class Iterator, class Stride>
CANN_ASC_STL_API constexpr strided_iterator<Iterator, Stride> make_strided_iterator(Iterator iterator, Stride stride)
{
    return strided_iterator<Iterator, Stride>(iterator, stride);
}

template <class Index, class Bijection>
class shuffle_iterator {
public:
    using difference_type = __PTRDIFF_TYPE__;
    CANN_ASC_STL_API constexpr shuffle_iterator(Bijection bijection, Index start = 0)
        : bijection_(bijection), current_(start)
    {}
    CANN_ASC_STL_API constexpr auto operator*() const
    {
        return bijection_(current_);
    }
    CANN_ASC_STL_API constexpr auto operator[](difference_type n) const
    {
        return bijection_(current_ + n);
    }
    CANN_ASC_STL_API constexpr shuffle_iterator& operator++()
    {
        ++current_;
        return *this;
    }
    CANN_ASC_STL_API constexpr shuffle_iterator& operator+=(difference_type n)
    {
        current_ += n;
        return *this;
    }
    CANN_ASC_STL_API friend constexpr bool operator==(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return lhs.current_ == rhs.current_;
    }
    CANN_ASC_STL_API friend constexpr bool operator!=(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return !(lhs == rhs);
    }
    CANN_ASC_STL_API friend constexpr bool operator<(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return lhs.current_ < rhs.current_;
    }
    CANN_ASC_STL_API friend constexpr bool operator>(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return rhs.current_ < lhs.current_;
    }
    CANN_ASC_STL_API friend constexpr bool operator<=(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return !(rhs.current_ < lhs.current_);
    }
    CANN_ASC_STL_API friend constexpr bool operator>=(const shuffle_iterator& lhs, const shuffle_iterator& rhs)
    {
        return !(lhs.current_ < rhs.current_);
    }
    CANN_ASC_STL_API friend constexpr shuffle_iterator operator+(shuffle_iterator iterator, difference_type n)
    {
        iterator += n;
        return iterator;
    }
    CANN_ASC_STL_API friend constexpr shuffle_iterator operator+(difference_type n, shuffle_iterator iterator)
    {
        iterator += n;
        return iterator;
    }

private:
    Bijection bijection_;
    Index current_;
};

template <class Bijection, class Index = __SIZE_TYPE__>
CANN_ASC_STL_API constexpr shuffle_iterator<Index, Bijection> make_shuffle_iterator(
    Bijection bijection, Index start = 0)
{
    return shuffle_iterator<Index, Bijection>(bijection, start);
}

