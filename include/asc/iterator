template <class... Iterators>
class zip_iterator {
public:
    using difference_type = __PTRDIFF_TYPE__;
    CANN_ASC_STL_API constexpr explicit zip_iterator(Iterators... iterators) : iterators_(iterators...)
    {}
    CANN_ASC_STL_API constexpr auto operator*() const
    {
        return dereference();
    }
    CANN_ASC_STL_API constexpr zip_iterator& operator++()
    {
        increment();
        return *this;
    }
    template <__SIZE_TYPE__... I>
    CANN_ASC_STL_API constexpr bool equal(const zip_iterator& other, detail::iterator_index_sequence<I...>) const
    {
        bool result = true;
        int unused[] = {0,
            (result = result &&
                    detail::iterator_storage_get<I, Iterators...>::apply(iterators_) ==
                        detail::iterator_storage_get<I, Iterators...>::apply(other.iterators_),
                0)...};
        (void)unused;
        return result;
    }
    CANN_ASC_STL_API constexpr bool equal(const zip_iterator& other) const
    {
        return equal(other, typename detail::make_iterator_index_sequence<sizeof...(Iterators)>::type{});
    }
    CANN_ASC_STL_API friend constexpr bool operator==(const zip_iterator& lhs, const zip_iterator& rhs)
    {
        return lhs.equal(rhs);
    }
    CANN_ASC_STL_API friend constexpr bool operator!=(const zip_iterator& lhs, const zip_iterator& rhs)
    {
        return !(lhs == rhs);
    }

private:
    template <__SIZE_TYPE__... I>
    CANN_ASC_STL_API constexpr auto dereference(detail::iterator_index_sequence<I...>) const
    {
        return detail::zip_reference<decltype(*detail::iterator_storage_get<I, Iterators...>::apply(iterators_))...>(
            *detail::iterator_storage_get<I, Iterators...>::apply(iterators_)...);
    }
    CANN_ASC_STL_API constexpr auto dereference() const
    {
        return dereference(typename detail::make_iterator_index_sequence<sizeof...(Iterators)>::type{});
    }
    template <__SIZE_TYPE__... I>
    CANN_ASC_STL_API constexpr void increment(detail::iterator_index_sequence<I...>)
    {
        int unused[] = {0, (++detail::iterator_storage_get<I, Iterators...>::apply(iterators_), 0)...};
        (void)unused;
    }
    CANN_ASC_STL_API constexpr void increment()
    {
        increment(typename detail::make_iterator_index_sequence<sizeof...(Iterators)>::type{});
    }
    detail::iterator_storage<Iterators...> iterators_;
};

template <class... Iterators>
CANN_ASC_STL_API constexpr zip_iterator<Iterators...> make_zip_iterator(Iterators... iterators)
{
    return zip_iterator<Iterators...>(iterators...);
}

template <class Function>
class zip_function {
public:
    CANN_ASC_STL_API constexpr explicit zip_function(Function function) : function_(function)
    {}
    template <class... References>
    CANN_ASC_STL_API constexpr auto operator()(const detail::zip_reference<References...>& values) const
    {
        return apply(values, typename detail::make_iterator_index_sequence<sizeof...(References)>::type{});
    }

private:
    template <class... References, __SIZE_TYPE__... I>
    CANN_ASC_STL_API constexpr auto apply(
        const detail::zip_reference<References...>& values, detail::iterator_index_sequence<I...>) const
    {
        return function_(values.template get<I>()...);
    }
    Function function_;
};

