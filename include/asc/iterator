namespace detail {

template <class T>
struct strided_remove_cv {
    using type = T;
};
template <class T>
struct strided_remove_cv<const T> {
    using type = T;
};
template <class T>
struct strided_remove_cv<volatile T> {
    using type = T;
};
template <class T>
struct strided_remove_cv<const volatile T> {
    using type = T;
};

template <class Iterator>
struct strided_value {
    using type = typename Iterator::value_type;
};
template <class T>
struct strided_value<T*> {
    using type = typename strided_remove_cv<T>::type;
};

template <__SIZE_TYPE__... Values>
struct iterator_index_sequence {};

template <__SIZE_TYPE__ Remaining, __SIZE_TYPE__... Values>
struct make_iterator_index_sequence : make_iterator_index_sequence<Remaining - 1, Remaining - 1, Values...> {};

template <__SIZE_TYPE__... Values>
struct make_iterator_index_sequence<0, Values...> {
    using type = iterator_index_sequence<Values...>;
};

template <class... Values>
struct iterator_storage;

template <>
struct iterator_storage<> {};

template <class Head, class... Tail>
struct iterator_storage<Head, Tail...> {
    Head head;
    iterator_storage<Tail...> tail;

    CANN_ASC_STL_API constexpr iterator_storage(Head value, Tail... rest) : head(value), tail(rest...)
    {}
};

template <__SIZE_TYPE__ Index, class Head, class... Tail>
struct iterator_storage_get {
    CANN_ASC_STL_API static constexpr decltype(auto) apply(iterator_storage<Head, Tail...>& storage)
    {
        return iterator_storage_get<Index - 1, Tail...>::apply(storage.tail);
    }
    CANN_ASC_STL_API static constexpr decltype(auto) apply(const iterator_storage<Head, Tail...>& storage)
    {
        return iterator_storage_get<Index - 1, Tail...>::apply(storage.tail);
    }
};

template <class Head, class... Tail>
struct iterator_storage_get<0, Head, Tail...> {
    CANN_ASC_STL_API static constexpr Head& apply(iterator_storage<Head, Tail...>& storage)
    {
        return storage.head;
    }
    CANN_ASC_STL_API static constexpr const Head& apply(const iterator_storage<Head, Tail...>& storage)
    {
        return storage.head;
    }
};

template <class... References>
class zip_reference {
public:
    CANN_ASC_STL_API constexpr explicit zip_reference(References... values) : values_(values...)
    {}
    template <__SIZE_TYPE__ Index>
    CANN_ASC_STL_API constexpr decltype(auto) get() const
    {
        return iterator_storage_get<Index, References...>::apply(values_);
    }

private:
    iterator_storage<References...> values_;
};

