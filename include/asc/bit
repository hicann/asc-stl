#ifndef CANN_ASC_STL_ASC_BIT
#define CANN_ASC_STL_ASC_BIT

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__bit/operations.h>
#include <asc/std/__type_traits/enable_if.h>
#include <asc/std/__type_traits/is_same.h>
#include <asc/std/cstdint>

namespace asc {
namespace detail {

template <class T>
inline constexpr bool is_public_bit_type_v = std::is_same_v<T, std::uint32_t> || std::is_same_v<T, std::uint64_t>;

template <class T>
using bit_result_t = std::enable_if_t<is_public_bit_type_v<T>, T>;

}  // namespace detail

template <class T>
CANN_ASC_STL_API constexpr detail::bit_result_t<T> bit_reverse(T value) noexcept
{
    return detail::bit_reverse_impl(value);
}

template <class T = std::uint32_t>
CANN_ASC_STL_API constexpr detail::bit_result_t<T> bitmask(int start, int width) noexcept
{
    return detail::bitmask_impl<T>(start, width);
}

template <class T>
CANN_ASC_STL_API constexpr detail::bit_result_t<T> bitfield_extract(T value, int start, int width) noexcept
{
    return detail::bitfield_extract_impl(value, start, width);
}

template <class T>
CANN_ASC_STL_API constexpr detail::bit_result_t<T> bitfield_insert(
    T destination, T source, int start, int width) noexcept
{
    return detail::bitfield_insert_impl(destination, source, start, width);
}

}  // namespace asc

#endif  // CANN_ASC_STL_ASC_BIT
