template <class T>
class block_collective_workspace;

namespace detail {

template <class T>
struct block_collective_workspace_access;

template <class T>
inline constexpr bool is_block_collective_value_v =
    __is_same(T, __INT32_TYPE__) || __is_same(T, __UINT32_TYPE__) || __is_same(T, float);

}  // namespace detail

template <class T>
class block_collective_workspace {
    static_assert(detail::is_block_collective_value_v<T>, "unsupported block collective value type");

public:
    CANN_ASC_STL_SIMT_API constexpr __UINT32_TYPE__ size() const noexcept
    {
        return element_count_;
    }

private:
    friend struct detail::block_collective_workspace_access<T>;

    CANN_ASC_STL_SIMT_API constexpr block_collective_workspace(T* pointer, __UINT32_TYPE__ element_count) noexcept
        : pointer_(pointer), element_count_(element_count)
    {}

    T* pointer_;
    __UINT32_TYPE__ element_count_;
};

namespace detail {

template <class T>
struct block_collective_workspace_access {
    static CANN_ASC_STL_SIMT_API T* data(block_collective_workspace<T> workspace) noexcept
    {
        return workspace.pointer_;
    }

    static CANN_ASC_STL_SIMT_API block_collective_workspace<T> make(T* pointer, __UINT32_TYPE__ count) noexcept
    {
        return block_collective_workspace<T>(pointer, count);
    }
};

}  // namespace detail

template <class T>
CANN_ASC_STL_SIMT_API block_collective_workspace<T> make_block_collective_workspace(
    T* dynamic_shared_pointer, __UINT32_TYPE__ element_count) noexcept
{
    static_assert(detail::is_block_collective_value_v<T>, "unsupported block collective value type");
    return detail::block_collective_workspace_access<T>::make(dynamic_shared_pointer, element_count);
}

template <class T>
CANN_ASC_STL_SIMT_API constexpr __SIZE_TYPE__ block_collective_workspace_bytes(__UINT32_TYPE__ thread_count) noexcept
{
    static_assert(detail::is_block_collective_value_v<T>, "unsupported block collective value type");
    return static_cast<__SIZE_TYPE__>(thread_count / 32u) * sizeof(T);
}

CANN_ASC_STL_SIMT_API __INT32_TYPE__ block_reduce_add(
