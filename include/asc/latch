#ifndef CANN_ASC_STL_ASC_LATCH
#define CANN_ASC_STL_ASC_LATCH

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__synchronization/latch.h>
#include <asc/atomic>

namespace asc {
template <memory_scope Scope>
class latch {
public:
    latch(const latch&) = delete;
    latch& operator=(const latch&) = delete;
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
    CANN_ASC_STL_SIMT_API constexpr explicit latch(__PTRDIFF_TYPE__ expected) noexcept
        : state_{static_cast<__INT64_TYPE__>(expected)}
    {}
    CANN_ASC_STL_SIMT_API void count_down(__PTRDIFF_TYPE__ update = 1) noexcept
    {
        // Misuse fails fast instead of hanging: a non-positive update or a
        // combined count_down past the initial value drives the counter
        // negative, try_wait() never observes zero, and wait() spins
        // forever (dev parity -- count_down asserts update > 0 and
        // old >= update there).
        if (update <= 0)
            ::asc::detail::atomic_trap();
        atomic_ref<__INT64_TYPE__, Scope> counter(state_.count);
        const __INT64_TYPE__ previous =
            counter.fetch_sub(static_cast<__INT64_TYPE__>(update), std::memory_order_release);
        if (previous < static_cast<__INT64_TYPE__>(update))
            ::asc::detail::atomic_trap();
    }
    CANN_ASC_STL_SIMT_API bool try_wait() const noexcept
    {
        atomic_ref<__INT64_TYPE__, Scope> counter(const_cast<__INT64_TYPE__&>(state_.count));
        return counter.load(std::memory_order_acquire) == 0;
    }
    CANN_ASC_STL_SIMT_API void wait() const noexcept
    {
        // Poll tightly first, then delay between polls so a waiter cannot
        // starve the thread that still owes a count_down. Forward-progress
        // caveat: mixing count_down and wait on threads of the same block
        // risks deadlock regardless of backoff when the waiting threads
        // occupy all of the block's execution slots; keep the counting
        // side on threads that can run ahead of the waiting side.
        ::asc::detail::spin_backoff tester;
        while (!try_wait()) {
            if (tester.poll()) {
                continue;
            }
            tester.backoff();
        }
    }
    CANN_ASC_STL_SIMT_API void arrive_and_wait(__PTRDIFF_TYPE__ update = 1) noexcept
    {
        count_down(update);
        wait();
    }
    CANN_ASC_STL_SIMT_API static constexpr __PTRDIFF_TYPE__ max() noexcept
    {
        // Conservative INT32_MAX rather than the int64 state's full range:
        // it keeps the three synchronization primitives on one documented
        // bound (barrier::max and the counting_semaphore default match) and
        // mirrors common std library latch implementations. The int64 count
        // state supports any value up to this bound without narrowing.
        return 2147483647;
    }
#else
    explicit latch(__PTRDIFF_TYPE__) = delete;
#endif
private:
    detail::latch_state state_;
};
}  // namespace asc

#endif  // CANN_ASC_STL_ASC_LATCH
