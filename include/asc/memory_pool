};

CANN_ASC_STL_HOST inline device_memory_pool_ref device_memory_pool::as_ref() noexcept
{
    return device_memory_pool_ref{*this};
}

CANN_ASC_STL_HOST inline pinned_memory_pool_ref pinned_memory_pool::as_ref() noexcept
{
    return pinned_memory_pool_ref{*this};
}

