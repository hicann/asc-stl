#ifndef CANN_ASC_STL_ASC_SEMAPHORE
#define CANN_ASC_STL_ASC_SEMAPHORE

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__synchronization/semaphore.h>
#include <asc/atomic>

namespace asc {
template <memory_scope Scope, __PTRDIFF_TYPE__ LeastMaxValue = 2147483647>
class counting_semaphore {
    static_assert(LeastMaxValue >= 0, "counting_semaphore requires a nonnegative maximum");

public:
    counting_semaphore(const counting_semaphore&) = delete;
    counting_semaphore& operator=(const counting_semaphore&) = delete;
#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()
    CANN_ASC_STL_SIMT_API constexpr explicit counting_semaphore(__PTRDIFF_TYPE__ desired = 0) noexcept
        : state_{static_cast<__INT64_TYPE__>(desired)}
    {}
    CANN_ASC_STL_SIMT_API void release(__PTRDIFF_TYPE__ update = 1) noexcept
    {
        // std precondition, enforced fail-fast: a negative update, or a
        // release that pushes the permit count past max() (LeastMaxValue),
        // is undefined behavior and silently breaks exclusion invariants --
        // a binary_semaphore would hand out more than one permit. Trap at
        // the source (dev parity: debug-build asserts).
        if (update < 0)
            ::asc::detail::atomic_trap();
        atomic_ref<__INT64_TYPE__, Scope> permits(state_.permits);
        const __INT64_TYPE__ previous =
            permits.fetch_add(static_cast<__INT64_TYPE__>(update), std::memory_order_release);
        const __INT64_TYPE__ ceiling = static_cast<__INT64_TYPE__>(LeastMaxValue) - static_cast<__INT64_TYPE__>(update);
        if (previous < 0 || previous > ceiling)
            ::asc::detail::atomic_trap();
    }
    CANN_ASC_STL_SIMT_API bool try_acquire() noexcept
    {
        atomic_ref<__INT64_TYPE__, Scope> permits(state_.permits);
        __INT64_TYPE__ observed = permits.load(std::memory_order_relaxed);
        while (observed != 0) {
            if (permits.compare_exchange_strong(
                    observed, observed - 1, std::memory_order_acquire, std::memory_order_relaxed)) {
                return true;
            }
        }
        return false;
    }
    CANN_ASC_STL_SIMT_API void acquire() noexcept
    {
        // Poll tightly first, then delay between polls. Cross-core use
        // caveat: a core whose threads all spin in acquire() leaves no
        // slot for a release() scheduled on the same core; do not let
        // releasers and acquirers monopolize all threads of one core.
        ::asc::detail::spin_backoff tester;
        while (!try_acquire()) {
            if (tester.poll()) {
                continue;
            }
            tester.backoff();
        }
    }
    CANN_ASC_STL_SIMT_API static constexpr __PTRDIFF_TYPE__ max() noexcept
    {
        return LeastMaxValue;
    }
#else
    explicit counting_semaphore(__PTRDIFF_TYPE__ = 0) = delete;
#endif
private:
    detail::semaphore_state state_;
};
template <memory_scope Scope>
using binary_semaphore = counting_semaphore<Scope, 1>;
}  // namespace asc

#endif  // CANN_ASC_STL_ASC_SEMAPHORE
