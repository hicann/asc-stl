namespace asc {

struct always_true {
    template <class... Args>
    CANN_ASC_STL_API constexpr bool operator()(Args&&...) const noexcept
    {
        return true;
    }
};
struct always_false {
    template <class... Args>
    CANN_ASC_STL_API constexpr bool operator()(Args&&...) const noexcept
    {
        return false;
    }
};

template <class T>
class equal_to_value {
public:
    CANN_ASC_STL_API constexpr explicit equal_to_value(T value) noexcept : value_(value)
    {}
    CANN_ASC_STL_API constexpr bool operator()(const T& value) const noexcept(noexcept(value == value_))
    {
        return value == value_;
    }

private:
    T value_;
};

template <class T = void>
struct minimum {
    CANN_ASC_STL_API constexpr T operator()(const T& left, const T& right) const noexcept(noexcept(right < left))
    {
        return right < left ? right : left;
    }
};
template <>
struct minimum<void> {
    template <class Left, class Right>
    CANN_ASC_STL_API constexpr auto operator()(Left&& left, Right&& right) const
        noexcept(noexcept(right < left)) -> decltype(right < left ? right : left)
    {
        return right < left ? right : left;
    }
};

template <class T = void>
struct maximum {
    CANN_ASC_STL_API constexpr T operator()(const T& left, const T& right) const noexcept(noexcept(left < right))
    {
        return left < right ? right : left;
    }
};
template <>
struct maximum<void> {
    template <class Left, class Right>
    CANN_ASC_STL_API constexpr auto operator()(Left&& left, Right&& right) const
        noexcept(noexcept(left < right)) -> decltype(left < right ? right : left)
    {
        return left < right ? right : left;
    }
};

namespace detail {
template <class T>
struct metadata_integral {
    static constexpr bool value = false;
};
#define CANN_ASC_STL_METADATA_INTEGRAL(Type) \
    template <>                              \
    struct metadata_integral<Type> {         \
        static constexpr bool value = true;  \
    }
CANN_ASC_STL_METADATA_INTEGRAL(bool);
CANN_ASC_STL_METADATA_INTEGRAL(char);
CANN_ASC_STL_METADATA_INTEGRAL(signed char);
CANN_ASC_STL_METADATA_INTEGRAL(unsigned char);
CANN_ASC_STL_METADATA_INTEGRAL(short);
CANN_ASC_STL_METADATA_INTEGRAL(unsigned short);
CANN_ASC_STL_METADATA_INTEGRAL(int);
CANN_ASC_STL_METADATA_INTEGRAL(unsigned int);
CANN_ASC_STL_METADATA_INTEGRAL(long);
CANN_ASC_STL_METADATA_INTEGRAL(unsigned long);
CANN_ASC_STL_METADATA_INTEGRAL(long long);
CANN_ASC_STL_METADATA_INTEGRAL(unsigned long long);
CANN_ASC_STL_METADATA_INTEGRAL(wchar_t);
CANN_ASC_STL_METADATA_INTEGRAL(char16_t);
CANN_ASC_STL_METADATA_INTEGRAL(char32_t);
#if CANN_ASC_STL_DETAIL_HAS_CXX20()
CANN_ASC_STL_METADATA_INTEGRAL(char8_t);
#endif
#undef CANN_ASC_STL_METADATA_INTEGRAL

template <class T>
struct metadata_unsigned {
    static constexpr bool value = false;
};
#define CANN_ASC_STL_METADATA_UNSIGNED(Type) \
    template <>                              \
    struct metadata_unsigned<Type> {         \
        static constexpr bool value = true;  \
    }
CANN_ASC_STL_METADATA_UNSIGNED(unsigned char);
CANN_ASC_STL_METADATA_UNSIGNED(unsigned short);
CANN_ASC_STL_METADATA_UNSIGNED(unsigned int);
CANN_ASC_STL_METADATA_UNSIGNED(unsigned long);
CANN_ASC_STL_METADATA_UNSIGNED(unsigned long long);
#undef CANN_ASC_STL_METADATA_UNSIGNED

template <class Operator>
struct operation_tag {
    using type = void;
};
template <class A, class B>
struct metadata_same {
    static constexpr bool value = false;
};
template <class A>
struct metadata_same<A, A> {
    static constexpr bool value = true;
};
template <class T>
struct operation_tag<::asc::std::plus<T>> {
    using type = add_op;
};
template <class T>
struct operation_tag<::asc::std::multiplies<T>> {
    using type = multiply_op;
};
template <class T>
struct operation_tag<::asc::std::logical_and<T>> {
    using type = logical_and_op;
};
template <class T>
struct operation_tag<::asc::std::logical_or<T>> {
    using type = logical_or_op;
};
template <class T>
struct operation_tag<::asc::std::bit_and<T>> {
    using type = bitwise_and_op;
};
template <class T>
struct operation_tag<::asc::std::bit_or<T>> {
    using type = bitwise_or_op;
};
template <class T>
struct operation_tag<::asc::std::bit_xor<T>> {
    using type = bitwise_xor_op;
};

template <class Operator, class T>
struct metadata_domain {
    using tag = typename operation_tag<Operator>::type;
    static constexpr bool arithmetic = metadata_integral<T>::value && !metadata_same<T, bool>::value &&
        (metadata_same<tag, add_op>::value || metadata_same<tag, multiply_op>::value);
    static constexpr bool logical = metadata_same<T, bool>::value &&
        (metadata_same<tag, logical_and_op>::value || metadata_same<tag, logical_or_op>::value);
    static constexpr bool bitwise = metadata_unsigned<T>::value &&
        (metadata_same<tag, bitwise_and_op>::value || metadata_same<tag, bitwise_or_op>::value ||
            metadata_same<tag, bitwise_xor_op>::value);
    static constexpr bool valid = arithmetic || logical || bitwise;
};
template <class T>
struct remove_reference {
    using type = T;
};
template <class T>
struct remove_reference<T&> {
    using type = T;
};
template <class T>
struct remove_reference<T&&> {
    using type = T;
};
template <class T>
using decay_t = typename remove_reference<T>::type;

template <class R, class Function>
class return_type_wrapper {
public:
    CANN_ASC_STL_API constexpr explicit return_type_wrapper(Function function) noexcept : function_(function)
    {}
    template <class... Args>
    CANN_ASC_STL_API constexpr R operator()(Args&&... args) const
    {
        return function_(static_cast<Args&&>(args)...);
    }

private:
    Function function_;
};

template <class Function>
class copyable_arguments_wrapper {
public:
    CANN_ASC_STL_API constexpr explicit copyable_arguments_wrapper(Function function) noexcept : function_(function)
    {}
    template <class... Args>
    CANN_ASC_STL_API constexpr auto operator()(
        Args&&... args) const -> decltype(function_(static_cast<Args&&>(args)...))
    {
        return function_(static_cast<Args&&>(args)...);
    }

private:
    Function function_;
};
}  // namespace detail

template <class R, class Function>
CANN_ASC_STL_API constexpr detail::return_type_wrapper<R, detail::decay_t<Function>> proclaim_return_type(
    Function&& function) noexcept
{
    return detail::return_type_wrapper<R, detail::decay_t<Function>>(static_cast<Function&&>(function));
}

template <class Function, class... Args>
struct proclaims_copyable_arguments {
    static constexpr bool value = false;
};
template <class Function, class... Args>
inline constexpr bool proclaims_copyable_arguments_v = proclaims_copyable_arguments<Function, Args...>::value;
template <>
struct proclaims_copyable_arguments<always_true> {
    static constexpr bool value = true;
};
template <>
struct proclaims_copyable_arguments<always_false> {
    static constexpr bool value = true;
};

template <class Function>
CANN_ASC_STL_API constexpr detail::copyable_arguments_wrapper<detail::decay_t<Function>> proclaim_copyable_arguments(
    Function&& function) noexcept
{
    return detail::copyable_arguments_wrapper<detail::decay_t<Function>>(static_cast<Function&&>(function));
}

template <class Operator, class T>
inline constexpr bool is_associative_v =
    detail::metadata_domain<Operator, T>::valid && detail::metadata_unsigned<T>::value &&
    detail::is_associative_op<typename detail::metadata_domain<Operator, T>::tag>::value;
template <class Operator>
inline constexpr bool is_associative_v<Operator, bool> = detail::metadata_domain<Operator, bool>::logical;
template <class T>
inline constexpr bool is_associative_v<minimum<T>, T> = true;
template <class T>
inline constexpr bool is_associative_v<maximum<T>, T> = true;

template <class Operator, class T>
inline constexpr bool is_commutative_v = is_associative_v<Operator, T>;
template <class T>
inline constexpr bool is_commutative_v<minimum<T>, T> = true;
template <class T>
inline constexpr bool is_commutative_v<maximum<T>, T> = true;

template <class Operator, class T>
inline constexpr bool has_identity_element_v = detail::metadata_domain<Operator, T>::valid &&
    detail::identity_element_op<typename detail::metadata_domain<Operator, T>::tag, T>::has_value;
template <class Operator, class T>
CANN_ASC_STL_API constexpr T identity_element() noexcept
{
    static_assert(has_identity_element_v<Operator, T>, "operator has no registered identity element");
    return detail::identity_element_op<typename detail::metadata_domain<Operator, T>::tag, T>::value;
}
template <class Operator, class T>
inline constexpr bool has_absorbing_element_v = detail::metadata_domain<Operator, T>::valid &&
    detail::absorbing_element_op<typename detail::metadata_domain<Operator, T>::tag, T>::has_value;
template <class Operator, class T>
CANN_ASC_STL_API constexpr T absorbing_element() noexcept
{
    static_assert(has_absorbing_element_v<Operator, T>, "operator has no registered absorbing element");
    return detail::absorbing_element_op<typename detail::metadata_domain<Operator, T>::tag, T>::value;
}

}  // namespace asc

#endif  // CANN_ASC_STL_ASC_FUNCTIONAL
