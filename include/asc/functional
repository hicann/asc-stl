#include <asc/__functional/metadata.h>
#include <asc/std/functional>

namespace asc {

struct always_true {
    template <class... Args>
    CANN_ASC_STL_API constexpr bool operator()(Args&&...) const noexcept
    {
        return true;
    }
};

struct always_false {
    template <class... Args>
    CANN_ASC_STL_API constexpr bool operator()(Args&&...) const noexcept
    {
        return false;
    }
};

template <class T>
class equal_to_value {
    static_assert(detail::functional_storable<T>::value, "equal_to_value requires a complete unqualified object type");

public:
    template <class U,
        ::asc::std::enable_if_t<!::asc::std::is_same_v<::asc::std::decay_t<U>, equal_to_value> &&
                ::asc::std::is_constructible_v<T, U&&>,
            int> = 0>
    CANN_ASC_STL_API explicit constexpr equal_to_value(U&& value) noexcept(
        ::asc::std::is_nothrow_constructible_v<T, U&&>)
        : value_(::asc::std::forward<U>(value))
    {}

    CANN_ASC_STL_API equal_to_value(const equal_to_value&) = default;
    CANN_ASC_STL_API equal_to_value(equal_to_value&&) = default;
    CANN_ASC_STL_API equal_to_value& operator=(const equal_to_value&) = default;
    CANN_ASC_STL_API equal_to_value& operator=(equal_to_value&&) = default;
    CANN_ASC_STL_API ~equal_to_value() = default;

    template <class U,
        class = decltype(static_cast<bool>(::asc::std::declval<const U&>() == ::asc::std::declval<const T&>()))>
    CANN_ASC_STL_API constexpr bool operator()(const U& value) const
        noexcept(noexcept(static_cast<bool>(value == value_)))
    {
        return static_cast<bool>(value == value_);
    }

private:
    T value_;
};

template <class U, ::asc::std::enable_if_t<!detail::functional_is_predicate<::asc::std::decay_t<U>>::value, int> = 0>
CANN_ASC_STL_HOST_DEVICE equal_to_value(U&&) -> equal_to_value<::asc::std::decay_t<U>>;

template <class T = void>
struct minimum {
    static_assert(detail::functional_value_v<T>, "minimum requires a complete unqualified object type");

    template <class U = T,
        ::asc::std::enable_if_t<
            ::asc::std::is_same_v<U, T> && detail::functional_extreme_call<U, const U&, const U&, true>::value, int> =
            0>
    CANN_ASC_STL_API constexpr T operator()(const T& left, const T& right) const
        noexcept(detail::functional_extreme_call<U, const U&, const U&, true>::nothrow)
    {
        return detail::functional_less(right, left) ? T(right) : T(left);
    }
};

template <>
struct minimum<void> {
    using is_transparent = void;

    template <class Left, class Right,
        ::asc::std::enable_if_t<detail::functional_extreme_result<Left&&, Right&&, true>::value, int> = 0>
    CANN_ASC_STL_API constexpr auto operator()(Left&& left, Right&& right) const
        noexcept(detail::functional_extreme_result<Left&&, Right&&, true>::nothrow) ->
        typename detail::functional_extreme_result<Left&&, Right&&, true>::type
    {
        using result_type = typename detail::functional_extreme_result<Left&&, Right&&, true>::type;
        const auto& left_value = left;
        const auto& right_value = right;
        return detail::functional_less(right_value, left_value) ? result_type(::asc::std::forward<Right>(right)) :
                                                                  result_type(::asc::std::forward<Left>(left));
    }
};

template <class T = void>
struct maximum {
    static_assert(detail::functional_value_v<T>, "maximum requires a complete unqualified object type");

    template <class U = T,
        ::asc::std::enable_if_t<
            ::asc::std::is_same_v<U, T> && detail::functional_extreme_call<U, const U&, const U&, false>::value, int> =
            0>
    CANN_ASC_STL_API constexpr T operator()(const T& left, const T& right) const
        noexcept(detail::functional_extreme_call<U, const U&, const U&, false>::nothrow)
    {
        return detail::functional_less(left, right) ? T(right) : T(left);
    }
};

template <>
struct maximum<void> {
    using is_transparent = void;

    template <class Left, class Right,
        ::asc::std::enable_if_t<detail::functional_extreme_result<Left&&, Right&&, false>::value, int> = 0>
    CANN_ASC_STL_API constexpr auto operator()(Left&& left, Right&& right) const
        noexcept(detail::functional_extreme_result<Left&&, Right&&, false>::nothrow) ->
        typename detail::functional_extreme_result<Left&&, Right&&, false>::type
    {
        using result_type = typename detail::functional_extreme_result<Left&&, Right&&, false>::type;
        const auto& left_value = left;
        const auto& right_value = right;
        return detail::functional_less(left_value, right_value) ? result_type(::asc::std::forward<Right>(right)) :
                                                                  result_type(::asc::std::forward<Left>(left));
    }
};

template <class Operator, class T>
inline constexpr bool is_associative_v = detail::functional_properties<Operator, T>::associative;

template <class Operator, class T>
inline constexpr bool is_commutative_v = detail::functional_properties<Operator, T>::commutative;

template <class Operator, class T>
inline constexpr bool has_identity_element_v = detail::functional_properties<Operator, T>::has_identity;

template <class Operator, class T, ::asc::std::enable_if_t<has_identity_element_v<Operator, T>, int> = 0>
CANN_ASC_STL_API constexpr T identity_element() noexcept
{
    return detail::functional_properties<Operator, T>::identity;
}

template <class Operator, class T>
inline constexpr bool has_absorbing_element_v = detail::functional_properties<Operator, T>::has_absorbing;

template <class Operator, class T, ::asc::std::enable_if_t<has_absorbing_element_v<Operator, T>, int> = 0>
CANN_ASC_STL_API constexpr T absorbing_element() noexcept
{
    return detail::functional_properties<Operator, T>::absorbing;
}

}  // namespace asc

#endif  // CANN_ASC_STL_ASC_FUNCTIONAL
