#ifndef CANN_ASC_STL_STD_CLIMITS
#define CANN_ASC_STL_STD_CLIMITS

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

// 序言内联等价语义：基座 __config 未提供 hosted/freestanding 门（参见
// __string/constexpr_c_functions.h 的同形内联定义，#ifndef 守卫以便未来集中定义胜出）。
#ifndef CANN_ASC_STL_DETAIL_HOSTED
#if CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
#define CANN_ASC_STL_DETAIL_HOSTED() 0
#else
#define CANN_ASC_STL_DETAIL_HOSTED() 1
#endif
#endif  // CANN_ASC_STL_DETAIL_HOSTED

#ifndef CANN_ASC_STL_DETAIL_FREESTANDING
#define CANN_ASC_STL_DETAIL_FREESTANDING() !CANN_ASC_STL_DETAIL_HOSTED()
#endif  // CANN_ASC_STL_DETAIL_FREESTANDING

#if CANN_ASC_STL_DETAIL_HOSTED()
#include <limits.h>
#else  // ^^^ CANN_ASC_STL_DETAIL_HOSTED() ^^^ / vvv CANN_ASC_STL_DETAIL_FREESTANDING() vvv
// 独立/设备侧不依赖 <limits.h> 的可用性，直接给出各整型的极值宏。
#ifndef CHAR_BIT
#define CHAR_BIT 8
#endif

#ifndef SCHAR_MIN
#define SCHAR_MIN (-128)
#endif
#ifndef SCHAR_MAX
#define SCHAR_MAX 127
#endif
#ifndef UCHAR_MAX
#define UCHAR_MAX 255
#endif

#ifndef CHAR_MIN
#if ('\xff' > 0)
#define CHAR_MIN 0
#else
#define CHAR_MIN SCHAR_MIN
#endif
#endif
#ifndef CHAR_MAX
#if ('\xff' > 0)
#define CHAR_MAX UCHAR_MAX
#else
#define CHAR_MAX SCHAR_MAX
#endif
#endif
#ifndef SHRT_MIN
#define SHRT_MIN (-SHRT_MAX - 1)
#endif
#ifndef SHRT_MAX
#define SHRT_MAX 0x7fff
#endif
#ifndef USHRT_MAX
#define USHRT_MAX 0xffff
#endif
#ifndef INT_MIN
#define INT_MIN (-INT_MAX - 1)
#endif
#ifndef INT_MAX
#define INT_MAX 0x7fffffff
#endif
#ifndef UINT_MAX
#define UINT_MAX 0xffffffff
#endif
#ifndef LONG_MIN
#define LONG_MIN (-LONG_MAX - 1)
#endif
#ifndef LONG_MAX
#if defined(__LP64__)
#define LONG_MAX LLONG_MAX
#else
#define LONG_MAX INT_MAX
#endif
#endif
#ifndef ULONG_MAX
#if defined(__LP64__)
#define ULONG_MAX ULLONG_MAX
#else
#define ULONG_MAX UINT_MAX
#endif
#endif
#ifndef LLONG_MIN
#define LLONG_MIN (-LLONG_MAX - 1)
#endif
#ifndef LLONG_MAX
#define LLONG_MAX 0x7fffffffffffffffLL
#endif
#ifndef ULLONG_MAX
#define ULLONG_MAX 0xffffffffffffffffULL
#endif
#endif  // CANN_ASC_STL_DETAIL_FREESTANDING()

#endif  // CANN_ASC_STL_STD_CLIMITS
