template <class T, class Compare>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const T& clamp(
    const T& value, const T& lower, const T& upper, Compare compare)
{
    return compare(value, lower) ? lower : compare(upper, value) ? upper : value;
}

template <class T>
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const T& clamp(const T& value, const T& lower, const T& upper)
{
    return ::asc::std::clamp(value, lower, upper, __less{});
}

