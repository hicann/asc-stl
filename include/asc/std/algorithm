template <class Forward, class BinaryPredicate>
CANN_ASC_STL_HOST_API Forward adjacent_find(
    asc::device_policy policy, Forward first, Forward last, BinaryPredicate predicate)
{
    auto slot = ::asc::detail::make_synchronous_slot<::asc::std::size_t>(policy);
    if (!slot.status.success())
        ::asc::std::terminate();
    auto status = ::asc::parallel::adjacent_find(slot.backend_policy, first, last, slot.device_value, predicate);
    if (!::asc::detail::finish_synchronous(policy, status, slot).success())
        ::asc::std::terminate();
    return first + slot.host_value;
}

