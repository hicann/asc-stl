#ifndef CANN_ASC_STL_ASC_STD_FORMAT
#define CANN_ASC_STL_ASC_STD_FORMAT

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

// Supported format grammar (frozen subset of std::format, see the registry
// entry of the format facade):
//   - literal text, with "{{" and "}}" as brace escapes;
//   - "{}" replacement fields consuming arguments in order;
//   - "{:d}", "{:x}", "{:X}", "{:o}", "{:b}" typed integer fields.
// Anything else - manual field numbering such as "{0}", width, precision,
// nested replacement fields, sign or alternative form - is rejected while
// the format string is consteval-validated. Structured diagnostics for the
// rejected productions are future work; today the rejection surfaces as a
// "not a constant expression" error at the format string construction.
#include <asc/std/__format/format_integral.h>
#include <asc/std/__format/format_string.h>
#include <asc/std/__format/format_to.h>
#include <asc/std/__format/format_to_n.h>
#include <asc/std/__format/formatted_size.h>
#include <asc/std/__format/formatters/bool.h>
#include <asc/std/__format/formatters/char.h>
#include <asc/std/__format/formatters/int.h>
#include <asc/std/__format/formatters/str.h>
#include <asc/std/__format/output_buffer.h>
#include <asc/std/__format/validation.h>

#endif  // CANN_ASC_STL_ASC_STD_FORMAT
