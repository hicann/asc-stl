#endif

// ---------------------------------------------------------------------------
// Diagnostics
// ---------------------------------------------------------------------------

#define CANN_ASC_STL_DETAIL_PRAGMA_IMPL(_x) _Pragma(#_x)
#define CANN_ASC_STL_DETAIL_PRAGMA(_x) CANN_ASC_STL_DETAIL_PRAGMA_IMPL(_x)

#if defined(CANN_ASC_STL_DETAIL_COMPILER_CLANG) || defined(CANN_ASC_STL_DETAIL_COMPILER_CCE)
// Bisheng CCE is a clang frontend and accepts the clang diagnostic pragmas.
#define CANN_ASC_STL_DETAIL_DIAG_PUSH CANN_ASC_STL_DETAIL_PRAGMA(clang diagnostic push)
#define CANN_ASC_STL_DETAIL_DIAG_POP CANN_ASC_STL_DETAIL_PRAGMA(clang diagnostic pop)
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_CLANG(_warning) CANN_ASC_STL_DETAIL_PRAGMA(clang diagnostic ignored _warning)
#else
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_CLANG(_warning)
#endif

#if defined(CANN_ASC_STL_DETAIL_COMPILER_GCC)
#define CANN_ASC_STL_DETAIL_DIAG_PUSH CANN_ASC_STL_DETAIL_PRAGMA(GCC diagnostic push)
#define CANN_ASC_STL_DETAIL_DIAG_POP CANN_ASC_STL_DETAIL_PRAGMA(GCC diagnostic pop)
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_GCC(_warning) CANN_ASC_STL_DETAIL_PRAGMA(GCC diagnostic ignored _warning)
#else
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_GCC(_warning)
#endif

#if defined(CANN_ASC_STL_DETAIL_COMPILER_MSVC)
#define CANN_ASC_STL_DETAIL_DIAG_PUSH __pragma(warning(push))
#define CANN_ASC_STL_DETAIL_DIAG_POP __pragma(warning(pop))
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_MSVC(_warning) __pragma(warning(disable : _warning))
#else
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_MSVC(_warning)
#endif

#if !defined(CANN_ASC_STL_DETAIL_DIAG_PUSH)
#define CANN_ASC_STL_DETAIL_DIAG_PUSH
#endif

#if !defined(CANN_ASC_STL_DETAIL_DIAG_POP)
#define CANN_ASC_STL_DETAIL_DIAG_POP
#endif

#if defined(CANN_ASC_STL_DETAIL_COMPILER_CCE)
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_CCE(_warning) CANN_ASC_STL_DETAIL_PRAGMA(clang diagnostic ignored _warning)
#else
#define CANN_ASC_STL_DETAIL_DIAG_SUPPRESS_CCE(_warning)
#endif

// ---------------------------------------------------------------------------
// Function annotations
// ---------------------------------------------------------------------------

#if defined(CANN_ASC_STL_DETAIL_COMPILER_CCE)
#if CANN_ASC_STL_DETAIL_PURE_SIMT_TU()
// Pure-SIMT mode uses the __host__/__aicore__ attribute pair.
#define CANN_ASC_STL_HOST_DEVICE __host__ __aicore__
#else
// Mixed-mode CCE provides the dual annotation used by CANN's
// ASCENDC_HOST_AICORE for declarations callable from both sides.
#define CANN_ASC_STL_HOST_DEVICE [ host, aicore ]
#endif
#else
#define CANN_ASC_STL_HOST_DEVICE
#endif

#if defined(CANN_ASC_STL_DETAIL_COMPILER_CCE)
#define CANN_ASC_STL_DETAIL_AICORE_FN __aicore__ inline
#else
#define CANN_ASC_STL_DETAIL_AICORE_FN inline
#endif

#if defined(CANN_ASC_STL_DETAIL_COMPILER_CCE)
// The vector-core annotation historically used the __aiv__ attribute spelling;
// CANN 9.x toolchains no longer define it, so vector-core functions share the
// aicore annotation until a dedicated spelling returns.
#define CANN_ASC_STL_DETAIL_AIV_FN __aicore__ inline
#else
#define CANN_ASC_STL_DETAIL_AIV_FN inline
#endif

