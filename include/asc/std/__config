#ifndef CANN_ASC_STL_STD_CONFIG
#define CANN_ASC_STL_STD_CONFIG

// ---------------------------------------------------------------------------
// Compiler and language detection
// ---------------------------------------------------------------------------

// The SIMT compilation mode is flagged differently per target arch:
// __NPU_COMPILER_INTERNAL_PURE_SIMT__ / __ENABLE_ASC_PURESIMT__ on the 950
// family, __CCE_AICORE_SUPPORT_SIMT__ on others. Treat any of them as SIMT.
// NOTE (revalidated 2026-09-19, CANN 9.3.0): __NPU_COMPILER_INTERNAL_PURE_SIMT__
// is now predefined exactly where the documentation claims -- defined in pure
// SIMT TUs, absent in mixed vector-kernel and host compilations (probe
// c_b10_deadmacro). On 9.0/9.2 toolchains the macro was dead in every mode and
// the discriminators below carried the load; the multi-term disjunction stays
// as the version-portable form, with the macro as the first-class pure-SIMT
// signal on current toolchains.
#if defined(__CCE__) || defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__) || defined(__CCE_AICORE_SUPPORT_SIMT__) || \
    defined(__ENABLE_ASC_PURESIMT__)
#define CANN_ASC_STL_DETAIL_COMPILER_CCE 1
#if defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__)
#define CANN_ASC_STL_DETAIL_COMPILER_PURE_SIMT 1
#endif
#if defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__) || defined(__CCE_AICORE_SUPPORT_SIMT__) || \
    defined(__ENABLE_ASC_PURESIMT__)
#define CANN_ASC_STL_DETAIL_COMPILER_SIMT_SUPPORT 1
#endif
#elif defined(__clang__)
#define CANN_ASC_STL_DETAIL_COMPILER_CLANG 1
#elif defined(__GNUC__)
#define CANN_ASC_STL_DETAIL_COMPILER_GCC 1
#elif defined(_MSC_VER)
#define CANN_ASC_STL_DETAIL_COMPILER_MSVC 1
#else
#define CANN_ASC_STL_DETAIL_COMPILER_UNKNOWN 1
#endif

// True pure-SIMT translation-unit mode (`bisheng -cce-enable-puresimt` with
// the dpp runtime wrapper __clang_dpp_runtime_wrapper.h, which ships the
// global ::dim3, the placement-new forms and the __host__/__aicore__
// attribute pair). This is DISTINCT from CANN_ASC_STL_DETAIL_COMPILER_PURE_SIMT
// above: that wide flag also fires in the ordinary kernel mode (where
// __CCE_AICORE_SUPPORT_SIMT__ is predefined) and merely means "SIMT API
// available". Empirical detection:
// - the wrapper never predefines __NPU_COMPILER_INTERNAL_PURE_SIMT__ and is
//   not auto-included at -fsyntax-only time;
// - its include guard __CLANG_CCE_SIMT_INTRINSICS_H__ is ALSO defined by the
//   compiler-injected <__clang_cce_simt_intrinsics.h> in ORDINARY kernel
//   builds (preprocess/precompile passes), so the guard alone is NOT a
//   puresimt signal — it must be combined with !__CCE__ (ordinary kernel
//   passes always define __CCE__, while -cce-enable-puresimt does not);
// - the documented -D__ENABLE_ASC_PURESIMT__ remains an explicit opt-in for
//   builds that include the wrapper after ASC-STL headers.
#if defined(__ENABLE_ASC_PURESIMT__) || (defined(__CLANG_CCE_SIMT_INTRINSICS_H__) && !defined(__CCE__))
#define CANN_ASC_STL_DETAIL_PURE_SIMT_TU() 1
#else
#define CANN_ASC_STL_DETAIL_PURE_SIMT_TU() 0
#endif

// CANN normally provides this spelling through kernel_operator.h. Keep ASC-STL
// headers self-contained when they are included before that umbrella header.
#if defined(CANN_ASC_STL_DETAIL_COMPILER_CCE) && !defined(__aicore__)
#define __aicore__ [aicore]
#endif

#if defined(_MSVC_LANG)
#define CANN_ASC_STL_DETAIL_STD_CPLUSPLUS _MSVC_LANG
#else
#define CANN_ASC_STL_DETAIL_STD_CPLUSPLUS __cplusplus
#endif

#if CANN_ASC_STL_DETAIL_STD_CPLUSPLUS >= 201703L
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX17 1
#else
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX17 0
#endif

#if CANN_ASC_STL_DETAIL_STD_CPLUSPLUS >= 202002L
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX20 1
#else
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX20 0
#endif

#if CANN_ASC_STL_DETAIL_STD_CPLUSPLUS >= 202302L
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX23 1
#else
#define CANN_ASC_STL_DETAIL_STD_HAS_CXX23 0
#endif

