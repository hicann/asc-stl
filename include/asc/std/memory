CANN_ASC_STL_BEGIN_NAMESPACE

template <class T, class Alloc, class... Args>
CANN_ASC_STL_API constexpr auto uses_allocator_construction_args(const Alloc& allocator, Args&&... args) noexcept;

namespace __allocator_construction {
template <class T, class Alloc>
struct from_tuple {
    const Alloc& allocator;
    template <class... Args>
    CANN_ASC_STL_API constexpr auto operator()(Args&&... args) const noexcept
    {
        return ::asc::std::uses_allocator_construction_args<T>(allocator, ::asc::std::forward<Args>(args)...);
    }
};

template <class T>
struct construct_at {
    T* address;
    template <class... Args>
    CANN_ASC_STL_API constexpr T* operator()(Args&&... args) const
    {
        return ::asc::std::construct_at(address, ::asc::std::forward<Args>(args)...);
    }
};

template <class Pair, class Alloc, class FirstTuple, class SecondTuple>
CANN_ASC_STL_API constexpr auto pair_args(
    const Alloc& allocator, piecewise_construct_t, FirstTuple&& first_args, SecondTuple&& second_args) noexcept
{
    using first_type = typename Pair::first_type;
    using second_type = typename Pair::second_type;
    auto first =
        ::asc::std::apply(from_tuple<first_type, Alloc>{allocator}, ::asc::std::forward<FirstTuple>(first_args));
    auto second =
        ::asc::std::apply(from_tuple<second_type, Alloc>{allocator}, ::asc::std::forward<SecondTuple>(second_args));
    return tuple<piecewise_construct_t, decltype(first), decltype(second)>(piecewise_construct,
        ::asc::std::forward<decltype(first)>(first), ::asc::std::forward<decltype(second)>(second));
}

template <class Pair, class Alloc, class First, class Second>
CANN_ASC_STL_API constexpr auto pair_args(const Alloc& allocator, First&& first, Second&& second) noexcept
{
    return pair_args<Pair>(allocator, piecewise_construct,
        ::asc::std::forward_as_tuple(::asc::std::forward<First>(first)),
        ::asc::std::forward_as_tuple(::asc::std::forward<Second>(second)));
}

template <class Pair, class Alloc>
CANN_ASC_STL_API constexpr auto pair_args(const Alloc& allocator) noexcept
{
    return pair_args<Pair>(allocator, piecewise_construct, tuple<>{}, tuple<>{});
}

template <class Pair, class Alloc, class First, class Second>
CANN_ASC_STL_API constexpr auto pair_args(const Alloc& allocator, const pair<First, Second>& value) noexcept
{
    return pair_args<Pair>(allocator, value.first, value.second);
}

template <class Pair, class Alloc, class First, class Second>
CANN_ASC_STL_API constexpr auto pair_args(const Alloc& allocator, pair<First, Second>&& value) noexcept
{
    return pair_args<Pair>(
        allocator, ::asc::std::forward<First>(value.first), ::asc::std::forward<Second>(value.second));
}
}  // namespace __allocator_construction

template <class T, class Alloc, class... Args>
CANN_ASC_STL_API constexpr auto uses_allocator_construction_args(const Alloc& allocator, Args&&... args) noexcept
{
    if constexpr (__is_pair<T>::value) {
        return __allocator_construction::pair_args<T>(allocator, ::asc::std::forward<Args>(args)...);
    } else if constexpr (!uses_allocator_v<T, Alloc>) {
        return ::asc::std::forward_as_tuple(::asc::std::forward<Args>(args)...);
    } else if constexpr (__is_constructible(T, allocator_arg_t, const Alloc&, Args...)) {
        return tuple<allocator_arg_t, const Alloc&, Args&&...>(
            allocator_arg, allocator, ::asc::std::forward<Args>(args)...);
    } else {
        static_assert(__is_constructible(T, Args..., const Alloc&), "invalid uses-allocator construction");
        return ::asc::std::forward_as_tuple(::asc::std::forward<Args>(args)..., allocator);
    }
}

template <class T, class Alloc, class... Args>
CANN_ASC_STL_API constexpr T make_obj_using_allocator(const Alloc& allocator, Args&&... args)
{
    return ::asc::std::make_from_tuple<T>(
        ::asc::std::uses_allocator_construction_args<T>(allocator, ::asc::std::forward<Args>(args)...));
}

template <class T, class Alloc, class... Args>
CANN_ASC_STL_API constexpr T* uninitialized_construct_using_allocator(
    T* address, const Alloc& allocator, Args&&... args)
{
    return ::asc::std::apply(__allocator_construction::construct_at<T>{address},
        ::asc::std::uses_allocator_construction_args<T>(allocator, ::asc::std::forward<Args>(args)...));
}

CANN_ASC_STL_END_NAMESPACE

#endif  // CANN_ASC_STL_ASC_STD_MEMORY
