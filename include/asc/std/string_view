    CANN_ASC_STL_API constexpr bool operator op(                                               \
        type_identity_t<basic_string_view<C, T>> left, basic_string_view<C, T> right) noexcept \
    {                                                                                          \
        return left op right;                                                                  \
    }

CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(==)
CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(!=)
CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(<)
CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(>)
CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(<=)
CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(>=)

#undef CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS

template <class C, class T>
struct hash<basic_string_view<C, T>> {
    CANN_ASC_STL_API constexpr size_t operator()(basic_string_view<C, T> value) const noexcept
    {
        size_t result = sizeof(size_t) == 8 ? static_cast<size_t>(1469598103934665603ULL) : 2166136261U;
        const size_t prime = sizeof(size_t) == 8 ? static_cast<size_t>(1099511628211ULL) : 16777619U;
        for (C character : value)
            result = (result ^ static_cast<size_t>(character)) * prime;
        return result;
    }
};

