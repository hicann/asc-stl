template <class Character, class Traits>
class basic_string_view {
public:
    using traits_type = Traits;
    using value_type = Character;
    using pointer = Character*;
    using const_pointer = const Character*;
    using reference = Character&;
    using const_reference = const Character&;
    using const_iterator = const_pointer;
    using iterator = const_iterator;
    using const_reverse_iterator = ::asc::std::reverse_iterator<const_iterator>;
    using reverse_iterator = const_reverse_iterator;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    static constexpr size_type npos = static_cast<size_type>(-1);

    CANN_ASC_STL_API constexpr basic_string_view() noexcept = default;
    CANN_ASC_STL_API constexpr basic_string_view(const Character* text, size_type count) noexcept
        : data_(text), size_(count)
    {}
    CANN_ASC_STL_API constexpr basic_string_view(const Character* text) noexcept
        : data_(text), size_(Traits::length(text))
    {}

    CANN_ASC_STL_API constexpr const_iterator begin() const noexcept
    {
        return data_;
    }
    CANN_ASC_STL_API constexpr const_iterator end() const noexcept
    {
        return data_ + size_;
    }
    CANN_ASC_STL_API constexpr const_iterator cbegin() const noexcept
    {
        return begin();
    }
    CANN_ASC_STL_API constexpr const_iterator cend() const noexcept
    {
        return end();
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crbegin() const noexcept
    {
        return rbegin();
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crend() const noexcept
    {
        return rend();
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return size_;
    }
    CANN_ASC_STL_API constexpr size_type length() const noexcept
    {
        return size_;
    }
    CANN_ASC_STL_API constexpr size_type max_size() const noexcept
    {
        return static_cast<size_type>(-1) / sizeof(Character);
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return size_ == 0;
    }
    CANN_ASC_STL_API constexpr const_reference operator[](size_type position) const noexcept
    {
        return data_[position];
    }
    CANN_ASC_STL_API constexpr const_reference front() const noexcept
    {
        return data_[0];
    }
    CANN_ASC_STL_API constexpr const_reference back() const noexcept
    {
        return data_[size_ - 1];
    }
    CANN_ASC_STL_API constexpr const_pointer data() const noexcept
    {
        return data_;
    }

    CANN_ASC_STL_API constexpr void remove_prefix(size_type count) noexcept
    {
        data_ += count;
        size_ -= count;
    }
    CANN_ASC_STL_API constexpr void remove_suffix(size_type count) noexcept
    {
        size_ -= count;
    }
    CANN_ASC_STL_API constexpr void swap(basic_string_view& other) noexcept
    {
        const_pointer pointer_value = data_;
        size_type size_value = size_;
        data_ = other.data_;
        size_ = other.size_;
        other.data_ = pointer_value;
        other.size_ = size_value;
    }

    CANN_ASC_STL_API constexpr int compare(basic_string_view other) const noexcept
    {
        const size_type count = size_ < other.size_ ? size_ : other.size_;
        const int result = Traits::compare(data_, other.data_, count);
        return result != 0 ? result : (size_ < other.size_ ? -1 : (size_ > other.size_ ? 1 : 0));
    }

    CANN_ASC_STL_API constexpr bool starts_with(basic_string_view value) const noexcept
    {
        return size_ >= value.size_ && basic_string_view(data_, value.size_) == value;
    }
    CANN_ASC_STL_API constexpr bool starts_with(Character value) const noexcept
    {
        return !empty() && Traits::eq(front(), value);
    }
    CANN_ASC_STL_API constexpr bool starts_with(const Character* value) const noexcept
    {
        return starts_with(basic_string_view(value));
    }
    CANN_ASC_STL_API constexpr bool ends_with(basic_string_view value) const noexcept
    {
        return size_ >= value.size_ && basic_string_view(data_ + size_ - value.size_, value.size_) == value;
    }
    CANN_ASC_STL_API constexpr bool ends_with(Character value) const noexcept
    {
        return !empty() && Traits::eq(back(), value);
    }
    CANN_ASC_STL_API constexpr bool ends_with(const Character* value) const noexcept
    {
        return ends_with(basic_string_view(value));
    }

    CANN_ASC_STL_API constexpr size_type find(basic_string_view value, size_type position = 0) const noexcept
    {
        if (value.size_ == 0)
            return position <= size_ ? position : npos;
        if (position > size_ || value.size_ > size_ - position)
            return npos;
        for (size_type index = position; index + value.size_ <= size_; ++index)
            if (Traits::compare(data_ + index, value.data_, value.size_) == 0)
                return index;
        return npos;
    }
    CANN_ASC_STL_API constexpr size_type find(Character value, size_type position = 0) const noexcept
    {
        return find(basic_string_view(&value, 1), position);
    }
    CANN_ASC_STL_API constexpr size_type find(
        const Character* value, size_type position, size_type count) const noexcept
    {
        return find(basic_string_view(value, count), position);
    }
    CANN_ASC_STL_API constexpr size_type find(const Character* value, size_type position = 0) const noexcept
    {
        return find(basic_string_view(value), position);
    }

    CANN_ASC_STL_API constexpr size_type rfind(basic_string_view value, size_type position = npos) const noexcept
    {
        if (value.size_ > size_)
            return npos;
        size_type index = position < size_ - value.size_ ? position : size_ - value.size_;
        do {
            if (Traits::compare(data_ + index, value.data_, value.size_) == 0)
                return index;
        } while (index-- != 0);
        return npos;
    }
    CANN_ASC_STL_API constexpr size_type rfind(Character value, size_type position = npos) const noexcept
    {
        return rfind(basic_string_view(&value, 1), position);
    }
    CANN_ASC_STL_API constexpr size_type rfind(
        const Character* value, size_type position, size_type count) const noexcept
    {
        return rfind(basic_string_view(value, count), position);
    }
    CANN_ASC_STL_API constexpr size_type rfind(const Character* value, size_type position = npos) const noexcept
    {
        return rfind(basic_string_view(value), position);
    }

private:
    CANN_ASC_STL_API constexpr bool __contains(Character value) const noexcept
    {
        return Traits::find(data_, size_, value) != nullptr;
    }

public:
    CANN_ASC_STL_API constexpr size_type find_first_of(basic_string_view set, size_type position = 0) const noexcept
    {
        for (size_type i = position; i < size_; ++i)
            if (set.__contains(data_[i]))
                return i;
        return npos;
    }
    CANN_ASC_STL_API constexpr size_type find_last_of(basic_string_view set, size_type position = npos) const noexcept
    {
        if (empty())
            return npos;
        size_type i = position < size_ ? position : size_ - 1;
        do {
            if (set.__contains(data_[i]))
                return i;
        } while (i-- != 0);
        return npos;
    }
    CANN_ASC_STL_API constexpr size_type find_first_not_of(basic_string_view set, size_type position = 0) const noexcept
    {
        for (size_type i = position; i < size_; ++i)
            if (!set.__contains(data_[i]))
                return i;
        return npos;
    }
    CANN_ASC_STL_API constexpr size_type find_last_not_of(
        basic_string_view set, size_type position = npos) const noexcept
    {
        if (empty())
            return npos;
        size_type i = position < size_ ? position : size_ - 1;
        do {
            if (!set.__contains(data_[i]))
                return i;
        } while (i-- != 0);
        return npos;
    }
#define CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS(name, default_position)                                        \
    CANN_ASC_STL_API constexpr size_type name(Character value, size_type position = default_position) const noexcept \
    {                                                                                                                \
        return name(basic_string_view(&value, 1), position);                                                         \
    }                                                                                                                \
    CANN_ASC_STL_API constexpr size_type name(const Character* value, size_type position, size_type count)           \
        const noexcept                                                                                               \
    {                                                                                                                \
        return name(basic_string_view(value, count), position);                                                      \
    }                                                                                                                \
    CANN_ASC_STL_API constexpr size_type name(const Character* value, size_type position = default_position)         \
        const noexcept                                                                                               \
    {                                                                                                                \
        return name(basic_string_view(value), position);                                                             \
    }
    CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS(find_first_of, 0)
    CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS(find_last_of, npos)
    CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS(find_first_not_of, 0)
    CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS(find_last_not_of, npos)
#undef CANN_ASC_STL_DETAIL_STRING_VIEW_SET_OVERLOADS

private:
    const_pointer data_{};
    size_type size_{};
};

template <class C, class T>
CANN_ASC_STL_API constexpr bool operator==(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return left.compare(right) == 0;
}
template <class C, class T>
CANN_ASC_STL_API constexpr bool operator!=(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return !(left == right);
}
template <class C, class T>
CANN_ASC_STL_API constexpr bool operator<(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return left.compare(right) < 0;
}
template <class C, class T>
CANN_ASC_STL_API constexpr bool operator>(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return right < left;
}
template <class C, class T>
CANN_ASC_STL_API constexpr bool operator<=(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return !(right < left);
}
template <class C, class T>
CANN_ASC_STL_API constexpr bool operator>=(basic_string_view<C, T> left, basic_string_view<C, T> right) noexcept
{
    return !(left < right);
}

#define CANN_ASC_STL_DETAIL_STRING_VIEW_COMPARISON_OVERLOADS(op)                               \
    template <class C, class T, int = 1>                                                       \
    CANN_ASC_STL_API constexpr bool operator op(                                               \
        basic_string_view<C, T> left, type_identity_t<basic_string_view<C, T>> right) noexcept \
    {                                                                                          \
        return left op right;                                                                  \
    }                                                                                          \
