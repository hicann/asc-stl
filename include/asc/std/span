namespace __span_detail {
template <class T>
inline constexpr bool is_span = false;
template <class T, size_t Extent>
inline constexpr bool is_span<span<T, Extent>> = true;

template <class T>
inline constexpr bool is_array_wrapper = false;
template <class T, size_t Size>
inline constexpr bool is_array_wrapper<array<T, Size>> = true;

template <class It, class Element, bool = contiguous_iterator<It>, class = void>
struct compatible_iterator : false_type {};
template <class It, class Element>
struct compatible_iterator<It, Element, true, void_t<iter_reference_t<It>>>
    : bool_constant<is_convertible_v<remove_reference_t<iter_reference_t<It>> (*)[], Element (*)[]>> {};

template <class It, class End, class Element, bool = compatible_iterator<It, Element>::value>
struct compatible_sentinel : false_type {};
template <class It, class End, class Element>
struct compatible_sentinel<It, End, Element, true>
    : bool_constant<sized_sentinel_for<End, It> && !is_convertible_v<End, size_t>> {};

template <class Range, class Element,
    bool = ranges::contiguous_range<Range> && ranges::sized_range<Range> &&
        (ranges::borrowed_range<Range> || is_const_v<Element>),
    class = void>
struct compatible_range_impl : false_type {};
template <class Range, class Element>
struct compatible_range_impl<Range, Element, true,
    void_t<ranges::range_reference_t<Range>, decltype(ranges::data(::asc::std::declval<Range&>()))>>
    : bool_constant<is_convertible_v<remove_reference_t<ranges::range_reference_t<Range>> (*)[], Element (*)[]> &&
          is_convertible_v<decltype(ranges::data(::asc::std::declval<Range&>())), Element*>> {};

template <class Range, class Element,
    bool =
        is_span<remove_cvref_t<Range>> || is_array_wrapper<remove_cvref_t<Range>> || is_array_v<remove_cvref_t<Range>>>
struct compatible_range : false_type {};
template <class Range, class Element>
struct compatible_range<Range, Element, false> : compatible_range_impl<Range, Element> {};

template <class It, class EndOrSize, class = void>
struct compatible_deduction : false_type {};
template <class It, class EndOrSize>
struct compatible_deduction<It, EndOrSize, void_t<iter_reference_t<It>>>
    : bool_constant<compatible_iterator<It, remove_reference_t<iter_reference_t<It>>>::value &&
          (is_convertible_v<EndOrSize, size_t> || sized_sentinel_for<EndOrSize, It>)> {};
}  // namespace __span_detail

template <class T, size_t Extent>
class span {
public:
    using element_type = T;
    using value_type = remove_const_t<T>;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using const_pointer = const T*;
    using reference = T&;
    using const_reference = const T&;
    using iterator = pointer;
    using reverse_iterator = ::asc::std::reverse_iterator<iterator>;
    static constexpr size_type extent = Extent;
    template <size_t Value = Extent, class = decltype(sizeof(char[Value == 0 ? 1 : -1]))>
    CANN_ASC_STL_API constexpr span() noexcept
    {}
    template <class It, enable_if_t<__span_detail::compatible_iterator<It, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr span(It first, [[maybe_unused]] size_type count) noexcept : data_(to_address(first))
    {
        CANN_ASC_STL_DETAIL_ASSERT(count == Extent, "size mismatch in span's constructor (iterator, count)");
    }
    template <class U, class V, enable_if_t<__span_detail::compatible_sentinel<U*, V*, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr span(U* first, [[maybe_unused]] V* last) noexcept : data_(first)
    {
        CANN_ASC_STL_DETAIL_ASSERT(last - first >= 0 && static_cast<size_type>(last - first) == Extent,
            "size mismatch in span's constructor (pointer, pointer)");
    }
    template <class U, size_t Size,
        enable_if_t<Size == Extent && is_convertible_v<U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(U (&array_value)[Size]) noexcept : data_(array_value)
    {}
    template <class U, size_t Size,
        enable_if_t<Size == Extent && is_convertible_v<U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(array<U, Size>& value) noexcept : data_(value.data())
    {}
    template <class U, size_t Size,
        enable_if_t<Size == Extent && is_convertible_v<const U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(const array<U, Size>& value) noexcept : data_(value.data())
    {}
    template <class U, size_t OtherExtent,
        enable_if_t<(OtherExtent == Extent || OtherExtent == dynamic_extent) &&
                is_convertible_v<U (*)[], element_type (*)[]>,
            int> = 0>
    CANN_ASC_STL_API constexpr span(const span<U, OtherExtent>& other) noexcept : data_(other.data())
    {
        if constexpr (OtherExtent == dynamic_extent) {
            CANN_ASC_STL_DETAIL_ASSERT(other.size() == Extent, "size mismatch in span's constructor (other span)");
        }
    }
    template <class It, class End,
        enable_if_t<__span_detail::compatible_sentinel<It, End, element_type>::value &&
                !(is_pointer_v<It> && is_pointer_v<End>),
            int> = 0>
    CANN_ASC_STL_API constexpr explicit span(It first, [[maybe_unused]] End last) noexcept : data_(to_address(first))
    {
        CANN_ASC_STL_DETAIL_ASSERT(last - first >= 0 && static_cast<size_type>(last - first) == Extent,
            "size mismatch in span's constructor (iterator, sentinel)");
    }
    template <class Range, enable_if_t<__span_detail::compatible_range<Range, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr explicit span(Range&& range) noexcept : data_(ranges::data(range))
    {
        CANN_ASC_STL_DETAIL_ASSERT(ranges::size(range) == Extent, "size mismatch in span's constructor (range)");
    }
    CANN_ASC_STL_API constexpr iterator begin() const noexcept
    {
        return data_;
    }
    CANN_ASC_STL_API constexpr iterator end() const noexcept
    {
        return data_ + Extent;
    }
    CANN_ASC_STL_API constexpr reverse_iterator rbegin() const noexcept
    {
        return reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr reverse_iterator rend() const noexcept
    {
        return reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr reference front() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(!empty(), "span<T, N>::front() on empty span");
        return data_[0];
    }
    CANN_ASC_STL_API constexpr reference back() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(!empty(), "span<T, N>::back() on empty span");
        return data_[Extent - 1];
    }
    CANN_ASC_STL_API constexpr reference operator[](size_type index) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(index < size(), "span<T, N>::operator[](index): index out of range");
        return data_[index];
    }
    CANN_ASC_STL_API constexpr pointer data() const noexcept
    {
        return data_;
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return Extent;
    }
    CANN_ASC_STL_API constexpr size_type size_bytes() const noexcept
    {
        return Extent * sizeof(T);
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return Extent == 0;
    }
    template <size_t Count>
    CANN_ASC_STL_API constexpr span<T, Count> first() const noexcept
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(Count == 0 ? true : Count <= Extent, "span<T, N>::first<Count>(): Count out of range");
        return {data_, Count};
    }
    CANN_ASC_STL_API constexpr span<T, dynamic_extent> first(size_type count) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(count <= size(), "span<T, N>::first(count): count out of range");
        return {data_, count};
    }
    template <size_t Count>
    CANN_ASC_STL_API constexpr span<T, Count> last() const noexcept
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(Count == 0 ? true : Count <= Extent, "span<T, N>::last<Count>(): Count out of range");
        return {data_ + Extent - Count, Count};
    }
    CANN_ASC_STL_API constexpr span<T, dynamic_extent> last(size_type count) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(count <= size(), "span<T, N>::last(count): count out of range");
        return {data_ + Extent - count, count};
    }
    template <size_t Offset, size_t Count = dynamic_extent>
    CANN_ASC_STL_API constexpr auto subspan() const noexcept
        -> span<T, Count == dynamic_extent ? Extent - Offset : Count>
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(
            Offset == 0 ? true : Offset <= Extent, "span<T, N>::subspan<Offset, Count>(): Offset out of range");
        static_assert(Count == 0 ? true : Count == dynamic_extent || Count <= Extent - Offset,
            "span<T, N>::subspan<Offset, Count>(): Offset + Count out of range");
        return {data_ + Offset, Count == dynamic_extent ? Extent - Offset : Count};
    }
    CANN_ASC_STL_API constexpr span<T, dynamic_extent> subspan(
        size_type offset, size_type count = dynamic_extent) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(offset <= size(), "span<T, N>::subspan(offset, count): offset out of range");
        CANN_ASC_STL_DETAIL_ASSERT(
            count <= size() || count == dynamic_extent, "span<T, N>::subspan(offset, count): count out of range");
        CANN_ASC_STL_DETAIL_ASSERT(count == dynamic_extent || count <= size() - offset,
            "span<T, N>::subspan(offset, count): offset + count out of range");
        return {data_ + offset, count == dynamic_extent ? Extent - offset : count};
    }

private:
    pointer data_{};
};
template <class T>
class span<T, dynamic_extent> {
public:
    using element_type = T;
    using value_type = remove_const_t<T>;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using reference = T&;
    using iterator = pointer;
    using reverse_iterator = ::asc::std::reverse_iterator<iterator>;
    static constexpr size_type extent = dynamic_extent;
    CANN_ASC_STL_API constexpr span() noexcept = default;
    template <class It, enable_if_t<__span_detail::compatible_iterator<It, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr span(It first, size_type count) noexcept : data_(to_address(first)), size_(count)
    {}
    template <class U, size_t Size, enable_if_t<is_convertible_v<U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(U (&array_value)[Size]) noexcept : data_(array_value), size_(Size)
    {}
    template <class U, size_t Size, enable_if_t<is_convertible_v<U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(array<U, Size>& value) noexcept : data_(value.data()), size_(Size)
    {}
    template <class U, size_t Size, enable_if_t<is_convertible_v<const U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(const array<U, Size>& value) noexcept : data_(value.data()), size_(Size)
    {}
    template <class U, size_t OtherExtent, enable_if_t<is_convertible_v<U (*)[], element_type (*)[]>, int> = 0>
    CANN_ASC_STL_API constexpr span(const span<U, OtherExtent>& other) noexcept
        : data_(other.data()), size_(other.size())
    {}
    template <class It, class End,
        enable_if_t<__span_detail::compatible_sentinel<It, End, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr span(It first, End last) noexcept
        : data_(to_address(first)), size_(static_cast<size_type>(last - first))
    {
        CANN_ASC_STL_DETAIL_ASSERT(last - first >= 0, "invalid range in span's constructor (iterator, sentinel)");
    }
    template <class Range, enable_if_t<__span_detail::compatible_range<Range, element_type>::value, int> = 0>
    CANN_ASC_STL_API constexpr span(Range&& range) noexcept
        : data_(ranges::data(range)), size_(static_cast<size_type>(ranges::size(range)))
    {}
    CANN_ASC_STL_API constexpr iterator begin() const noexcept
    {
        return data_;
    }
    CANN_ASC_STL_API constexpr iterator end() const noexcept
    {
        return data_ + size_;
    }
    CANN_ASC_STL_API constexpr reverse_iterator rbegin() const noexcept
    {
        return reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr reverse_iterator rend() const noexcept
    {
        return reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr reference front() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(!empty(), "span<T>::front() on empty span");
        return data_[0];
    }
    CANN_ASC_STL_API constexpr reference back() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(!empty(), "span<T>::back() on empty span");
        return data_[size_ - 1];
    }
    CANN_ASC_STL_API constexpr reference operator[](size_type index) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(index < size(), "span<T>::operator[](index): index out of range");
        return data_[index];
    }
    CANN_ASC_STL_API constexpr pointer data() const noexcept
    {
        return data_;
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return size_;
    }
    CANN_ASC_STL_API constexpr size_type size_bytes() const noexcept
    {
        return size_ * sizeof(T);
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return size_ == 0;
    }
    template <size_t Count>
    CANN_ASC_STL_API constexpr span<T, Count> first() const noexcept
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(Count == 0 ? true : Count <= size(), "span<T>::first<Count>(): Count out of range");
        return {data_, Count};
    }
    CANN_ASC_STL_API constexpr span first(size_type count) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(count <= size(), "span<T>::first(count): count out of range");
        return {data_, count};
    }
    template <size_t Count>
    CANN_ASC_STL_API constexpr span<T, Count> last() const noexcept
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(Count == 0 ? true : Count <= size(), "span<T>::last<Count>(): Count out of range");
        return {data_ + size_ - Count, Count};
    }
    CANN_ASC_STL_API constexpr span last(size_type count) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(count <= size(), "span<T>::last(count): count out of range");
        return {data_ + size_ - count, count};
    }
    template <size_t Offset, size_t Count = dynamic_extent>
    CANN_ASC_STL_API constexpr auto subspan() const noexcept
        -> span<T, Count == dynamic_extent ? dynamic_extent : Count>
    {
        // 三目式避免无符号数与零的无意义比较告警。
        static_assert(Offset == 0 ? true : Offset <= size(), "span<T>::subspan<Offset, Count>(): Offset out of range");
        static_assert(Count == dynamic_extent || (Count == 0 ? true : Count <= size() - Offset),
            "span<T>::subspan<Offset, Count>(): Offset + Count out of range");
        return {data_ + Offset, Count == dynamic_extent ? size_ - Offset : Count};
    }
    CANN_ASC_STL_API constexpr span subspan(size_type offset, size_type count = dynamic_extent) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(offset <= size(), "span<T>::subspan(offset, count): offset out of range");
        CANN_ASC_STL_DETAIL_ASSERT(
            count <= size() || count == dynamic_extent, "span<T>::subspan(offset, count): count out of range");
        CANN_ASC_STL_DETAIL_ASSERT(count == dynamic_extent || count <= size() - offset,
            "span<T>::subspan(offset, count): offset + count out of range");
        return {data_ + offset, count == dynamic_extent ? size_ - offset : count};
    }

private:
    pointer data_{};
    size_type size_{};
};
template <class T, size_t Extent>
CANN_ASC_STL_API constexpr auto as_bytes(
    span<T, Extent> value) noexcept -> span<const byte, Extent == dynamic_extent ? dynamic_extent : Extent * sizeof(T)>
{
    return {reinterpret_cast<const byte*>(value.data()), value.size_bytes()};
}
template <class T, size_t Extent>
CANN_ASC_STL_API constexpr auto as_writable_bytes(
    span<T, Extent> value) noexcept -> span<byte, Extent == dynamic_extent ? dynamic_extent : Extent * sizeof(T)>
{
    static_assert(!is_const_v<T>, "as_writable_bytes requires writable elements");
    return {reinterpret_cast<byte*>(value.data()), value.size_bytes()};
}

// CTAD guides are declarations with the same execution-space contract as
// their constructors. Do not add the inline portion of CANN_ASC_STL_API here.
template <class T, size_t Size>
CANN_ASC_STL_HOST_DEVICE span(T (&)[Size]) -> span<T, Size>;

template <class T, size_t Size>
CANN_ASC_STL_HOST_DEVICE span(array<T, Size>&) -> span<T, Size>;

template <class T, size_t Size>
CANN_ASC_STL_HOST_DEVICE span(const array<T, Size>&) -> span<const T, Size>;

// 整数常量类哨兵/计数推导为固定 extent，否则 dynamic_extent。
template <class EndOrSize, bool = __integral_constant_like_impl<EndOrSize>>
inline constexpr size_t __span_maybe_static_extent = dynamic_extent;
template <class EndOrSize>
inline constexpr size_t __span_maybe_static_extent<EndOrSize, true> = EndOrSize::value;

template <class It, class EndOrSize, enable_if_t<__span_detail::compatible_deduction<It, EndOrSize>::value, int> = 0>
CANN_ASC_STL_HOST_DEVICE span(It,
    EndOrSize) -> span<remove_reference_t<iter_reference_t<It>>, __span_maybe_static_extent<remove_cvref_t<EndOrSize>>>;

template <class Range,
    enable_if_t<__span_detail::compatible_range<Range, remove_reference_t<ranges::range_reference_t<Range>>>::value,
        int> = 0>
CANN_ASC_STL_HOST_DEVICE span(Range&&) -> span<remove_reference_t<ranges::range_reference_t<Range>>>;

namespace ranges {
template <class T, size_t Extent>
inline constexpr bool enable_borrowed_range<span<T, Extent>> = true;

template <class T, size_t Extent>
inline constexpr bool enable_view<span<T, Extent>> = true;
}  // namespace ranges

