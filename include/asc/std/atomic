template <class T>
CANN_ASC_STL_API constexpr T kill_dependency(T value) noexcept
{
    return value;
}

#if CANN_ASC_STL_DETAIL_SIMT_COMPILATION()

CANN_ASC_STL_SIMT_API void atomic_thread_fence(memory_order order) noexcept
{
    if (order == memory_order_relaxed) {
        ::asc::detail::atomic_compiler_barrier();
    } else if (order == memory_order_release) {
        ::asc::detail::atomic_compiler_barrier();
        asc_threadfence();
        ::asc::detail::atomic_compiler_barrier();
    } else {
        // Addressless acquire/consume/acq_rel/seq_cst fences cannot reliably
        // invalidate the consumer SIMT DCache, so the call traps explicitly.
        ::asc::detail::atomic_trap();
    }
}

#elif !CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()

inline void atomic_thread_fence(memory_order order) noexcept
{
    __atomic_thread_fence(static_cast<int>(order));
}

#endif

