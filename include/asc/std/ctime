CANN_ASC_STL_API clock_t clock() noexcept
{
#if defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__)
    return static_cast<clock_t>(::clock64());
#elif defined(__CCE__)
    return static_cast<clock_t>(get_sys_cnt());
#else
    return ::clock();
#endif
}

CANN_ASC_STL_API constexpr double difftime(time_t end, time_t start) noexcept
{
    // Subtract the integer magnitudes before conversion to preserve single ticks
    // near the limits of time_t without overflowing signed arithmetic.
    const auto last = static_cast<__UINTMAX_TYPE__>(end);
    const auto first = static_cast<__UINTMAX_TYPE__>(start);
    const bool negative = end < start;
    const auto delta = negative ? first - last : last - first;
#if CANN_ASC_STL_DETAIL_DEVICE_COMPILATION()
    // AI Core can transport binary64 but has no integer-to-double runtime conversion.
    // Form the sign, biased exponent and significand with round-to-nearest, ties-to-even.
    if (delta == 0) {
        return 0.0;
    }
    const int exponent = 63 - ::asc::std::countl_zero(static_cast<__UINT64_TYPE__>(delta));
    __UINT64_TYPE__ significand = delta;
    if (exponent <= 52) {
        significand <<= 52 - exponent;
    } else {
        const int shift = exponent - 52;
        const auto halfway = static_cast<__UINT64_TYPE__>(1) << (shift - 1);
        const auto discarded = delta & ((halfway << 1) - 1);
        significand >>= shift;
        significand += discarded > halfway || (discarded == halfway && (significand & 1));
    }
    // Adding the implicit leading bit also carries into the exponent on rounding overflow.
    const auto magnitude = (static_cast<__UINT64_TYPE__>(exponent + 1022) << 52) + significand;
    return ::asc::std::bit_cast<double>(magnitude | (static_cast<__UINT64_TYPE__>(negative) << 63));
#else
    return negative ? -static_cast<double>(delta) : static_cast<double>(delta);
#endif
}

#if !defined(__CCE__) && !defined(__NPU_COMPILER_INTERNAL_PURE_SIMT__)
// Wall-clock entry points are Host-only: the device vocabulary provides the
// monotonic clock() counter plus the difftime conversion, while calendar time
// has no counterpart on the AI Core.
CANN_ASC_STL_NODISCARD CANN_ASC_STL_HOST_API time_t time(time_t* timer) noexcept
{
    return ::time(timer);
}

CANN_ASC_STL_NODISCARD CANN_ASC_STL_HOST_API int timespec_get(timespec* ts, int base) noexcept
{
    return ::timespec_get(ts, base);
}
#endif

