#ifndef CANN_ASC_STL_STD_CSTRING
#define CANN_ASC_STL_STD_CSTRING

#include <asc/std/detail/__config>

CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER

#include <asc/std/__cstring/memcpy.h>
#include <asc/std/__cstring/memset.h>
#include <asc/std/__string/constexpr_c_functions.h>
#include <asc/std/cstddef>

#if CANN_ASC_STL_DETAIL_HOSTED()
#include <cstring>
#endif  // CANN_ASC_STL_DETAIL_HOSTED()

CANN_ASC_STL_DETAIL_ACCL_BEGIN_NAMESPACE_ASC_STD

CANN_ASC_STL_API constexpr char* strcpy(
    char* CANN_ASC_STL_DETAIL_RESTRICT __dst, const char* CANN_ASC_STL_DETAIL_RESTRICT __src)
{
    return ::asc::std::__accl_strcpy(__dst, __src);
}

CANN_ASC_STL_API constexpr char* strncpy(
    char* CANN_ASC_STL_DETAIL_RESTRICT __dst, const char* CANN_ASC_STL_DETAIL_RESTRICT __src, size_t __n)
{
    return ::asc::std::__accl_strncpy(__dst, __src, __n);
}

[[nodiscard]] CANN_ASC_STL_API constexpr size_t strlen(const char* __ptr)
{
    return ::asc::std::__accl_strlen(__ptr);
}

[[nodiscard]] CANN_ASC_STL_API constexpr int strcmp(const char* __lhs, const char* __rhs)
{
    return ::asc::std::__accl_strcmp(__lhs, __rhs);
}

[[nodiscard]] CANN_ASC_STL_API constexpr int strncmp(const char* __lhs, const char* __rhs, size_t __n)
{
    return ::asc::std::__accl_strncmp(__lhs, __rhs, __n);
}

[[nodiscard]] CANN_ASC_STL_API constexpr const char* strchr(const char* __ptr, int __c)
{
    return ::asc::std::__accl_strchr<const char>(__ptr, static_cast<char>(__c));
}

[[nodiscard]] CANN_ASC_STL_API constexpr char* strchr(char* __ptr, int __c)
{
    return ::asc::std::__accl_strchr(__ptr, static_cast<char>(__c));
}

[[nodiscard]] CANN_ASC_STL_API constexpr const char* strrchr(const char* __ptr, int __c)
{
    return ::asc::std::__accl_strrchr<const char>(__ptr, static_cast<char>(__c));
}

[[nodiscard]] CANN_ASC_STL_API constexpr char* strrchr(char* __ptr, int __c)
{
    return ::asc::std::__accl_strrchr(__ptr, static_cast<char>(__c));
}

CANN_ASC_STL_API const void* memchr(const void* __ptr, int __c, size_t __n) noexcept
{
    return ::asc::std::__accl_memchr<const unsigned char>(
        reinterpret_cast<const unsigned char*>(__ptr), static_cast<unsigned char>(__c), __n);
}

CANN_ASC_STL_API void* memchr(void* __ptr, int __c, size_t __n) noexcept
{
    return ::asc::std::__accl_memchr(reinterpret_cast<unsigned char*>(__ptr), static_cast<unsigned char>(__c), __n);
}

CANN_ASC_STL_API void* memmove(void* __dst, const void* __src, size_t __n) noexcept
{
    return ::asc::std::__accl_memmove(
        reinterpret_cast<unsigned char*>(__dst), reinterpret_cast<const unsigned char*>(__src), __n);
}

[[nodiscard]] CANN_ASC_STL_API int memcmp(const void* __lhs, const void* __rhs, size_t __n) noexcept
{
    return ::asc::std::__accl_memcmp(
        reinterpret_cast<const unsigned char*>(__lhs), reinterpret_cast<const unsigned char*>(__rhs), __n);
}

CANN_ASC_STL_DETAIL_ACCL_END_NAMESPACE_ASC_STD

#endif  // CANN_ASC_STL_STD_CSTRING
