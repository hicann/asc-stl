#ifndef CANN_ASC_STL_ASC_STD_CSTRING
#define CANN_ASC_STL_ASC_STD_CSTRING

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__detail/attributes.h>
#include <asc/std/__cstring/memcpy.h>
#include <asc/std/__cstring/memset.h>
#include <asc/std/__string/constexpr_c_functions.h>

CANN_ASC_STL_BEGIN_NAMESPACE

using size_t = __SIZE_TYPE__;

CANN_ASC_STL_API constexpr char* strcpy(char* destination, const char* source)
{
    return __asc_strcpy(destination, source);
}
CANN_ASC_STL_API constexpr char* strncpy(char* destination, const char* source, size_t count)
{
    return __asc_strncpy(destination, source, count);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr size_t strlen(const char* value)
{
    return __asc_strlen(value);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr int strcmp(const char* left, const char* right)
{
    return __asc_strcmp(left, right);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr int strncmp(const char* left, const char* right, size_t count)
{
    return __asc_strncmp(left, right, count);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* strchr(const char* value, int character)
{
    return __asc_strchr(value, static_cast<char>(character));
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr char* strchr(char* value, int character)
{
    return __asc_strchr(value, static_cast<char>(character));
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* strrchr(const char* value, int character)
{
    return __asc_strrchr(value, static_cast<char>(character));
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr char* strrchr(char* value, int character)
{
    return __asc_strrchr(value, static_cast<char>(character));
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API const void* memchr(const void* value, int character, size_t count) noexcept
{
    return __asc_memchr(static_cast<const unsigned char*>(value), static_cast<unsigned char>(character), count);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API void* memchr(void* value, int character, size_t count) noexcept
{
    return __asc_memchr(static_cast<unsigned char*>(value), static_cast<unsigned char>(character), count);
}
CANN_ASC_STL_API void* memmove(void* destination, const void* source, size_t count) noexcept
{
    return __asc_memmove(static_cast<unsigned char*>(destination), static_cast<const unsigned char*>(source), count);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API int memcmp(const void* left, const void* right, size_t count) noexcept
{
    return __asc_memcmp(static_cast<const unsigned char*>(left), static_cast<const unsigned char*>(right), count);
}
CANN_ASC_STL_API constexpr char* strcat(char* destination, const char* source) noexcept
{
    __asc_strcpy(destination + __asc_strlen(destination), source);
    return destination;
}
CANN_ASC_STL_API constexpr char* strncat(char* destination, const char* source, size_t count) noexcept
{
    char* output = destination + __asc_strlen(destination);
    size_t index = 0;
    for (; index < count && source[index] != '\0'; ++index) {
        output[index] = source[index];
    }
    output[index] = '\0';
    return destination;
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr size_t strspn(const char* value, const char* accepted) noexcept
{
    size_t count = 0;
    while (value[count] != '\0' && __asc_strchr(accepted, value[count]) != nullptr) {
        ++count;
    }
    return count;
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr size_t strcspn(const char* value, const char* rejected) noexcept
{
    size_t count = 0;
    while (value[count] != '\0' && __asc_strchr(rejected, value[count]) == nullptr) {
        ++count;
    }
    return count;
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* strpbrk(const char* value, const char* accepted) noexcept
{
    return value[strcspn(value, accepted)] == '\0' ? nullptr : value + strcspn(value, accepted);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr char* strpbrk(char* value, const char* accepted) noexcept
{
    return value[strcspn(value, accepted)] == '\0' ? nullptr : value + strcspn(value, accepted);
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* strstr(const char* value, const char* needle) noexcept
{
    if (*needle == '\0') {
        return value;
    }
    for (; *value != '\0'; ++value) {
        if (__asc_strncmp(value, needle, __asc_strlen(needle)) == 0) {
            return value;
        }
    }
    return nullptr;
}
CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr char* strstr(char* value, const char* needle) noexcept
{
    return const_cast<char*>(::asc::std::strstr(static_cast<const char*>(value), needle));
}

CANN_ASC_STL_END_NAMESPACE

#endif  // CANN_ASC_STL_ASC_STD_CSTRING
