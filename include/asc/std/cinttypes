#include <asc/std/__cinttypes/integer_intmax.h>
#ifndef PRIdMAX
#define PRIdMAX "ld"
#endif
#ifndef PRIuMAX
#define PRIuMAX "lu"
#endif

CANN_ASC_STL_BEGIN_NAMESPACE

using intmax_t = __INTMAX_TYPE__;
using uintmax_t = __UINTMAX_TYPE__;
struct imaxdiv_t {
    intmax_t quot;
    intmax_t rem;
};
CANN_ASC_STL_API constexpr intmax_t imaxabs(intmax_t value) noexcept
{
    return value < 0 ? -value : value;
}
CANN_ASC_STL_API constexpr imaxdiv_t imaxdiv(intmax_t numerator, intmax_t denominator) noexcept
{
    return {numerator / denominator, numerator % denominator};
}

CANN_ASC_STL_END_NAMESPACE

#endif  // CANN_ASC_STL_ASC_STD_CINTTYPES
