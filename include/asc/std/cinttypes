#ifndef CANN_ASC_STL_ASC_STD_CINTTYPES
#define CANN_ASC_STL_ASC_STD_CINTTYPES

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

// Facade for the intmax vocabulary: the implementation (intmax_t/uintmax_t/
// imaxdiv_t, imaxabs/imaxdiv) lives in the integer_intmax root; this header
// adds the printf macros only.
// PRIdMAX/PRIuMAX spell "ld"/"lu", which requires intmax_t to be exactly
// long -- the LP64 data model of the product targets (Ascend/Linux). The
// static assertion below locks that assumption at compile time; LLP64 hosts
// would pass a wider intmax_t through a %ld conversion (variadic UB) and
// must be re-adapted deliberately. Note the #ifndef guards also mean a
// system <inttypes.h> included earlier wins for these macros; that is the
// usual include-order caveat, not a silent ABI drift.
#include <asc/std/__cinttypes/integer_intmax.h>
static_assert(sizeof(long) == sizeof(__INTMAX_TYPE__), "PRIdMAX/PRIuMAX \"ld\"/\"lu\" require the LP64 data model");
#ifndef PRIdMAX
#define PRIdMAX "ld"
#endif
#ifndef PRIuMAX
#define PRIuMAX "lu"
#endif

#endif  // CANN_ASC_STL_ASC_STD_CINTTYPES
