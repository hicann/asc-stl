#ifndef CANN_ASC_STL_STD_CSTDINT
#define CANN_ASC_STL_STD_CSTDINT

#include <asc/std/detail/__config>

#include <asc/std/version>

// CANN's AscendC headers use the toolchain-provided <stdint.h> ABI in both
// host preprocessing and AI Core compilation.  Reuse those declarations in
// the freestanding path as well: independently redeclaring the global
// int_fast*_t family from Bisheng's __INT_FAST*_TYPE__ macros is incorrect
// because those builtin types differ from the ABI selected by <stdint.h>.
#if CANN_ASC_STL_DETAIL_HOSTED()
#include <cstdint>
#else
#include <stdint.h>
#endif

CANN_ASC_STL_DETAIL_ACCL_BEGIN_NAMESPACE_ASC_STD

using ::int16_t;
using ::int32_t;
using ::int64_t;
using ::int8_t;
using ::uint16_t;
using ::uint32_t;
using ::uint64_t;
using ::uint8_t;

using ::int_fast16_t;
using ::int_fast32_t;
using ::int_fast64_t;
using ::int_fast8_t;
using ::uint_fast16_t;
using ::uint_fast32_t;
using ::uint_fast64_t;
using ::uint_fast8_t;

using ::int_least16_t;
using ::int_least32_t;
using ::int_least64_t;
using ::int_least8_t;
using ::uint_least16_t;
using ::uint_least32_t;
using ::uint_least64_t;
using ::uint_least8_t;

using ::intptr_t;
using ::uintptr_t;

using ::intmax_t;
using ::uintmax_t;

#if CANN_ASC_STL_DETAIL_HAS_INT128()
using __asc_intmax_t = __int128_t;
using __asc_uintmax_t = __uint128_t;
#else   // ^^^ CANN_ASC_STL_DETAIL_HAS_INT128() ^^^ / vvv !CANN_ASC_STL_DETAIL_HAS_INT128() vvv
using __asc_intmax_t = long long;
using __asc_uintmax_t = unsigned long long;
#endif  // !CANN_ASC_STL_DETAIL_HAS_INT128()

CANN_ASC_STL_DETAIL_ACCL_END_NAMESPACE_ASC_STD

#endif  // CANN_ASC_STL_STD_CSTDINT
