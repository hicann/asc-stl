#ifndef CANN_ASC_STL_ASC_STD_MUTEX
#define CANN_ASC_STL_ASC_STD_MUTEX

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

// This facade ships the lock RAII wrappers and the multi-mutex algorithm
// only (lock_guard, scoped_lock, unique_lock, try_lock, the lock-tag
// vocabulary). It deliberately defines no asc::std::mutex/timed_mutex class:
// the Mutex concept itself is supplied by the caller, matching the
// registered surface -- do not look for a std-style mutex type here.

#include <asc/std/__mutex/lock_guard.h>
#include <asc/std/__mutex/lock_tags.h>
#include <asc/std/__mutex/scoped_lock.h>
#include <asc/std/__mutex/try_lock.h>
#include <asc/std/__mutex/unique_lock.h>

#endif  // CANN_ASC_STL_ASC_STD_MUTEX
