template <class T, size_t Size>
struct array {
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = value_type&;
    using const_reference = const value_type&;
    using pointer = value_type*;
    using const_pointer = const value_type*;
    using iterator = pointer;
    using const_iterator = const_pointer;
    using reverse_iterator = ::asc::std::reverse_iterator<iterator>;
    using const_reverse_iterator = ::asc::std::reverse_iterator<const_iterator>;

    T elements[Size];
    CANN_ASC_STL_API constexpr reference operator[](size_type index) noexcept
    {
        return elements[index];
    }
    CANN_ASC_STL_API constexpr const_reference operator[](size_type index) const noexcept
    {
        return elements[index];
    }
    CANN_ASC_STL_API constexpr reference front() noexcept
    {
        return elements[0];
    }
    CANN_ASC_STL_API constexpr const_reference front() const noexcept
    {
        return elements[0];
    }
    CANN_ASC_STL_API constexpr reference back() noexcept
    {
        return elements[Size - 1];
    }
    CANN_ASC_STL_API constexpr const_reference back() const noexcept
    {
        return elements[Size - 1];
    }
    CANN_ASC_STL_API constexpr pointer data() noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_pointer data() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr iterator begin() noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_iterator begin() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_iterator cbegin() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr iterator end() noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr const_iterator end() const noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr const_iterator cend() const noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return false;
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return Size;
    }
    CANN_ASC_STL_API constexpr size_type max_size() const noexcept
    {
        return Size;
    }
    CANN_ASC_STL_API constexpr void fill(const T& value)
    {
        (void)::asc::std::fill_n(begin(), Size, value);
    }
    CANN_ASC_STL_API constexpr void swap(array& other) noexcept
    {
        (void)::asc::std::swap_ranges(begin(), end(), other.begin());
    }
};
