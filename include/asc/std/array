template <class T, size_t Size>
struct array {
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = value_type&;
    using const_reference = const value_type&;
    using pointer = value_type*;
    using const_pointer = const value_type*;
    using iterator = pointer;
    using const_iterator = const_pointer;
    using reverse_iterator = ::asc::std::reverse_iterator<iterator>;
    using const_reverse_iterator = ::asc::std::reverse_iterator<const_iterator>;

    T elements[Size];
    CANN_ASC_STL_API constexpr reference operator[](size_type index) noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(index < Size, "out-of-bounds access in std::array<T, N>");
        return elements[index];
    }
    CANN_ASC_STL_API constexpr const_reference operator[](size_type index) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(index < Size, "out-of-bounds access in std::array<T, N>");
        return elements[index];
    }
    CANN_ASC_STL_API constexpr reference front() noexcept
    {
        return elements[0];
    }
    CANN_ASC_STL_API constexpr const_reference front() const noexcept
    {
        return elements[0];
    }
    CANN_ASC_STL_API constexpr reference back() noexcept
    {
        return elements[Size - 1];
    }
    CANN_ASC_STL_API constexpr const_reference back() const noexcept
    {
        return elements[Size - 1];
    }
    CANN_ASC_STL_API constexpr pointer data() noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_pointer data() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr iterator begin() noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_iterator begin() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr const_iterator cbegin() const noexcept
    {
        return elements;
    }
    CANN_ASC_STL_API constexpr iterator end() noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr const_iterator end() const noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr const_iterator cend() const noexcept
    {
        return elements + Size;
    }
    CANN_ASC_STL_API constexpr reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return false;
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return Size;
    }
    CANN_ASC_STL_API constexpr size_type max_size() const noexcept
    {
        return Size;
    }
    CANN_ASC_STL_API constexpr void fill(const T& value)
    {
        (void)::asc::std::fill_n(begin(), Size, value);
    }
    // 标准契约：仅当元素交换不抛时 noexcept（无条件 noexcept 会让可抛交换 terminate）。
    CANN_ASC_STL_API constexpr void swap(array& other) noexcept(is_nothrow_swappable_v<T>)
    {
        (void)::asc::std::swap_ranges(begin(), end(), other.begin());
    }
};
template <class T>
struct array<T, 0> {
    using value_type = T;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = value_type&;
    using const_reference = const value_type&;
    using pointer = value_type*;
    using const_pointer = const value_type*;
    using iterator = pointer;
    using const_iterator = const_pointer;
    using reverse_iterator = ::asc::std::reverse_iterator<iterator>;
    using const_reverse_iterator = ::asc::std::reverse_iterator<const_iterator>;
    CANN_ASC_STL_API constexpr reference operator[](size_type) noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::operator[] on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr const_reference operator[](size_type) const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::operator[] on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr reference front() noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::front() on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr const_reference front() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::front() on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr reference back() noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::back() on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr const_reference back() const noexcept
    {
        CANN_ASC_STL_DETAIL_ASSERT(false, "cannot call array<T, 0>::back() on a zero-sized array");
        CANN_ASC_STL_DETAIL_UNREACHABLE();
        return *data();
    }
    CANN_ASC_STL_API constexpr pointer data() noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr const_pointer data() const noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr iterator begin() noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr const_iterator begin() const noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr const_iterator cbegin() const noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr iterator end() noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr const_iterator end() const noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr const_iterator cend() const noexcept
    {
        return nullptr;
    }
    CANN_ASC_STL_API constexpr reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    CANN_ASC_STL_API constexpr reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr const_reverse_iterator crend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    CANN_ASC_STL_API constexpr bool empty() const noexcept
    {
        return true;
    }
    CANN_ASC_STL_API constexpr size_type size() const noexcept
    {
        return 0;
    }
    CANN_ASC_STL_API constexpr size_type max_size() const noexcept
    {
        return 0;
    }
    CANN_ASC_STL_API constexpr void fill(const T&) noexcept
    {
        static_assert(!is_const_v<T>, "cannot fill zero-sized array of type 'const T'");
    }
    CANN_ASC_STL_API constexpr void swap(array&) noexcept
    {
        static_assert(!is_const_v<T>, "cannot swap zero-sized array of type 'const T'");
    }
};
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator==(const array<T, Size>& left, const array<T, Size>& right)
{
    return ::asc::std::equal(left.begin(), left.end(), right.begin());
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator!=(const array<T, Size>& left, const array<T, Size>& right)
{
    return !(left == right);
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator<(const array<T, Size>& left, const array<T, Size>& right)
{
    return ::asc::std::lexicographical_compare(left.begin(), left.end(), right.begin(), right.end());
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator>(const array<T, Size>& left, const array<T, Size>& right)
{
    return right < left;
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator<=(const array<T, Size>& left, const array<T, Size>& right)
{
    return !(right < left);
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr bool operator>=(const array<T, Size>& left, const array<T, Size>& right)
{
    return !(left < right);
}
// CTAD 推导指引：array{v1, v2, ...}（同类型元素包）。
template <class T, class... Args, enable_if_t<(is_same_v<T, Args> && ...), int> = 0>
array(T, Args...) -> array<T, 1 + sizeof...(Args)>;
// 自由 swap：仅元素交换不抛时参与重载。
template <class T, size_t Size, enable_if_t<Size == 0 || is_nothrow_swappable_v<T>, int> = 0>
CANN_ASC_STL_API constexpr void swap(array<T, Size>& left, array<T, Size>& right) noexcept(noexcept(left.swap(right)))
{
    left.swap(right);
}
template <size_t Index, class T, size_t Size>
CANN_ASC_STL_API constexpr T& get(array<T, Size>& value) noexcept
{
    static_assert(Index < Size, "array get index out of bounds");
    return value[Index];
}
template <size_t Index, class T, size_t Size>
CANN_ASC_STL_API constexpr const T& get(const array<T, Size>& value) noexcept
{
    static_assert(Index < Size, "array get index out of bounds");
    return value[Index];
}
template <size_t Index, class T, size_t Size>
CANN_ASC_STL_API constexpr T&& get(array<T, Size>&& value) noexcept
{
    return ::asc::std::move(::asc::std::get<Index>(value));
}
template <size_t Index, class T, size_t Size>
CANN_ASC_STL_API constexpr const T&& get(const array<T, Size>&& value) noexcept
{
    return ::asc::std::move(::asc::std::get<Index>(value));
}
template <class T, size_t Size>
struct tuple_size<array<T, Size>> : integral_constant<size_t, Size> {};
template <size_t Index, class T, size_t Size>
struct tuple_element<Index, array<T, Size>> {
    static_assert(Index < Size, "array tuple_element index out of bounds");
    using type = T;
};
// 直接花括号构造（经索引序列），不要求元素可默认构造。
template <class T, size_t Size, size_t... Index>
CANN_ASC_STL_API constexpr array<remove_cv_t<T>, Size> __to_array_lvalue_impl(
    T (&source)[Size], index_sequence<Index...>)
{
    return {{source[Index]...}};
}
template <class T, size_t Size, size_t... Index>
CANN_ASC_STL_API constexpr array<remove_cv_t<T>, Size> __to_array_rvalue_impl(
    T (&&source)[Size], index_sequence<Index...>)
{
    return {{::asc::std::move(source[Index])...}};
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr array<remove_cv_t<T>, Size> to_array(T (&source)[Size]) noexcept(
    is_nothrow_constructible_v<T, T&>)
{
    static_assert(!is_array_v<T>, "to_array does not accept multidimensional arrays");
    static_assert(is_constructible_v<T, T&>, "to_array requires copy constructible elements");
    return ::asc::std::__to_array_lvalue_impl(source, make_index_sequence<Size>());
}
template <class T, size_t Size>
CANN_ASC_STL_API constexpr array<remove_cv_t<T>, Size> to_array(T (&&source)[Size]) noexcept(
    is_nothrow_move_constructible_v<T>)
{
    static_assert(!is_array_v<T>, "to_array does not accept multidimensional arrays");
    static_assert(is_move_constructible_v<T>, "to_array requires move constructible elements");
    return ::asc::std::__to_array_rvalue_impl(::asc::std::move(source), make_index_sequence<Size>());
}

