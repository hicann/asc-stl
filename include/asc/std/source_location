#ifndef CANN_ASC_STL_STD_SOURCE_LOCATION
#define CANN_ASC_STL_STD_SOURCE_LOCATION

#include <asc/std/detail/__config>

CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER

#include <asc/std/cstdint>
#include <asc/std/version>

#if CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FILE) || CANN_ASC_STL_DETAIL_COMPILER(GCC) || \
    CANN_ASC_STL_DETAIL_COMPILER(MSVC, >=, 19, 27)
#define CANN_ASC_STL_DETAIL_BUILTIN_FILE() __builtin_FILE()
#else  // ^^^ CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FILE) ^^^ / vvv !CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FILE)
       // vvv
#define CANN_ASC_STL_DETAIL_BUILTIN_FILE() __FILE__
#endif  // !CANN_ASC_STL_DETAIL_BUILTIN_FILE

#if CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FUNCTION) || CANN_ASC_STL_DETAIL_COMPILER(GCC) || \
    CANN_ASC_STL_DETAIL_COMPILER(MSVC, >=, 19, 27)
#define CANN_ASC_STL_DETAIL_BUILTIN_FUNCTION() __builtin_FUNCTION()
#else  // ^^^ CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FUNCTION) ^^^ / vvv
       // !CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_FUNCTION) vvv
#define CANN_ASC_STL_DETAIL_BUILTIN_FUNCTION() "__builtin_FUNCTION is unsupported"
#endif  // !CANN_ASC_STL_DETAIL_BUILTIN_FUNCTION

#if CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_LINE) || CANN_ASC_STL_DETAIL_COMPILER(GCC) || \
    CANN_ASC_STL_DETAIL_COMPILER(MSVC, >=, 19, 27)
#define CANN_ASC_STL_DETAIL_BUILTIN_LINE() __builtin_LINE()
#else  // ^^^ CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_LINE) ^^^ / vvv !CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_LINE)
       // vvv
#define CANN_ASC_STL_DETAIL_BUILTIN_LINE() __LINE__
#endif  // !CANN_ASC_STL_DETAIL_BUILTIN_LINE

#if CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_COLUMN) || CANN_ASC_STL_DETAIL_COMPILER(MSVC, >=, 19, 27)
#define CANN_ASC_STL_DETAIL_BUILTIN_COLUMN() __builtin_COLUMN()
#else  // ^^^ CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_COLUMN) ^^^ / vvv
       // !CANN_ASC_STL_DETAIL_HAS_BUILTIN(__builtin_COLUMN) vvv
#define CANN_ASC_STL_DETAIL_BUILTIN_COLUMN() 0
#endif  // !CANN_ASC_STL_DETAIL_BUILTIN_COLUMN

CANN_ASC_STL_DETAIL_ACCL_BEGIN_NAMESPACE_ASC_STD

//! NOTE: we cannot use `__builtin_source_location` as that requires us to use `::std::source_location::impl`
class source_location {
private:
    const char* __file_name_ = "";
    const char* __function_name_ = "";
    uint_least32_t __line_ = 0;
    uint_least32_t __column_ = 0;

    // Needed to make C++11 happy
    CANN_ASC_STL_API explicit constexpr source_location(
        const char* __file, const char* __func, uint_least32_t __line, uint_least32_t __column) noexcept
        : __file_name_(__file), __function_name_(__func), __line_(__line), __column_(__column)
    {}

public:
    [[nodiscard]] CANN_ASC_STL_API static constexpr source_location current(
        const char* __file = CANN_ASC_STL_DETAIL_BUILTIN_FILE(),
        const char* __func = CANN_ASC_STL_DETAIL_BUILTIN_FUNCTION(),
        uint_least32_t __line = CANN_ASC_STL_DETAIL_BUILTIN_LINE(),
        uint_least32_t __column = CANN_ASC_STL_DETAIL_BUILTIN_COLUMN()) noexcept
    {
        return source_location{__file, __func, __line, __column};
    }

    CANN_ASC_STL_DETAIL_HIDE_FROM_ABI constexpr source_location() = default;

    [[nodiscard]] CANN_ASC_STL_API constexpr uint_least32_t line() const noexcept
    {
        return __line_;
    }
    [[nodiscard]] CANN_ASC_STL_API constexpr uint_least32_t column() const noexcept
    {
        return __column_;
    }
    [[nodiscard]] CANN_ASC_STL_API constexpr const char* file_name() const noexcept
    {
        return __file_name_;
    }
    [[nodiscard]] CANN_ASC_STL_API constexpr const char* function_name() const noexcept
    {
        return __function_name_;
    }
};

CANN_ASC_STL_DETAIL_ACCL_END_NAMESPACE_ASC_STD

#endif  // CANN_ASC_STL_STD_SOURCE_LOCATION
