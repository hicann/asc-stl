#ifndef CANN_ASC_STL_STD_SOURCE_LOCATION
#define CANN_ASC_STL_STD_SOURCE_LOCATION

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__detail/attributes.h>
#include <asc/std/cstdint>
#include <asc/std/version>

CANN_ASC_STL_BEGIN_NAMESPACE

class source_location {
private:
    const char* file_name_ = "";
    const char* function_name_ = "";
    uint_least32_t line_ = 0;
    uint_least32_t column_ = 0;

    CANN_ASC_STL_API explicit constexpr source_location(
        const char* file_name, const char* function_name, uint_least32_t line, uint_least32_t column) noexcept
        : file_name_(file_name), function_name_(function_name), line_(line), column_(column)
    {}

public:
    CANN_ASC_STL_NODISCARD CANN_ASC_STL_API static constexpr source_location current(
        const char* file_name = CANN_ASC_STL_DETAIL_BUILTIN_FILE(),
        const char* function_name = CANN_ASC_STL_DETAIL_BUILTIN_FUNCTION(),
        uint_least32_t line = CANN_ASC_STL_DETAIL_BUILTIN_LINE(),
        uint_least32_t column = CANN_ASC_STL_DETAIL_BUILTIN_COLUMN()) noexcept
    {
        return source_location(file_name, function_name, line, column);
    }

    constexpr source_location() noexcept = default;

    CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr uint_least32_t line() const noexcept
    {
        return line_;
    }

    CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr uint_least32_t column() const noexcept
    {
        return column_;
    }

    CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* file_name() const noexcept
    {
        return file_name_;
    }

    CANN_ASC_STL_NODISCARD CANN_ASC_STL_API constexpr const char* function_name() const noexcept
    {
        return function_name_;
    }
};

CANN_ASC_STL_END_NAMESPACE

#endif  // CANN_ASC_STL_STD_SOURCE_LOCATION
