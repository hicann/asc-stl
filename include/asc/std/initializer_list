#ifndef CANN_ASC_STL_STD_INITIALIZER_LIST
#define CANN_ASC_STL_STD_INITIALIZER_LIST

#include <asc/std/detail/__config>

// Bisheng/CCE implements list-initialization against the ABI definition from
// the C++ standard header. CANN exposes no public built-in initializer_list
// header or marker, so the standard header remains a compiler dependency in
// hosted and CCE/freestanding translation units.
#include <initializer_list>

CANN_ASC_STL_DETAIL_ACCL_BEGIN_NAMESPACE_ASC_STD

using ::std::initializer_list;

template <class _Tp>
inline constexpr bool __is_asc_std_initializer_list = false;

template <class _Ep>
inline constexpr bool __is_asc_std_initializer_list<initializer_list<_Ep>> = true;

CANN_ASC_STL_DETAIL_ACCL_END_NAMESPACE_ASC_STD

#endif  // CANN_ASC_STL_STD_INITIALIZER_LIST
