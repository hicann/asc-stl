#if defined(CANN_ASC_STL_HAS_DLPACK)
namespace detail {

template <class Element>
inline constexpr bool dlpack_dtype_supported =
    __is_same(Element, float) || __is_same(Element, double) || __is_same(Element, signed char) ||
    __is_same(Element, unsigned char) || __is_same(Element, short) || __is_same(Element, unsigned short) ||
    __is_same(Element, int) || __is_same(Element, unsigned int) || __is_same(Element, long) ||
    __is_same(Element, unsigned long) || __is_same(Element, long long) || __is_same(Element, unsigned long long);

template <class Element>
CANN_ASC_STL_HOST constexpr DLDataType dlpack_dtype() noexcept
{
    constexpr uint8_t code = __is_same(Element, float) || __is_same(Element, double) ?
        kDLFloat :
        (__is_same(Element, signed char) || __is_same(Element, short) || __is_same(Element, int) ||
                    __is_same(Element, long) || __is_same(Element, long long) ?
                kDLInt :
                kDLUInt);
    return DLDataType{code, static_cast<uint8_t>(sizeof(Element) * 8), 1};
}

template <class Element>
CANN_ASC_STL_HOST constexpr bool dlpack_dtype_matches(const DLDataType& dtype) noexcept
{
    const DLDataType expected = dlpack_dtype<Element>();
    return dtype.code == expected.code && dtype.bits == expected.bits && dtype.lanes == expected.lanes;
}

template <class Extents>
CANN_ASC_STL_HOST constexpr __PTRDIFF_TYPE__ dlpack_stride(
    const Extents& extents, const DLTensor& tensor, __SIZE_TYPE__ index) noexcept
{
    if (tensor.strides != nullptr)
        return static_cast<__PTRDIFF_TYPE__>(tensor.strides[index]);
    __PTRDIFF_TYPE__ result = 1;
    for (__SIZE_TYPE__ i = Extents::rank(); i > index + 1; --i)
        result *= static_cast<__PTRDIFF_TYPE__>(extents.extent(i - 1));
    return result;
}

// Validate signed reach before building a mapping. Rebasing the handle by
// origin keeps every mapped index nonnegative for the standard accessor.
template <class Extents>
CANN_ASC_STL_HOST constexpr bool dlpack_mapping_origin(
    const Extents& extents, const DLTensor& tensor, __PTRDIFF_TYPE__& origin) noexcept
{
    unsigned long long below = 0;
    unsigned long long above = 0;
    for (__SIZE_TYPE__ i = 0; i < Extents::rank(); ++i) {
        if (tensor.strides == nullptr) {
            unsigned long long stride = 1;
            for (__SIZE_TYPE__ j = Extents::rank(); j > i + 1; --j) {
                const auto extent = static_cast<unsigned long long>(extents.extent(j - 1));
                if (stride != 0 && extent > static_cast<unsigned long long>(__PTRDIFF_MAX__) / stride)
                    return false;
                stride *= extent;
            }
        } else if (tensor.strides[i] > __PTRDIFF_MAX__ || tensor.strides[i] < -__PTRDIFF_MAX__ - 1) {
            return false;
        }
        const __PTRDIFF_TYPE__ stride = dlpack_stride(extents, tensor, i);
        const unsigned long long magnitude =
            stride < 0 ? static_cast<unsigned long long>(-(stride + 1)) + 1 : static_cast<unsigned long long>(stride);
        const unsigned long long reach =
            extents.extent(i) == 0 ? 0 : static_cast<unsigned long long>(extents.extent(i) - 1);
        if (magnitude != 0 && reach > static_cast<unsigned long long>(__PTRDIFF_MAX__) / magnitude)
            return false;
        const unsigned long long contribution = reach * magnitude;
        if (contribution > static_cast<unsigned long long>(__PTRDIFF_MAX__) - below - above)
            return false;
        if (stride < 0)
            below += contribution;
        else
            above += contribution;
    }
    origin = static_cast<__PTRDIFF_TYPE__>(below);
    return true;
}

template <class Mapping>
CANN_ASC_STL_HOST constexpr auto mdspan_origin_offset(
    const Mapping& mapping, int) noexcept -> decltype(mapping.offset())
{
    return mapping.offset();
}

template <class Mapping>
CANN_ASC_STL_HOST constexpr __PTRDIFF_TYPE__ mdspan_origin_offset(const Mapping&, long) noexcept
{
    return 0;
}

template <class Extents, __SIZE_TYPE__... I>
CANN_ASC_STL_HOST constexpr auto make_dlpack_mapping(
    const Extents& extents, const DLTensor& tensor, __PTRDIFF_TYPE__ origin, asc::std::index_sequence<I...>) noexcept
{
    using stride_type = asc::steps<Extents::rank()>;
    return asc::layout_stride_relaxed::mapping<Extents, stride_type>(
        extents, stride_type(dlpack_stride(extents, tensor, I)...), origin);
}

}  // namespace detail

template <__SIZE_TYPE__ Rank>
class dlpack_tensor {
public:
    CANN_ASC_STL_HOST constexpr dlpack_tensor() noexcept = default;
    CANN_ASC_STL_HOST DLTensor get() const noexcept
    {
        DLTensor result = tensor_;
        result.shape = Rank == 0 ? nullptr : const_cast<int64_t*>(shape_);
        result.strides = Rank == 0 ? nullptr : const_cast<int64_t*>(strides_);
        return result;
    }
    int64_t shape_[Rank == 0 ? 1 : Rank]{};
    int64_t strides_[Rank == 0 ? 1 : Rank]{};
    DLTensor tensor_{};
};

template <class Element, __SIZE_TYPE__ Rank, class Layout = layout_stride_relaxed>
CANN_ASC_STL_HOST bool to_host_mdspan(
    const DLTensor& tensor, host_mdspan<Element, asc::std::dextents<asc::std::size_t, Rank>, Layout>& output) noexcept
{
    if (tensor.device.device_type != kDLCPU || tensor.ndim != static_cast<int>(Rank) ||
        (Rank != 0 && tensor.shape == nullptr) || !detail::dlpack_dtype_supported<Element> ||
        !detail::dlpack_dtype_matches<Element>(tensor.dtype) || tensor.data == nullptr ||
        tensor.byte_offset % alignof(Element) != 0)
        return false;
    asc::std::array<asc::std::size_t, Rank> extents{};
    for (__SIZE_TYPE__ i = 0; i < Rank; ++i) {
        if (tensor.shape[i] < 0)
            return false;
        extents[i] = static_cast<asc::std::size_t>(tensor.shape[i]);
    }
    using extents_type = asc::std::dextents<asc::std::size_t, Rank>;
    const extents_type converted_extents(extents);
    __PTRDIFF_TYPE__ origin = 0;
    if (!detail::dlpack_mapping_origin(converted_extents, tensor, origin) ||
        tensor.byte_offset > static_cast<unsigned long long>(__PTRDIFF_MAX__))
        return false;
    const auto mapping =
        detail::make_dlpack_mapping(converted_extents, tensor, origin, asc::std::make_index_sequence<Rank>{});
    auto* data = reinterpret_cast<Element*>(static_cast<unsigned char*>(tensor.data) + tensor.byte_offset) - origin;
    output = host_mdspan<Element, extents_type, Layout>(data, mapping);
    return true;
}

template <class Element, __SIZE_TYPE__ Rank, class Layout = layout_stride_relaxed>
CANN_ASC_STL_HOST bool to_gm_mdspan(
    const DLTensor& tensor, gm_mdspan<Element, asc::std::dextents<asc::std::size_t, Rank>, Layout>& output) noexcept
{
    if (tensor.device.device_type != kDLExtDev || tensor.ndim != static_cast<int>(Rank) ||
        (Rank != 0 && tensor.shape == nullptr) || !detail::dlpack_dtype_supported<Element> ||
        !detail::dlpack_dtype_matches<Element>(tensor.dtype) || tensor.data == nullptr ||
        tensor.byte_offset % alignof(Element) != 0)
        return false;
    asc::std::array<asc::std::size_t, Rank> extents{};
    for (__SIZE_TYPE__ i = 0; i < Rank; ++i) {
        if (tensor.shape[i] < 0)
            return false;
        extents[i] = static_cast<asc::std::size_t>(tensor.shape[i]);
    }
    using extents_type = asc::std::dextents<asc::std::size_t, Rank>;
    const extents_type converted_extents(extents);
    __PTRDIFF_TYPE__ origin = 0;
    if (!detail::dlpack_mapping_origin(converted_extents, tensor, origin) ||
        tensor.byte_offset > static_cast<unsigned long long>(__PTRDIFF_MAX__))
        return false;
    const auto mapping =
        detail::make_dlpack_mapping(converted_extents, tensor, origin, asc::std::make_index_sequence<Rank>{});
    auto* data = reinterpret_cast<Element*>(static_cast<unsigned char*>(tensor.data) + tensor.byte_offset) - origin;
    output = gm_mdspan<Element, extents_type, Layout>(data, mapping);
    return true;
}

template <class Element, class Extents, class Layout, class Accessor>
CANN_ASC_STL_HOST bool to_dlpack_tensor(const asc::std::mdspan<Element, Extents, Layout, Accessor>& view,
    DLDeviceType device_type, int device_id, dlpack_tensor<Extents::rank()>& output) noexcept
{
    if (!detail::dlpack_dtype_supported<Element> || view.data_handle() == nullptr ||
        (device_type != kDLCPU && device_type != kDLExtDev))
        return false;
    // DLPack data denotes logical index zero, including a relaxed mapping's
    // origin. Its shape/strides continue to borrow only the holder metadata.
    output.tensor_.data = const_cast<void*>(
        static_cast<const void*>(view.data_handle() + detail::mdspan_origin_offset(view.mapping(), 0)));
    output.tensor_.device = DLDevice{device_type, device_id};
    output.tensor_.ndim = static_cast<int>(Extents::rank());
    output.tensor_.dtype = detail::dlpack_dtype<Element>();
    output.tensor_.byte_offset = 0;
    for (__SIZE_TYPE__ i = 0; i < Extents::rank(); ++i) {
        output.shape_[i] = static_cast<int64_t>(view.extent(i));
        output.strides_[i] = static_cast<int64_t>(view.stride(i));
    }
    return true;
}
