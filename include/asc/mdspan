inline constexpr __PTRDIFF_TYPE__ dynamic_stride = -__PTRDIFF_MAX__ - 1;

template <class OffsetType, __PTRDIFF_TYPE__... StaticStrides>
class strides {
public:
    using offset_type = OffsetType;
    using size_type = __SIZE_TYPE__;
    using rank_type = __SIZE_TYPE__;

    CANN_ASC_STL_API constexpr strides() noexcept
    {
        const __PTRDIFF_TYPE__ values[rank() == 0 ? 1 : rank()] = {StaticStrides...};
        for (rank_type i = 0; i < rank(); ++i) {
            values_[i] = values[i] == dynamic_stride ? offset_type{} : static_cast<offset_type>(values[i]);
        }
    }

    template <class... Values>
    CANN_ASC_STL_API constexpr explicit strides(Values... values) noexcept
    {
        static_assert(sizeof...(Values) == rank() || sizeof...(Values) == rank_dynamic(),
            "strides construction requires rank() or rank_dynamic() values");
        const offset_type supplied[sizeof...(Values) == 0 ? 1 : sizeof...(Values)] = {
            static_cast<offset_type>(values)...};
        const __PTRDIFF_TYPE__ declared[rank() == 0 ? 1 : rank()] = {StaticStrides...};
        rank_type dynamic_index = 0;
        for (rank_type i = 0; i < rank(); ++i) {
            values_[i] = declared[i] == dynamic_stride ? supplied[sizeof...(Values) == rank() ? i : dynamic_index++] :
                                                         static_cast<offset_type>(declared[i]);
        }
    }

    CANN_ASC_STL_API static constexpr rank_type rank() noexcept
    {
        return sizeof...(StaticStrides);
    }
    CANN_ASC_STL_API static constexpr rank_type rank_dynamic() noexcept
    {
        const __PTRDIFF_TYPE__ values[rank() == 0 ? 1 : rank()] = {StaticStrides...};
        rank_type count = 0;
        for (rank_type i = 0; i < rank(); ++i)
            count += values[i] == dynamic_stride ? 1 : 0;
        return count;
    }
    CANN_ASC_STL_API static constexpr __PTRDIFF_TYPE__ static_stride(rank_type index) noexcept
    {
        const __PTRDIFF_TYPE__ values[rank() == 0 ? 1 : rank()] = {StaticStrides...};
        return values[index];
    }
    CANN_ASC_STL_API constexpr offset_type stride(rank_type index) const noexcept
    {
        return values_[index];
    }

private:
    offset_type values_[rank() == 0 ? 1 : rank()]{};
};

namespace detail {

template <class OffsetType, class Sequence>
struct make_dstrides_sequence;

template <class OffsetType, __SIZE_TYPE__... I>
struct make_dstrides_sequence<OffsetType, asc::std::index_sequence<I...>> {
    using type = strides<OffsetType, (static_cast<void>(I), dynamic_stride)...>;
};

template <class OffsetType, __SIZE_TYPE__ Rank>
struct make_dstrides {
    using type = typename make_dstrides_sequence<OffsetType, asc::std::make_index_sequence<Rank>>::type;
};

}  // namespace detail

template <class OffsetType, __SIZE_TYPE__ Rank>
using dstrides = typename detail::make_dstrides<OffsetType, Rank>::type;

template <__SIZE_TYPE__ Rank, class OffsetType = __PTRDIFF_TYPE__>
using steps = dstrides<OffsetType, Rank>;

struct layout_stride_relaxed {
    template <class Extents, class Strides = dstrides<__PTRDIFF_TYPE__, Extents::rank()>,
        class OffsetType = __PTRDIFF_TYPE__>
    class mapping {
    public:
        using extents_type = Extents;
        using strides_type = Strides;
        using index_type = typename Extents::index_type;
        using size_type = typename Extents::size_type;
        using rank_type = typename Extents::rank_type;
        using offset_type = OffsetType;
        using layout_type = layout_stride_relaxed;

        CANN_ASC_STL_API constexpr mapping() noexcept = default;
        CANN_ASC_STL_API constexpr mapping(
            const Extents& extents, const Strides& stride_values, OffsetType offset = 0) noexcept
            : extents_(extents), strides_(stride_values), offset_(offset)
        {}

        template <class OtherMapping>
        CANN_ASC_STL_API constexpr explicit mapping(const OtherMapping& other) noexcept
            : extents_(other.extents()), strides_(make_strides(other)), offset_(0)
        {}

        template <class... Indices>
        CANN_ASC_STL_API constexpr offset_type operator()(Indices... indices) const noexcept
        {
            static_assert(sizeof...(Indices) == Extents::rank(), "incorrect mdspan rank");
            const offset_type supplied[Extents::rank() == 0 ? 1 : Extents::rank()] = {
                static_cast<offset_type>(indices)...};
            offset_type result = offset_;
            for (rank_type i = 0; i < Extents::rank(); ++i)
                result += supplied[i] * strides_.stride(i);
            return result;
        }

        CANN_ASC_STL_API constexpr const Extents& extents() const noexcept
        {
            return extents_;
        }
        CANN_ASC_STL_API constexpr const Strides& strides() const noexcept
        {
            return strides_;
        }
        CANN_ASC_STL_API constexpr offset_type offset() const noexcept
        {
            return offset_;
        }
        CANN_ASC_STL_API constexpr offset_type stride(rank_type index) const noexcept
        {
            return strides_.stride(index);
        }
        CANN_ASC_STL_API constexpr size_type required_span_size() const noexcept
        {
            offset_type low = offset_;
            offset_type high = offset_;
            for (rank_type i = 0; i < Extents::rank(); ++i) {
                if (extents_.extent(i) == 0)
                    return 0;
                const offset_type delta = static_cast<offset_type>(extents_.extent(i) - 1) * stride(i);
                if (delta < 0)
                    low += delta;
                else
                    high += delta;
            }
            return static_cast<size_type>(high - low + 1);
        }
        CANN_ASC_STL_API static constexpr bool is_always_unique() noexcept
        {
            return false;
        }
        CANN_ASC_STL_API static constexpr bool is_always_exhaustive() noexcept
        {
            return false;
        }
        CANN_ASC_STL_API static constexpr bool is_always_strided() noexcept
        {
            return true;
        }
        CANN_ASC_STL_API constexpr bool is_unique() const noexcept
        {
            offset_type deltas[Extents::rank() == 0 ? 1 : Extents::rank()]{};
            offset_type limits[Extents::rank() == 0 ? 1 : Extents::rank()]{};
            for (rank_type i = 0; i < Extents::rank(); ++i) {
                if (extents_.extent(i) == 0)
                    return true;
                limits[i] = static_cast<offset_type>(extents_.extent(i) - 1);
                deltas[i] = -limits[i];
            }
            for (;;) {
                offset_type difference = 0;
                bool changed = false;
                for (rank_type i = 0; i < Extents::rank(); ++i) {
                    difference += deltas[i] * stride(i);
                    changed = changed || deltas[i] != 0;
                }
                if (changed && difference == 0)
                    return false;
                bool advanced = false;
                for (rank_type i = Extents::rank(); i > 0; --i) {
                    if (deltas[i - 1] < limits[i - 1]) {
                        ++deltas[i - 1];
                        advanced = true;
                        break;
                    }
                    deltas[i - 1] = -limits[i - 1];
                }
                if (!advanced)
                    return true;
            }
        }
        CANN_ASC_STL_API constexpr bool is_exhaustive() const noexcept
        {
            return false;
        }
        CANN_ASC_STL_API constexpr bool is_strided() const noexcept
        {
            return true;
        }

    private:
        template <class OtherMapping, __SIZE_TYPE__... I>
        CANN_ASC_STL_API static constexpr Strides make_strides_impl(
            const OtherMapping& other, asc::std::index_sequence<I...>) noexcept
        {
            return Strides(other.stride(I)...);
        }
        template <class OtherMapping>
        CANN_ASC_STL_API static constexpr Strides make_strides(const OtherMapping& other) noexcept
        {
            return make_strides_impl(other, asc::std::make_index_sequence<Extents::rank()>{});
        }
        Extents extents_{};
        Strides strides_{};
        OffsetType offset_{};
    };
};

