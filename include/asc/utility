#ifndef CANN_ASC_STL_ASC_UTILITY
#define CANN_ASC_STL_ASC_UTILITY

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__utility/static_for.h>

namespace asc {

template <class T>
CANN_ASC_STL_API constexpr bool in_range(T value, T first, T last) noexcept
{
    return value >= first && value <= last;
}

template <class SizeType, SizeType Size, class Operator, class... Args>
CANN_ASC_STL_API constexpr void static_for(Operator operation, Args&&... args) noexcept(
    noexcept(detail::static_for_count<SizeType, Size>(operation, static_cast<Args&&>(args)...)))
{
    detail::static_for_count<SizeType, Size>(operation, static_cast<Args&&>(args)...);
}

template <class IndexType, IndexType Start, IndexType End, IndexType Step = IndexType{1}, class Operator, class... Args>
CANN_ASC_STL_API constexpr void static_for(Operator operation, Args&&... args) noexcept(
    noexcept(detail::static_for_range<IndexType, Start, End, Step>(operation, static_cast<Args&&>(args)...)))
{
    detail::static_for_range<IndexType, Start, End, Step>(operation, static_cast<Args&&>(args)...);
}

template <auto Size, class Operator, class... Args>
CANN_ASC_STL_API constexpr void static_for(Operator operation, Args&&... args) noexcept(
    noexcept(asc::static_for<decltype(Size), Size>(operation, static_cast<Args&&>(args)...)))
{
    asc::static_for<decltype(Size), Size>(operation, static_cast<Args&&>(args)...);
}

template <auto Start, decltype(Start) End, decltype(Start) Step = decltype(Start){1}, class Operator, class... Args>
CANN_ASC_STL_API constexpr void static_for(Operator operation, Args&&... args) noexcept(
    noexcept(asc::static_for<decltype(Start), Start, End, Step>(operation, static_cast<Args&&>(args)...)))
{
    asc::static_for<decltype(Start), Start, End, Step>(operation, static_cast<Args&&>(args)...);
}

}  // namespace asc

#endif  // CANN_ASC_STL_ASC_UTILITY
