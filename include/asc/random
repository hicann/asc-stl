#define CANN_ASC_STL_ASC_RANDOM

#include <asc/__config>

#if defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_GCC)
#pragma GCC system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_CLANG)
#pragma clang system_header
#elif defined(CANN_ASC_STL_DETAIL_IMPLICIT_SYSTEM_HEADER_MSVC)
#pragma system_header
#endif

#include <asc/__random/pcg64.h>

namespace asc {

template <detail::random_uint64 AHigh, detail::random_uint64 ALow, detail::random_uint64 CHigh,
    detail::random_uint64 CLow>
class pcg64_engine {
public:
    using result_type = detail::random_uint64;
    static constexpr result_type default_seed = 0xcafef00dd15ea5e5ULL;

    CANN_ASC_STL_API constexpr pcg64_engine() noexcept
    {
        seed();
    }
    CANN_ASC_STL_API constexpr explicit pcg64_engine(result_type seed_value) noexcept
    {
        seed(seed_value);
    }

    CANN_ASC_STL_API static constexpr result_type min() noexcept
    {
        return 0;
    }
    CANN_ASC_STL_API static constexpr result_type max() noexcept
    {
        return ~result_type{0};
    }

    CANN_ASC_STL_API constexpr void seed(result_type seed_value = default_seed) noexcept
    {
        state_ = detail::multiply(detail::add(detail::random_uint128(seed_value), increment()), multiplier());
        state_ = detail::add(state_, increment());
    }

    CANN_ASC_STL_API constexpr result_type operator()() noexcept
    {
        state_ = detail::add(detail::multiply(state_, multiplier()), increment());
        return detail::rotate_right(state_.low ^ state_.high, static_cast<unsigned int>(state_.high >> 58U));
    }

    CANN_ASC_STL_API constexpr void discard(unsigned long long count) noexcept
    {
        detail::random_uint128 accumulated_multiplier(1);
        detail::random_uint128 accumulated_increment(0);
        detail::random_uint128 current_multiplier = multiplier();
        detail::random_uint128 current_increment = increment();
        while (count != 0) {
            if ((count & 1U) != 0) {
                accumulated_multiplier = detail::multiply(accumulated_multiplier, current_multiplier);
                accumulated_increment =
                    detail::add(detail::multiply(accumulated_increment, current_multiplier), current_increment);
            }
            current_increment =
                detail::multiply(detail::add(current_multiplier, detail::random_uint128(1)), current_increment);
            current_multiplier = detail::multiply(current_multiplier, current_multiplier);
            count >>= 1U;
        }
        state_ = detail::add(detail::multiply(state_, accumulated_multiplier), accumulated_increment);
    }

    CANN_ASC_STL_API constexpr bool equal_state(const pcg64_engine& other) const noexcept
    {
        return detail::equal(state_, other.state_);
    }

private:
    CANN_ASC_STL_API static constexpr detail::random_uint128 multiplier() noexcept
    {
        return {AHigh, ALow};
    }
    CANN_ASC_STL_API static constexpr detail::random_uint128 increment() noexcept
    {
        return {CHigh, CLow};
    }

    detail::random_uint128 state_{};
};

template <detail::random_uint64 AHigh, detail::random_uint64 ALow, detail::random_uint64 CHigh,
    detail::random_uint64 CLow>
CANN_ASC_STL_API constexpr bool operator==(
    const pcg64_engine<AHigh, ALow, CHigh, CLow>& left, const pcg64_engine<AHigh, ALow, CHigh, CLow>& right) noexcept
{
    return left.equal_state(right);
}

template <detail::random_uint64 AHigh, detail::random_uint64 ALow, detail::random_uint64 CHigh,
    detail::random_uint64 CLow>
CANN_ASC_STL_API constexpr bool operator!=(
    const pcg64_engine<AHigh, ALow, CHigh, CLow>& left, const pcg64_engine<AHigh, ALow, CHigh, CLow>& right) noexcept
{
    return !(left == right);
}

using pcg64 =
    pcg64_engine<2549297995355413924ULL, 4865540595714422341ULL, 6364136223846793005ULL, 1442695040888963407ULL>;

template <class Index = detail::random_uint64, class Bijection = detail::feistel_bijection<Index>>
class random_bijection {
public:
    using index_type = Index;

    CANN_ASC_STL_API constexpr random_bijection() noexcept : bijection_(), size_(0)
    {}

    template <class RNG>
    CANN_ASC_STL_API constexpr random_bijection(Index size_value, RNG&& generator) noexcept
        : bijection_(size_value, static_cast<RNG&&>(generator)), size_(size_value)
    {}

    CANN_ASC_STL_API constexpr Index operator()(Index index) const noexcept
    {
        do {
            index = static_cast<Index>(bijection_(index));
        } while (index >= size_);
        return index;
    }

    CANN_ASC_STL_API constexpr Index size() const noexcept
    {
        return size_;
    }

private:
    Bijection bijection_;
    Index size_;
};

}  // namespace asc

#endif  // CANN_ASC_STL_ASC_RANDOM
