#include <asc/algorithm>
#include "parallel_example.h"

namespace parallel_case_inclusive_scan {
struct binary_operation {
    __aicore__ int operator()(int left, int right) const
    {
        return left + right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status = asc::parallel::inclusive_scan(policy, input, input + 4, output, 0, binary_operation{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {1, 3, 6, 10};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_inclusive_scan

bool run_parallel_inclusive_scan(parallel_example_context& context)
{
    return parallel_case_inclusive_scan::example(context);
}

namespace parallel_case_is_heap {
struct compare {
    __aicore__ bool operator()(int left, int right) const
    {
        return left < right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* flag_sink = context.flag_sink;
    const auto status = asc::parallel::is_heap(policy, input, input + 4, flag_sink, compare{});
    if (!context.complete(status))
        return false;
    asc::std::uint32_t observed[1]{};
    if (!context.read(context.flag_sink, observed))
        return false;
    if (observed[0] != 0u)
        return false;
    return true;
}
}  // namespace parallel_case_is_heap

bool run_parallel_is_heap(parallel_example_context& context)
{
    return parallel_case_is_heap::example(context);
}

