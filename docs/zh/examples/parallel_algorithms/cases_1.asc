{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    const auto status = asc::parallel::for_each(policy, input, input + 4, action{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {2, 3, 4, 5};
    if (!context.read(context.input, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_for_each

bool run_parallel_for_each(parallel_example_context& context)
{
    return parallel_case_for_each::example(context);
}

