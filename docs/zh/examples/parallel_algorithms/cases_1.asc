namespace parallel_case_find {

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::find(policy, input, input + 4, 3, size_sink);
    if (!context.complete(status))
        return false;
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 2u)
        return false;
    return true;
}
}  // namespace parallel_case_find

bool run_parallel_find(parallel_example_context& context)
{
    return parallel_case_find::example(context);
}

namespace parallel_case_find_if {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::find_if(policy, input, input + 4, size_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 1u)
        return false;
    return true;
}
}  // namespace parallel_case_find_if

bool run_parallel_find_if(parallel_example_context& context)
{
    return parallel_case_find_if::example(context);
