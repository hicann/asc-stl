namespace parallel_case_equal {
struct binary_predicate {
    __aicore__ bool operator()(int left, int right) const
    {
        return left == right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* other = context.other;
    auto* flag_sink = context.flag_sink;
    const auto status = asc::parallel::equal(policy, input, input + 4, other, other + 4, flag_sink, binary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::uint32_t observed[1]{};
    if (!context.read(context.flag_sink, observed))
        return false;
    if (observed[0] != 1u)
        return false;
    return true;
}
}  // namespace parallel_case_equal

bool run_parallel_equal(parallel_example_context& context)
{
    return parallel_case_equal::example(context);
}
