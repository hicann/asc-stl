#include <asc/algorithm>
#include "parallel_example.h"

namespace parallel_case_adjacent_difference {
struct binary_operation {
    __aicore__ int operator()(int left, int right) const
    {
        return left - right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* output = context.output;
    const auto status = asc::parallel::adjacent_difference(policy, input, input + 4, output, binary_operation{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {1, 1, 1, 1};
    if (!context.read(context.output, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_adjacent_difference

bool run_parallel_adjacent_difference(parallel_example_context& context)
{
    return parallel_case_adjacent_difference::example(context);
}

namespace parallel_case_adjacent_find {
struct binary_predicate {
    __aicore__ bool operator()(int left, int right) const
    {
        return left == right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 2, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::adjacent_find(policy, input, input + 4, size_sink, binary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 1u)
        return false;
    return true;
}
}  // namespace parallel_case_adjacent_find

bool run_parallel_adjacent_find(parallel_example_context& context)
{
    return parallel_case_adjacent_find::example(context);
}

namespace parallel_case_all_of {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* flag_sink = context.flag_sink;
    const auto status = asc::parallel::all_of(policy, input, input + 4, flag_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    asc::std::uint32_t observed[1]{};
    if (!context.read(context.flag_sink, observed))
        return false;
    if (observed[0] != 0u)
        return false;
    return true;
}
}  // namespace parallel_case_all_of

bool run_parallel_all_of(parallel_example_context& context)
{
    return parallel_case_all_of::example(context);
}

