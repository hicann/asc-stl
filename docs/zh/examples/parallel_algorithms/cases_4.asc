namespace parallel_case_shift_left {

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    const auto status = asc::parallel::shift_left(policy, input, input + 4, 2);
    if (!context.complete(status))
        return false;
    int actual[4]{};
    if (!context.read(context.input, actual))
        return false;
    if (actual[0] != 3 || actual[1] != 4)
        return false;
    return true;
}
}  // namespace parallel_case_shift_left

bool run_parallel_shift_left(parallel_example_context& context)
{
    return parallel_case_shift_left::example(context);
}

