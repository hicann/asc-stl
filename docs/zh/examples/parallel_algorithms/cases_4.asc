namespace parallel_case_sort {
struct compare {
    __aicore__ bool operator()(int left, int right) const
    {
        return left < right;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {4, 1, 3, 2};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    const auto status = asc::parallel::sort(policy, input, input + 4, compare{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {1, 2, 3, 4};
    if (!context.read(context.input, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    return true;
}
}  // namespace parallel_case_sort

bool run_parallel_sort(parallel_example_context& context)
{
    return parallel_case_sort::example(context);
}

namespace parallel_case_stable_partition {
struct unary_predicate {
    __aicore__ bool operator()(int value) const
    {
        return value % 2 == 0;
    }
};

bool example(parallel_example_context& context)
{
    const int initial[] = {1, 2, 3, 4};
    const int second[] = {1, 2, 3, 4};
    if (!context.prepare(initial, second))
        return false;
    auto policy = context.policy();
    auto* input = context.input;
    auto* size_sink = context.size_sink;
    const auto status = asc::parallel::stable_partition(policy, input, input + 4, size_sink, unary_predicate{});
    if (!context.complete(status))
        return false;
    int actual[4]{};
    const int expected[] = {2, 4, 1, 3};
    if (!context.read(context.input, actual))
        return false;
    for (unsigned index = 0; index < 4; ++index) {
        if (actual[index] != expected[index])
            return false;
    }
    asc::std::size_t observed[1]{};
    if (!context.read(context.size_sink, observed))
        return false;
    if (observed[0] != 2u)
        return false;
    return true;
}
}  // namespace parallel_case_stable_partition

bool run_parallel_stable_partition(parallel_example_context& context)
{
    return parallel_case_stable_partition::example(context);
}
