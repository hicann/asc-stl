#include <asc/warp>

#include "warp_example.h"

__global__ void warp_example_kernel(unsigned int* output)
{
    const unsigned int lane = asc::lane_id();
    const asc::lane_mask none = asc::lane_mask::none();
    const asc::lane_mask all = asc::lane_mask::all();
    const asc::lane_mask active = asc::lane_mask::all_active();
    const asc::lane_mask self = asc::lane_mask::this_lane();
    const asc::lane_mask less = asc::lane_mask::all_less();
    const asc::lane_mask less_equal = asc::lane_mask::all_less_equal();
    const asc::lane_mask greater = asc::lane_mask::all_greater();
    const asc::lane_mask greater_equal = asc::lane_mask::all_greater_equal();
    const asc::lane_mask not_equal = asc::lane_mask::all_not_equal();

    unsigned int failures = 0;
    failures += none.value() != 0U || static_cast<unsigned int>(all) != 0xffffffffU;
    failures += active != asc::active_mask() || active != all;
    failures += self.value() != (1U << lane);
    failures += (less | self) != less_equal || (greater | self) != greater_equal;
    failures += (less | greater) != not_equal || (less & greater) != none;
    failures += (less ^ greater) != not_equal || (~self & active) != not_equal;

    asc::lane_mask changed(1U);
    changed &= all;
    changed |= asc::lane_mask(2U);
    changed ^= asc::lane_mask(1U);
    changed <<= 1;
    changed >>= 1;
    failures += changed != asc::lane_mask(2U);
    failures += (asc::lane_mask(1U) << 1).value() != 2U;
    failures += (asc::lane_mask(2U) >> 1).value() != 1U;

    failures += !asc::warp_all(lane < 32U) || !asc::warp_any(lane == 0U);
    failures += asc::warp_ballot(lane < 16U) != asc::lane_mask(0xffffU);
    failures += !asc::warp_match_all(7U, active);
    failures += asc::warp_match_any(lane & 3U, active) != asc::lane_mask(0x11111111U << (lane & 3U));

    asc::warp_shuffle_result<unsigned int> indexed = asc::warp_shuffle_idx<32>(lane, 0, active);
    const auto up = asc::warp_shuffle_up<32>(lane, 1, active);
    const auto down = asc::warp_shuffle_down<32>(lane, 1, active);
    const auto xored = asc::warp_shuffle_xor<32>(lane, 1, active);
    failures += !indexed.valid || indexed.data != 0U;
    failures += up.valid != (lane != 0U) || (up.valid && up.data != lane - 1U);
    failures += down.valid != (lane != 31U) || (down.valid && down.data != lane + 1U);
    failures += !xored.valid || xored.data != (lane ^ 1U);
    failures += asc::warp_reduce_add(lane) != 496U;
    failures += asc::warp_reduce_min(lane) != 0U;
    failures += asc::warp_reduce_max(lane) != 31U;
    output[lane] = failures;
}

void launch_warp_example(unsigned int* output, aclrtStream stream)
{
    warp_example_kernel<<<1, 32, 0, stream>>>(output);
}
